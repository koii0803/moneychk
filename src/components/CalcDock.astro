---
// 오른쪽에 따라다니는 머니첵 계산기 (PC만, 모바일엔 안 뜸).
// eitc.html(public/tools/eitc.html)에 있던 것과 같은 동작을 계산기 페이지 전부에서 쓰려고 뺐다.
// 본문은 항상 가운데. 계산기가 본문과 겹치는 폭(1680px 미만)이면 처음엔 접혀 있고, 편 기록은 localStorage에 남는다.
---

<aside class="calcdock" data-calcdock aria-label="계산기">
  <div class="bar">
    <span class="dot"></span>
    <span>계산기</span>
    <button type="button" data-calcmin aria-label="계산기 접기">−</button>
  </div>
  <iframe src="/calc?embed=1" title="머니첵 계산기" loading="lazy"></iframe>
</aside>

<script is:inline>
  (function () {
    function init() {
      var cd = document.querySelector('[data-calcdock]');
      if (!cd || cd.dataset.ready) return;
      cd.dataset.ready = '1';
      var cm = cd.querySelector('[data-calcmin]');
      try {
        var pref = localStorage.getItem('calcdock');
        if (pref === 'min' || (pref !== 'open' && innerWidth < 1680)) cd.classList.add('min');
      } catch (e) {}
      cm.textContent = cd.classList.contains('min') ? '+' : '−';
      cm.addEventListener('click', function () {
        var min = cd.classList.toggle('min');
        cm.textContent = min ? '+' : '−';
        cm.setAttribute('aria-label', min ? '계산기 펼치기' : '계산기 접기');
        try { localStorage.setItem('calcdock', min ? 'min' : 'open'); } catch (e) {}
      });
    }
    document.addEventListener('astro:page-load', init);
    if (document.readyState !== 'loading') init(); else document.addEventListener('DOMContentLoaded', init);
  })();
</script>

<style>
  /* 계산기 페이지 안에서만 쓰는 토큰 — 전역에 --hair-2·--glass가 없어서 여기서 만든다 */
  .calcdock {
    --cd-hair: color-mix(in srgb, var(--ink) 16%, transparent);
    --cd-glass: color-mix(in srgb, var(--surface) 88%, transparent);
    display: none;
  }
  @media (min-width: 1380px) {
    .calcdock {
      display: flex; flex-direction: column;
      position: fixed; top: 74px; right: 20px; width: 340px;
      max-height: calc(100vh - 90px); z-index: 25;
      border-radius: 22px; border: 1px solid var(--cd-hair);
      background: var(--cd-glass);
      backdrop-filter: blur(22px) saturate(170%); -webkit-backdrop-filter: blur(22px) saturate(170%);
      box-shadow: var(--shadow); overflow: hidden;
      transition: width .25s, max-height .25s;
    }
    .calcdock .bar {
      display: flex; align-items: center; gap: 8px;
      padding: 10px 12px 10px 16px; border-bottom: 1px solid var(--hair);
      font-size: 13px; font-weight: 700; color: var(--ink-2); flex: none;
    }
    .calcdock .bar .dot { width: 8px; height: 8px; border-radius: 99px; background: var(--mint); box-shadow: 0 0 10px var(--mint); }
    .calcdock .bar button {
      margin-left: auto; width: 30px; height: 30px; border-radius: 99px;
      border: 1px solid var(--cd-hair); background: transparent; color: var(--ink-2);
      cursor: pointer; font-size: 14px; line-height: 1;
    }
    .calcdock .bar button:hover { background: var(--surface); color: var(--ink); }
    .calcdock iframe { display: block; width: 100%; height: 760px; max-height: calc(100vh - 140px); border: 0; background: transparent; }
    .calcdock.min { width: auto; max-height: none; border-radius: 99px; }
    .calcdock.min .bar { border-bottom: 0; }
    .calcdock.min iframe { display: none; }
  }
</style>
