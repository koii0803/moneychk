---
import { ClientRouter } from 'astro:transitions';
import { SITE, CATEGORIES } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string | null;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
}

const {
  title,
  description = SITE.description,
  ogImage,
  article = false,
  pubDate,
  updatedDate,
} = Astro.props;
const ogImg = ogImage || SITE.ogImage;

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, ''), SITE.url).href;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <meta name="theme-color" content="#17171c" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImg, SITE.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    {article && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {article && updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/sun-typeface/suit@2/fonts/variable/woff2/SUIT-Variable.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" crossorigin="anonymous" />
    <!-- Google AdSense 사이트 연결 코드 (밥체크와 같은 계정 pub-9894057521045935) -->
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9894057521045935" crossorigin="anonymous"></script>
    <!-- GA4: 머니첵 속성 만들면 측정 ID 넣어 밥체크 Base.astro와 같은 블록 추가 -->
    <!-- 테마: 저장값 → 없으면 어두운 화면. 깜빡임 막으려고 head에서 먼저 -->
    <script is:inline>
      function applyTheme() {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      }
      applyTheme();
      // 페이지 이동(ClientRouter)하면 <html>이 새것으로 바뀌어 data-theme이 날아감 → 바뀐 직후 다시 적용
      document.addEventListener('astro:after-swap', applyTheme);
      // 모바일 메뉴: 햄버거로 열고 닫기, 링크 누르거나 페이지 바뀌면 닫힘
      document.addEventListener('click', function (e) {
        var m = document.querySelector('[data-menu]'); if (!m) return;
        var b = e.target.closest && e.target.closest('[data-menu-toggle]');
        if (b) { var open = m.hidden; m.hidden = !open; b.setAttribute('aria-expanded', open ? 'true' : 'false'); return; }
        if (!e.target.closest('[data-menu]')) { m.hidden = true; var t = document.querySelector('[data-menu-toggle]'); if (t) t.setAttribute('aria-expanded', 'false'); }
      });
      document.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('[data-theme-toggle]');
        if (!b) return;
        var cur = document.documentElement.dataset.theme || 'dark';
        var next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <div class="ambient" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <header class="top" id="top">
      <div class="wrap top-in">
        <a class="wordmark" href="/" aria-label="머니첵 홈">
          <span class="wordmark-mark" aria-hidden="true"><i class="glow"></i><img src="/img/icons/logo.webp" alt="" width="34" height="34" /></span>
          <span class="wordmark-type">
            <span class="wordmark-text">Moneycheck</span>
            <span class="wordmark-sub">POLICY DATA LAB</span>
          </span>
        </a>
        <a class="top-pipe" href="/pipeline">홈페이지 구성</a>
        <nav class="top-nav" aria-label="사이트">
          <a href="/">정책 피드</a>
          <a href="/#featured">추천 리포트</a>
          <a href="/tools" target="_blank" rel="noopener">모의계산기</a>
          <a href="/about">분석 원칙</a>
          <button type="button" class="theme-btn" data-theme-toggle aria-label="밝기 바꾸기">
            <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
          <button type="button" class="menu-btn" data-menu-toggle aria-label="메뉴" aria-expanded="false">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </nav>
      </div>
      <!-- 모바일 펼침 메뉴: 햄버거 누르면 헤더 아래로 -->
      <nav class="menu" data-menu aria-label="모바일 메뉴" hidden>
        <div class="wrap">
          <a href="/">정책 피드</a>
          <a href="/#featured">추천 리포트</a>
          <a href="/tools" target="_blank" rel="noopener">모의계산기</a>
          <a href="/about">분석 원칙</a>
          <div class="menu-cats">
            {Object.entries(CATEGORIES).map(([key, c]) => <a href={`/${key}`}><i style={`background:${c.color}`}></i>{c.name}</a>)}
          </div>
        </div>
      </nav>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-in">
        <div class="foot-brand">
          <a class="wordmark foot-wm" href="/" aria-label="머니첵 홈">
            <span class="wordmark-mark" aria-hidden="true"><i class="glow"></i><img src="/img/icons/logo.webp" alt="" width="34" height="34" /></span>
            <span class="wordmark-type">
              <span class="wordmark-text">Moneycheck</span>
              <span class="wordmark-sub">POLICY DATA LAB</span>
            </span>
          </a>
          <p class="foot-tag">공공데이터 고시 기반 민생정책·금융 데이터랩</p>
          <p class="foot-note">
            정부·공공기관 공식 자료의 숫자만 근거로 씁니다. 제도 내용은 발행일 기준이며,
            개별 사안의 최종 확인은 해당 기관 공고를 따릅니다.
          </p>
        </div>
        <ul class="foot-cats" aria-label="분류">
          {Object.entries(CATEGORIES).map(([key, c]) => (
            <li><a href={`/${key}`}><i style={`background:${c.color}`}></i>{c.name}</a></li>
          ))}
        </ul>
        <ul class="foot-links">
          <li><a href="/about">소개</a></li>
          <li><a href="/privacy">개인정보처리방침</a></li>
          <li><a href="/disclaimer">책임의 한계와 법적 고지</a></li>
          <li><a href="/contact">문의</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
        <p class="foot-copy">© {new Date().getFullYear()} {SITE.latin}</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root, :root[data-theme='dark'] {
    --bg: #0b0f19; /* 계산기(LUMINA) 배경과 동일 계열 */
    --surface: #161b2c;
    --surface-2: #12172a;
    --ink: #e5e8eb;
    --ink-2: #9ca3af;
    --ink-3: #8b95a1;
    --hair: rgba(255, 255, 255, 0.07);
    --money: #3182f6;
    --money-ink: #ffffff;
    --money-soft: rgba(49, 130, 246, 0.14);
    --mint: #00d287;
    --shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    color-scheme: dark;
  }
  :root[data-theme='light'] {
    --bg: #ffffff;
    --surface: #f4f5f7;
    --surface-2: #e9ebef;
    --ink: #191f28;
    --ink-2: #4e5968;
    --ink-3: #8b95a1;
    --hair: #e5e8eb;
    --money: #1b64da;
    --money-ink: #ffffff;
    --money-soft: rgba(27, 100, 218, 0.1);
    --mint: #00b374;
    --shadow: 0 10px 30px rgba(25, 31, 40, 0.08);
    color-scheme: light;
  }
  :root {
    --sans: 'SUIT Variable', 'Pretendard Variable', Pretendard, -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
    --serif: var(--sans);
    --paper: var(--bg);
    --paper-2: var(--surface);
    --hair-dark: var(--ink);
    --r: 16px;
  }
  * { box-sizing: border-box; }
  ::selection { background: var(--money); color: #fff; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0; min-height: 100vh; display: flex; flex-direction: column; /* 글 없는 분류처럼 내용이 짧아도 푸터는 화면 바닥 */
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.7;
    word-break: keep-all;
    font-feature-settings: 'tnum';
  }
  /* 배경: 계산기 페이지(LUMINA)와 같은 성운 그라데이션 + 떠다니는 빛 4개. 어두운 화면만 */
  :root:not([data-theme='light']) body { background: radial-gradient(circle at 15% 20%, #1e1b4b 0%, #0b0f19 45%, #030712 100%) fixed; }
  .ambient { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  :root[data-theme='light'] .ambient { display: none; }
  .ambient i { position: absolute; border-radius: 9999px; filter: blur(80px); opacity: .65; animation: floatOrb 12s ease-in-out infinite alternate; }
  .ambient i:nth-child(1) { width: 24rem; height: 24rem; top: -4rem; left: -4rem; background: rgba(219, 39, 119, .30); }
  .ambient i:nth-child(2) { width: 28rem; height: 28rem; top: 33%; right: -6rem; background: rgba(20, 184, 166, .25); animation-delay: -3s; }
  .ambient i:nth-child(3) { width: 20rem; height: 20rem; bottom: 2.5rem; left: 25%; background: rgba(124, 58, 237, .25); animation-delay: -6s; }
  .ambient i:nth-child(4) { width: 18rem; height: 18rem; top: 66%; right: 33%; background: rgba(245, 158, 11, .20); animation-delay: -9s; }
  @keyframes floatOrb { 0% { transform: translate(0, 0) scale(1); } 50% { transform: translate(30px, -25px) scale(1.08); } 100% { transform: translate(-25px, 35px) scale(.95); } }
  @media (prefers-reduced-motion: reduce) { .ambient i { animation: none; } }
  main.wrap, footer.foot { position: relative; z-index: 1; } /* 헤더는 sticky라 건드리지 않음(z-index 자체로 위) */
  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; height: auto; display: block; }
  button { font: inherit; color: inherit; }
  :focus-visible { outline: 2px solid var(--money); outline-offset: 2px; border-radius: 6px; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
  main.wrap { flex: 1; width: 100%; }
  .ad-slot:empty { display: none; }
  .ad-slot { margin: 32px 0; }

  /* 머리 */
  .top {
    position: sticky; top: 0; z-index: 40;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hair);
  }
  .top-in { display: flex; align-items: center; justify-content: space-between; height: 60px; }
  .top-pipe { margin-left: 16px; margin-right: auto; padding: 5px 10px; border-radius: 6px; font-size: 12px; font-weight: 700; color: var(--ink-3); border: 1px dashed var(--hair); }
  .top-pipe:hover { color: var(--money); border-color: var(--money); }
  .wordmark { display: flex; align-items: center; gap: 8px; }
  /* 프리미엄 뉴스룸 제호: 슬레이트 팟 + 숨쉬는 초록 불 / 베이스라인 정렬 / 1px 세로 디바이더 / 명도 계층 */
  .wordmark { gap: 12px; }
  .wordmark-mark { position: relative; width: 36px; height: 36px; display: grid; place-items: center; }
  .wordmark-mark img { position: relative; width: 34px; height: 34px; object-fit: contain; }
  /* 로고 뒤에서 초록 빛이 숨쉬듯 흐려졌다 진해진다 */
  .glow { position: absolute; inset: -6px; border-radius: 999px; background: radial-gradient(circle, color-mix(in srgb, var(--mint) 55%, transparent) 0%, transparent 70%); filter: blur(4px); animation: breathe 2.4s ease-in-out infinite; }
  @keyframes breathe { 0%, 100% { opacity: .25; transform: scale(.9); } 50% { opacity: 1; transform: scale(1.15); } }
  @media (prefers-reduced-motion: reduce) { .glow { animation: none; opacity: .6; } }
  /* 2단 제호: 이름 위, 작은 영문 태그 아래(가운데). 평소엔 연녹색 빛이 글자를 훑고 지나가고, 올리면 연녹색으로 */
  .wordmark-type { display: flex; flex-direction: column; align-items: center; gap: 4px; line-height: 1; }
  .wordmark-text {
    font-weight: 800; font-size: 19px; letter-spacing: -0.025em;
    color: transparent; -webkit-text-fill-color: transparent;
    background: linear-gradient(100deg, var(--ink) 0%, var(--ink) 30%, #7fe8b8 45%, #c8fbe4 50%, #7fe8b8 55%, var(--ink) 70%, var(--ink) 100%);
    background-size: 250% 100%; background-position: 100% 0;
    -webkit-background-clip: text; background-clip: text;
    animation: sheen 2.5s ease-in-out infinite;
  }
  @keyframes sheen { 0%, 45% { background-position: 100% 0; } 80%, 100% { background-position: 0% 0; } }
  .wordmark:hover .wordmark-text { animation: none; background: none; color: #a8efd0; -webkit-text-fill-color: #a8efd0; }
  .wordmark-sub { font-size: 8.5px; font-weight: 700; letter-spacing: 0.18em; color: var(--mint); }
  @media (prefers-reduced-motion: reduce) { .wordmark-text { animation: none; background: none; color: var(--ink); -webkit-text-fill-color: var(--ink); } }
  @media (max-width: 480px) { .wordmark-sub { display: none; } }
  .top-nav { display: flex; align-items: center; gap: 2px; }
  .top-nav a {
    padding: 7px 11px; border-radius: 999px; font-size: 14.5px; font-weight: 600; color: var(--ink-2);
  }
  .top-nav a:hover { background: var(--surface); color: var(--money); }
  .theme-btn {
    margin-left: 6px; width: 36px; height: 36px; border-radius: 999px; border: 0;
    background: transparent; color: var(--ink-2); display: grid; place-items: center; cursor: pointer;
  }
  .theme-btn:hover { background: var(--surface); color: var(--ink); }
  .theme-btn .i-sun { display: none; }
  :root[data-theme='light'] .theme-btn .i-sun { display: block; }
  :root[data-theme='light'] .theme-btn .i-moon { display: none; }
  .menu-btn { display: none; }
  @media (max-width: 720px) {
    .top-pipe, .top-nav > a { display: none; } /* 내부용 배지·GNB 4개는 메뉴 안으로 */
    .menu-btn { display: grid; place-items: center; width: 40px; height: 40px; margin-left: 2px; border: 0; border-radius: 999px; background: transparent; color: var(--ink); cursor: pointer; }
    .menu-btn[aria-expanded='true'] { background: var(--surface); }
    .menu { position: absolute; left: 0; right: 0; top: 60px; background: color-mix(in srgb, var(--bg) 96%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--hair); box-shadow: var(--shadow); }
    .menu .wrap { display: grid; gap: 4px; padding: 12px 20px 16px; }
    .menu > .wrap > a { padding: 12px 8px; border-radius: 10px; font-size: 16px; font-weight: 700; }
    .menu > .wrap > a:active { background: var(--surface); }
    .menu-cats { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 12px; margin-top: 8px; padding-top: 12px; border-top: 1px solid var(--hair); }
    .menu-cats a { display: flex; align-items: center; gap: 8px; padding: 9px 8px; border-radius: 8px; font-size: 14px; font-weight: 600; color: var(--ink-2); }
    .menu-cats i { width: 8px; height: 8px; border-radius: 2px; }
  }

  /* 발 */
  .foot { margin-top: 110px; border-top: 1px solid var(--hair); background: color-mix(in srgb, var(--bg) 92%, #000); padding: 44px 0 48px; font-size: 13.5px; color: var(--ink-2); }
  .foot-in { display: grid; grid-template-columns: 1.4fr 1fr; gap: 20px 48px; }
  .foot-wm { display: inline-flex; margin: 0 0 10px; }
  .foot-tag { margin: 0 0 10px; font-size: 13px; color: var(--ink-3); }
  .foot-note { margin: 0; max-width: 460px; line-height: 1.7; }
  .foot-cats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: auto auto; gap: 6px 48px; justify-self: end; } /* 오른쪽 끝단(wrap)에 붙임 */
  .foot-cats a { display: flex; align-items: center; gap: 8px; }
  .foot-cats i { width: 8px; height: 8px; border-radius: 2px; }
  .foot-cats a:hover { color: var(--ink); }
  .foot-links { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 16px; }
  .foot-links a:hover { color: var(--money); }
  .foot-copy { margin: 8px 0 0; color: var(--ink-3); font-size: 12.5px; justify-self: end; } /* 분류 목록과 같은 오른쪽 끝단 */

  /* 공용 */
  .kicker { margin: 0 0 4px; font-size: 14px; font-weight: 600; color: var(--ink-3); }
  .section-h { font-weight: 800; font-size: 26px; letter-spacing: -0.02em; margin: 0 0 6px; }
  .section-sub { margin: 0 0 22px; color: var(--ink-2); font-size: 15px; }
  .chip { display: inline-block; padding: 3px 9px; border-radius: 6px; font-size: 12px; font-weight: 700; background: var(--surface-2); color: var(--ink-2); }

  /* 대표이미지 없을 때: 분류색 그라데이션 판 */
  .thumb { position: relative; aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; background: var(--surface-2); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb-fallback {
    width: 100%; height: 100%; display: grid; place-items: center;
    background: radial-gradient(120% 90% at 20% 10%, color-mix(in srgb, var(--c) 65%, #fff) 0%, var(--c) 55%, color-mix(in srgb, var(--c) 60%, #000) 100%);
    color: rgba(255,255,255,.92); font-weight: 800; font-size: 44px;
  }
  .thumb-fallback img { width: 46%; height: auto; filter: drop-shadow(0 10px 20px rgba(0,0,0,.4)); }
  /* 안내 페이지 공용 */
  .page { max-width: 720px; margin: 0 auto; padding-top: 52px; }
  .page h1 { font-weight: 800; font-size: 34px; letter-spacing: -0.02em; margin: 0 0 24px; padding-bottom: 18px; border-bottom: 1px solid var(--hair); }
  .page h2 { font-weight: 700; font-size: 21px; margin: 36px 0 12px; }
  .page p, .page li { color: var(--ink-2); }
  .page strong { color: var(--ink); }
  .page a { color: var(--money); }

  @media (max-width: 720px) {
    .foot { margin-top: 64px; padding: 36px 0 40px; }
    .foot-in { grid-template-columns: 1fr; gap: 24px; }
    .foot-cats, .foot-copy { justify-self: start; } /* 모바일은 왼쪽 정렬 */
    .foot-cats { gap: 6px 28px; }
  }
</style>
