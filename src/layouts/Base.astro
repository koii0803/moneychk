---
import { ClientRouter } from 'astro:transitions';
import { SITE, CATEGORIES } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string | null;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
}

const {
  title,
  description = SITE.description,
  ogImage,
  article = false,
  pubDate,
  updatedDate,
} = Astro.props;
const ogImg = ogImage || SITE.ogImage;

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, ''), SITE.url).href;
const today = new Date().toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  weekday: 'long',
});
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <meta name="theme-color" content="#faf9f4" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImg, SITE.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    {article && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {article && updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@600;700;900&family=Noto+Sans+KR:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <!-- Google AdSense 사이트 연결 코드 (밥체크와 같은 계정 pub-9894057521045935) -->
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9894057521045935" crossorigin="anonymous"></script>
    <!-- GA4: 머니첵 속성 만들면 측정 ID 넣어 밥체크 Base.astro와 같은 블록 추가 -->
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <header class="masthead">
      <div class="wrap">
        <p class="dateline">
          <span>{today}</span>
          <span class="dateline-right">공식 자료 기준 생활경제 팩트체크</span>
        </p>
        <a class="wordmark" href="/">
          <span class="wordmark-mark">₩</span>
          <span class="wordmark-text">머니첵<em>moneychk</em></span>
        </a>
      </div>
      <nav class="catbar" aria-label="카테고리">
        <div class="wrap catbar-in">
          {
            Object.entries(CATEGORIES).map(([key, c]) => (
              <a href={`/${key}`} style={`--c:${c.color}`}>
                <b>{c.no}</b>
                {c.name}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <p class="foot-brand">₩ {SITE.name} · {SITE.latin}</p>
        <p class="foot-note">
          모든 글은 정부·공공기관 공식 자료를 근거로 작성하며, 제도 내용은 발행일 기준입니다.
          개별 사안의 최종 확인은 해당 기관 공고를 따르세요.
        </p>
        <p class="foot-links">
          <a href="/about">소개</a>
          <a href="/privacy">개인정보처리방침</a>
          <a href="/disclaimer">면책 조항</a>
          <a href="/contact">문의</a>
          <a href="/rss.xml">RSS</a>
        </p>
        <p class="foot-copy">© {new Date().getFullYear()} {SITE.latin}</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #faf9f4;
    --paper-2: #f3f1e9;
    --ink: #171a1f;
    --ink-2: #4c5158;
    --ink-3: #8a8f96;
    --hair: #e3dfd3;
    --hair-dark: #171a1f;
    --money: #177a53;
    --money-soft: #e4f0ea;
    --serif: 'Noto Serif KR', 'Nanum Myeongjo', serif;
    --sans: 'Noto Sans KR', 'Pretendard', -apple-system, sans-serif;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.75;
    word-break: keep-all;
  }
  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; height: auto; display: block; }
  .wrap { max-width: 1024px; margin: 0 auto; padding: 0 20px; }
  /* gpub가 본문에 넣는 광고 자리. 비어 있으면 안 보인다 */
  .ad-slot:empty { display: none; }
  .ad-slot { margin: 32px 0; }

  /* ── 머리(마스트헤드) ───────────────────── */
  .masthead { border-top: 4px solid var(--hair-dark); }
  .dateline {
    display: flex; justify-content: space-between; gap: 12px;
    margin: 0; padding: 10px 0;
    border-bottom: 1px solid var(--hair);
    font-size: 12.5px; color: var(--ink-2); letter-spacing: 0.02em;
  }
  .dateline-right { color: var(--money); font-weight: 500; }
  .wordmark {
    display: flex; align-items: center; gap: 14px;
    padding: 26px 0 22px;
  }
  .wordmark-mark {
    display: grid; place-items: center;
    width: 52px; height: 52px;
    background: var(--money); color: #fff;
    font-family: var(--serif); font-size: 30px; font-weight: 900;
    border-radius: 4px;
  }
  .wordmark-text {
    font-family: var(--serif); font-size: 34px; font-weight: 900; line-height: 1;
    letter-spacing: -0.01em;
  }
  .wordmark-text em {
    display: block; font-family: var(--sans); font-style: normal;
    font-size: 11.5px; font-weight: 500; letter-spacing: 0.34em;
    color: var(--ink-3); text-transform: uppercase; margin-top: 7px;
  }
  .catbar {
    border-top: 1px solid var(--hair-dark);
    border-bottom: 1px solid var(--hair);
    background: var(--paper);
  }
  .catbar-in {
    display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none;
  }
  .catbar-in::-webkit-scrollbar { display: none; }
  .catbar a {
    flex: 0 0 auto;
    padding: 11px 13px;
    font-size: 13.5px; font-weight: 500; color: var(--ink-2);
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .catbar a b {
    font-family: var(--serif); font-weight: 700; font-size: 11px;
    color: var(--c); margin-right: 6px;
  }
  .catbar a:hover { color: var(--ink); border-bottom-color: var(--c); }

  /* ── 발(푸터) ───────────────────── */
  .foot {
    margin-top: 96px;
    border-top: 3px solid var(--hair-dark);
    background: var(--paper-2);
    padding: 34px 0 44px;
    font-size: 13.5px; color: var(--ink-2);
  }
  .foot-brand { font-family: var(--serif); font-weight: 700; color: var(--ink); margin: 0 0 10px; }
  .foot-note { max-width: 560px; margin: 0 0 18px; line-height: 1.7; }
  .foot-links { display: flex; gap: 18px; margin: 0 0 6px; }
  .foot-links a { border-bottom: 1px solid var(--hair); padding-bottom: 1px; }
  .foot-links a:hover { color: var(--money); border-bottom-color: var(--money); }
  .foot-copy { margin: 0; color: var(--ink-3); font-size: 12.5px; }

  /* ── 공용 섹션 제목 ───────────────────── */
  .kicker {
    display: flex; align-items: baseline; gap: 10px;
    margin: 0 0 4px;
    font-size: 12.5px; font-weight: 700; letter-spacing: 0.16em;
    color: var(--money); text-transform: uppercase;
  }
  .kicker::after { content: ''; flex: 1; border-top: 1px solid var(--hair); }
  .section-h {
    font-family: var(--serif); font-weight: 900; font-size: 24px;
    margin: 0 0 20px; letter-spacing: -0.01em;
  }

  @media (max-width: 640px) {
    .wordmark-text { font-size: 27px; }
    .wordmark-mark { width: 44px; height: 44px; font-size: 25px; }
  }
</style>
