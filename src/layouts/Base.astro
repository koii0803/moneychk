---
import { ClientRouter } from 'astro:transitions';
import { SITE, CATEGORIES } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string | null;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
}

const {
  title,
  description = SITE.description,
  ogImage,
  article = false,
  pubDate,
  updatedDate,
} = Astro.props;
const ogImg = ogImage || SITE.ogImage;

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, ''), SITE.url).href;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <meta name="theme-color" content="#17171c" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImg, SITE.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    {article && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {article && updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" crossorigin="anonymous" />
    <!-- Google AdSense 사이트 연결 코드 (밥체크와 같은 계정 pub-9894057521045935) -->
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9894057521045935" crossorigin="anonymous"></script>
    <!-- GA4: 머니첵 속성 만들면 측정 ID 넣어 밥체크 Base.astro와 같은 블록 추가 -->
    <!-- 테마: 저장값 → 없으면 어두운 화면. 깜빡임 막으려고 head에서 먼저 -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
      document.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('[data-theme-toggle]');
        if (!b) return;
        var cur = document.documentElement.dataset.theme || 'dark';
        var next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <header class="top" id="top">
      <div class="wrap top-in">
        <a class="wordmark" href="/" aria-label="머니첵 홈">
          <img class="wordmark-mark" src="/img/icons/logo.webp" alt="" width="30" height="30" />
          <span class="wordmark-text">머니첵</span>
          <span class="wordmark-sub">데이터랩</span>
        </a>
        <nav class="top-nav" aria-label="사이트">
          <a href="/">정책 피드</a>
          <a href="/#featured">추천 리포트</a>
          <a href="/tools">모의계산기</a>
          <a href="/about">분석 원칙</a>
          <button type="button" class="theme-btn" data-theme-toggle aria-label="밝기 바꾸기">
            <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-in">
        <div class="foot-brand">
          <p class="foot-name">₩ {SITE.name}</p>
          <p class="foot-tag">공공데이터 고시 기반 민생정책·금융 데이터랩</p>
          <p class="foot-note">
            정부·공공기관 공식 자료의 숫자만 근거로 씁니다. 제도 내용은 발행일 기준이며,
            개별 사안의 최종 확인은 해당 기관 공고를 따릅니다.
          </p>
        </div>
        <ul class="foot-cats" aria-label="분류">
          {Object.entries(CATEGORIES).map(([key, c]) => (
            <li><a href={`/${key}`}><i style={`background:${c.color}`}></i>{c.name}</a></li>
          ))}
        </ul>
        <ul class="foot-links">
          <li><a href="/about">소개</a></li>
          <li><a href="/privacy">개인정보처리방침</a></li>
          <li><a href="/disclaimer">책임의 한계와 법적 고지</a></li>
          <li><a href="/contact">문의</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
        <p class="foot-copy">© {new Date().getFullYear()} {SITE.latin}</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root, :root[data-theme='dark'] {
    --bg: #101013;
    --surface: #1c1d23;
    --surface-2: #16171b;
    --ink: #e5e8eb;
    --ink-2: #9ca3af;
    --ink-3: #8b95a1;
    --hair: rgba(255, 255, 255, 0.07);
    --money: #3182f6;
    --money-ink: #ffffff;
    --money-soft: rgba(49, 130, 246, 0.14);
    --mint: #00d287;
    --shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    color-scheme: dark;
  }
  :root[data-theme='light'] {
    --bg: #ffffff;
    --surface: #f4f5f7;
    --surface-2: #e9ebef;
    --ink: #191f28;
    --ink-2: #4e5968;
    --ink-3: #8b95a1;
    --hair: #e5e8eb;
    --money: #1b64da;
    --money-ink: #ffffff;
    --money-soft: rgba(27, 100, 218, 0.1);
    --mint: #00b374;
    --shadow: 0 10px 30px rgba(25, 31, 40, 0.08);
    color-scheme: light;
  }
  :root {
    --sans: 'Pretendard Variable', Pretendard, -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
    --serif: var(--sans);
    --paper: var(--bg);
    --paper-2: var(--surface);
    --hair-dark: var(--ink);
    --r: 16px;
  }
  * { box-sizing: border-box; }
  ::selection { background: var(--money); color: #fff; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.7;
    word-break: keep-all;
    font-feature-settings: 'tnum';
  }
  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; height: auto; display: block; }
  button { font: inherit; color: inherit; }
  :focus-visible { outline: 2px solid var(--money); outline-offset: 2px; border-radius: 6px; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
  .ad-slot:empty { display: none; }
  .ad-slot { margin: 32px 0; }

  /* 머리 */
  .top {
    position: sticky; top: 0; z-index: 40;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hair);
  }
  .top-in { display: flex; align-items: center; justify-content: space-between; height: 60px; }
  .wordmark { display: flex; align-items: center; gap: 8px; }
  .wordmark-mark { width: 30px; height: 30px; object-fit: contain; }
  .wordmark-text { font-weight: 800; font-size: 20px; letter-spacing: -0.02em; }
  .wordmark-sub { font-size: 12px; font-weight: 600; color: var(--ink-3); padding-left: 2px; }
  @media (max-width: 480px) { .wordmark-sub { display: none; } }
  .top-nav { display: flex; align-items: center; gap: 2px; }
  .top-nav a {
    padding: 7px 11px; border-radius: 999px; font-size: 14.5px; font-weight: 600; color: var(--ink-2);
  }
  .top-nav a:hover { background: var(--surface); color: var(--ink); }
  .theme-btn {
    margin-left: 6px; width: 36px; height: 36px; border-radius: 999px; border: 0;
    background: transparent; color: var(--ink-2); display: grid; place-items: center; cursor: pointer;
  }
  .theme-btn:hover { background: var(--surface); color: var(--ink); }
  .theme-btn .i-sun { display: none; }
  :root[data-theme='light'] .theme-btn .i-sun { display: block; }
  :root[data-theme='light'] .theme-btn .i-moon { display: none; }
  @media (max-width: 720px) { .top-nav a:not(:last-of-type) { display: none; } }

  /* 발 */
  .foot { margin-top: 110px; border-top: 1px solid var(--hair); background: color-mix(in srgb, var(--bg) 92%, #000); padding: 44px 0 48px; font-size: 13.5px; color: var(--ink-2); }
  .foot-in { display: grid; grid-template-columns: 1.4fr 1fr; gap: 20px 48px; }
  .foot-name { margin: 0 0 2px; font-weight: 800; font-size: 16px; color: var(--ink); }
  .foot-tag { margin: 0 0 10px; font-size: 13px; color: var(--ink-3); }
  .foot-note { margin: 0; max-width: 460px; line-height: 1.7; }
  .foot-cats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 6px 16px; }
  .foot-cats a { display: flex; align-items: center; gap: 8px; }
  .foot-cats i { width: 8px; height: 8px; border-radius: 2px; }
  .foot-cats a:hover { color: var(--ink); }
  .foot-links { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 16px; }
  .foot-links a:hover { color: var(--money); }
  .foot-copy { margin: 8px 0 0; color: var(--ink-3); font-size: 12.5px; }

  /* 공용 */
  .kicker { margin: 0 0 4px; font-size: 14px; font-weight: 600; color: var(--ink-3); }
  .section-h { font-weight: 800; font-size: 26px; letter-spacing: -0.02em; margin: 0 0 6px; }
  .section-sub { margin: 0 0 22px; color: var(--ink-2); font-size: 15px; }
  .chip { display: inline-block; padding: 3px 9px; border-radius: 6px; font-size: 12px; font-weight: 700; background: var(--surface-2); color: var(--ink-2); }

  /* 대표이미지 없을 때: 분류색 그라데이션 판 */
  .thumb { position: relative; aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; background: var(--surface-2); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb-fallback {
    width: 100%; height: 100%; display: grid; place-items: center;
    background: radial-gradient(120% 90% at 20% 10%, color-mix(in srgb, var(--c) 65%, #fff) 0%, var(--c) 55%, color-mix(in srgb, var(--c) 60%, #000) 100%);
    color: rgba(255,255,255,.92); font-weight: 800; font-size: 44px;
  }
  .thumb-fallback img { width: 46%; height: auto; filter: drop-shadow(0 10px 20px rgba(0,0,0,.4)); }
  /* 안내 페이지 공용 */
  .page { max-width: 720px; margin: 0 auto; padding-top: 52px; }
  .page h1 { font-weight: 800; font-size: 34px; letter-spacing: -0.02em; margin: 0 0 24px; padding-bottom: 18px; border-bottom: 1px solid var(--hair); }
  .page h2 { font-weight: 700; font-size: 21px; margin: 36px 0 12px; }
  .page p, .page li { color: var(--ink-2); }
  .page strong { color: var(--ink); }
  .page a { color: var(--money); }

  @media (max-width: 720px) {
    .foot-in { grid-template-columns: 1fr; }
  }
</style>
