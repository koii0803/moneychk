---
import Base from '../../layouts/Base.astro';
import { getPublished } from '../../lib/posts';
import { catColor, fmtDate } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getPublished();
  const tags = new Set(posts.flatMap((p) => p.data.tags));
  return [...tags].map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}
const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Base title={`#${tag}`} description={`${tag} 관련 글 ${posts.length}편`}>
  <header class="cat-head">
    <p class="kicker">Tag</p>
    <h1>#{tag}</h1>
    <p class="cat-desc">{posts.length}편</p>
  </header>

  <ol class="catlist">
    {
      posts.map((p) => (
        <li style={`--c:${catColor(p.data.category)}`}>
          <a href={`/posts/${p.id}`}>
            <span class="date">{fmtDate(p.data.pubDate)}</span>
            <span class="t">{p.data.title}</span>
            <span class="s">{p.data.description}</span>
          </a>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .cat-head { padding: 44px 0 28px; border-bottom: 3px solid var(--ink); }
  .cat-head h1 {
    margin: 6px 0 8px;
    font-family: var(--serif); font-weight: 900; font-size: clamp(30px, 5vw, 44px);
    letter-spacing: -0.02em;
  }
  .cat-desc { margin: 0; color: var(--ink-2); }
  .catlist { list-style: none; margin: 0; padding: 0; }
  .catlist li { border-bottom: 1px solid var(--hair); }
  .catlist a { display: grid; grid-template-columns: 96px 1fr; gap: 4px 20px; padding: 22px 0; }
  .catlist .date { font-size: 12.5px; color: var(--ink-3); padding-top: 5px; grid-row: span 2; }
  .catlist .t { font-family: var(--serif); font-weight: 700; font-size: 19.5px; line-height: 1.45; }
  .catlist a:hover .t { color: var(--c); text-decoration: underline; text-underline-offset: 4px; }
  .catlist .s { grid-column: 2; font-size: 14px; color: var(--ink-2); }
  @media (max-width: 640px) {
    .catlist a { grid-template-columns: 1fr; }
    .catlist .date { grid-row: auto; order: 3; }
  }
</style>
