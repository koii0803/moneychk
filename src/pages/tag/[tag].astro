---
import Base from '../../layouts/Base.astro';
import { getPublished } from '../../lib/posts';
import { CATEGORIES, catColor, fmtDate } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getPublished();
  const tags = new Set(posts.flatMap((p) => p.data.tags));
  return [...tags].map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}
const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Base title={`#${tag}`} description={`${tag} 관련 글 ${posts.length}편`}>
  <header class="tag-head">
    <p class="kicker">태그</p>
    <h1>#{tag}</h1>
    <p class="tag-sub">{posts.length}편</p>
  </header>

  <ul class="card-grid">
    {posts.map((p) => (
      <li style={`--c:${catColor(p.data.category)}`}>
        <a class="card" href={`/posts/${p.id}`}>
          <div class="thumb">
            {p.data.thumbnail
              ? <img src={p.data.thumbnail} alt={p.data.title} width="640" height="360" loading="lazy" />
              : <div class="thumb-fallback">₩</div>}
          </div>
          <span class="card-cat">{CATEGORIES[p.data.category].name}</span>
          <span class="card-title">{p.data.title}</span>
          <span class="card-date">{fmtDate(p.data.pubDate)}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .tag-head { padding: 52px 0 28px; }
  .tag-head h1 { margin: 0; font-weight: 800; font-size: clamp(28px, 4vw, 38px); letter-spacing: -0.025em; }
  .tag-sub { margin: 4px 0 0; color: var(--ink-2); }
  .card-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px 20px; }
  .card { display: flex; flex-direction: column; gap: 6px; }
  .card .thumb { margin-bottom: 6px; }
  .card-cat { font-size: 12.5px; font-weight: 600; color: var(--ink-3); }
  .card-title { font-weight: 700; font-size: 16.5px; line-height: 1.45; }
  .card:hover .card-title { color: var(--money); }
  .card-date { font-size: 13px; color: var(--ink-3); }
  @media (max-width: 900px) { .card-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .card-grid { grid-template-columns: 1fr; } }
</style>
