---
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../config/site';
import { getPublished } from '../lib/posts';
import tools from '../data/tools.json';

// 사이트 구조도: 상위 → 하위 페이지 연결. 숫자는 실측(발행 글 수·도구 수).
const posts = await getPublished();
const cats = Object.entries(CATEGORIES).map(([key, c]) => ({
  key, ...c,
  n: posts.filter((p) => p.data.category === key).length,
  t: (tools as { cat: string }[]).filter((x) => x.cat === key).length,
  ex: posts.filter((p) => p.data.category === key).slice(0, 2).map((p) => p.data.title),
}));
const tags = new Set(posts.flatMap((p) => p.data.tags)).size;
---
<Base title="사이트 구조" description="머니첵 페이지가 상위 → 하위로 어떻게 연결되는지.">
  <div class="tree">
    <h1>머니첵 사이트 구조 — 상위 → 하위 페이지 연결</h1>
    <p class="sub">공공데이터 팩트체크 & 지원금·대출 애드센스 결합형 3단계 정보 구조. 숫자는 지금 빌드 실측.</p>

    <!-- TIER 1 -->
    <section class="t1">
      <span class="tag mint">TIER 1 · 허브</span>
      <h2><a href="/">홈 /</a></h2>
      <p>히어로 롤링 20쌍 · 영역 칩 7 · 대표 카드 · 지금 많이 보는 콘텐츠 · 나를 위한 정책 · 오리지널 시리즈 4 · 방금 올라온 콘텐츠 8</p>
      <p class="side">같은 층: <a href="/tools">모의계산기 /tools</a> ({tools.length}개 · 인기 26) · <a href="/posts">전체 콘텐츠 /posts</a> ({posts.length}편) · <a href="/about">분석 원칙 /about</a></p>
    </section>
    <div class="down"></div>

    <!-- TIER 2 -->
    <p class="lbl">TIER 2 · 분류 7 (카테고리별 전문 권위)</p>
    <ul class="t2">
      {cats.map((c, i) => (
        <li style={`--b:${c.badge}`}>
          <a href={`/${c.key}`}>
            <span class="pill">{['①','②','③','④','⑤','⑥','⑦'][i]} {c.short}</span>
            <b>{c.n}편</b>
            <small>{c.name} · 도구 {c.t}</small>
            <em>{c.desc}</em>
          </a>
          <div class="drop"></div>
        </li>
      ))}
    </ul>

    <!-- TIER 3 -->
    <p class="lbl">TIER 3 · 롱테일 글 /posts/slug (55 → G1 경제 모드 → G2)</p>
    <ul class="t3">
      {cats.map((c) => (
        <li style={`--b:${c.badge}`}>
          {c.ex.length ? c.ex.map((t) => <span>{t}</span>) : <span class="dim">데이터 구축 중</span>}
        </li>
      ))}
    </ul>
    <p class="note">글 형식: 3초 즉답 → 자격 체크표 → 감액·환수 리스크 → 원스톱 실행 가이드 + 계산기 박스 + 내부 링크 3 + 관련 글 3 + 태그(/tag/…, 지금 {tags}개)</p>

    <!-- 공통 -->
    <p class="lbl">공통 페이지</p>
    <ul class="common">
      <li><a href="/about">분석 원칙</a></li>
      <li><a href="/privacy">개인정보처리방침</a></li>
      <li><a href="/disclaimer">책임의 한계와 법적 고지</a></li>
      <li><a href="/contact">문의</a></li>
      <li><a href="/rss.xml">RSS</a></li>
      <li><span>sitemap-index.xml · robots.txt · ads.txt · 404</span></li>
    </ul>
  </div>
</Base>

<style>
  .tree { max-width: 1080px; margin: 0 auto; padding-top: 44px; }
  .tree h1 { margin: 0 0 6px; font-size: 24px; font-weight: 800; letter-spacing: -0.03em; }
  .sub { margin: 0 0 28px; color: var(--ink-3); font-size: 14px; }
  .lbl { margin: 0 0 12px; font-size: 12.5px; font-weight: 700; color: var(--ink-3); letter-spacing: .02em; }
  .tag { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 800; }
  .tag.mint { background: var(--mint); color: #0f1f1a; }

  .t1 { border: 2px solid var(--mint); border-radius: 16px; padding: 18px 22px; background: color-mix(in srgb, var(--surface) 80%, var(--mint) 4%); }
  .t1 h2 { margin: 10px 0 6px; font-size: 22px; font-weight: 800; letter-spacing: -0.02em; }
  .t1 h2 a:hover { color: var(--mint); }
  .t1 p { margin: 0; font-size: 13.5px; color: var(--ink-2); }
  .t1 .side { margin-top: 8px; color: var(--ink-3); }
  .t1 .side a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .down { width: 2px; height: 40px; margin: 0 auto; background: var(--mint); position: relative; }
  .down::after { content: ''; position: absolute; left: -5px; bottom: -2px; border: 6px solid transparent; border-top: 8px solid var(--mint); }

  .t2 { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(7, 1fr); gap: 10px; }
  .t2 li { position: relative; }
  .t2 a { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; padding: 14px 8px 12px; border-radius: 12px; border: 2px solid var(--b); background: var(--surface); height: 100%; transition: background .15s; }
  .t2 a:hover { background: color-mix(in srgb, var(--b) 10%, var(--surface)); }
  .pill { padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 800; color: #0f1f1a; background: var(--b); white-space: nowrap; }
  .t2 b { font-size: 16px; font-weight: 800; margin-top: 2px; }
  .t2 small { font-size: 11px; color: var(--ink-3); }
  .t2 em { font-style: normal; font-size: 11px; color: var(--ink-2); line-height: 1.4; margin-top: 4px; }
  .drop { width: 0; height: 36px; margin: 0 auto; border-left: 2px dashed color-mix(in srgb, var(--b) 60%, transparent); }

  .t3 { list-style: none; margin: 0 0 12px; padding: 0; display: grid; grid-template-columns: repeat(7, 1fr); gap: 10px; }
  .t3 li { display: grid; gap: 6px; }
  .t3 span { display: block; padding: 8px 9px; border-radius: 8px; background: var(--surface-2); border-left: 3px solid var(--b); font-size: 11px; line-height: 1.4; color: var(--ink-2); }
  .t3 .dim { color: var(--ink-3); border-left-color: var(--hair); }
  .note { margin: 0 0 36px; font-size: 12.5px; color: var(--ink-3); }

  .common { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .common li { padding: 8px 12px; border-radius: 8px; background: var(--surface); border: 1px solid var(--hair); font-size: 13px; }
  .common a:hover { color: var(--money); }
  .common span { color: var(--ink-3); }

  @media (max-width: 900px) { .t2, .t3 { grid-template-columns: repeat(2, 1fr); } .drop { display: none; } }
</style>
