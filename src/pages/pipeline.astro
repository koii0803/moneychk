---
import Base from '../layouts/Base.astro';
// 홈 화면 구조도: 위에서 아래로 블록 순서, 각 블록이 어디서 데이터를 받는지
const blocks = [
  { n: '01', name: '헤더 (Base.astro)', what: '로고 묶음(3D ₩ + 숨쉬는 빛 · Moneycheck / POLICY DATA LAB) · 파이프라인 배지 · GNB 4개 · 밝기 토글', from: 'src/layouts/Base.astro', h: 60 },
  { n: '02', name: '히어로 롤링', what: 'h1 두 줄(윗줄 회색·아랫줄 흰→파랑) + 서브 한 줄. 20쌍이 3.4초마다 페이드. 높이 고정', from: 'index.astro → rolling[20]', h: 200 },
  { n: '03', name: '영역 칩', what: '전체 + 7분류, 가운데 정렬, 각 분류 페이지로', from: 'site.ts CATEGORIES', h: 44 },
  { n: '04', name: '대표 카드 #featured', what: '최신 글 1편. 남색 그라데이션(썸네일 있으면 사진), 파란 배지, 분류 아이콘, 제목 / 요약 + 긴 화살표', from: 'getPublished()[0]', h: 360 },
  { n: '05', name: '두 단', what: '왼쪽: 지금 많이 보는 콘텐츠(번호 4개, 1번 NEW) · 오른쪽: 나를 위한 정책 알아두기(제목·요약·⏳분·분류 배지 | 썸네일, 올리면 확대 + 4색 테두리)', from: 'posts[0..4] / posts[1..9]', h: 520 },
  { n: '06', name: '오리지널 시리즈', what: '세로 카드 4개(도시와 내 집의 설계도 · 월급의 마지막 방어선 · 청년 자산 빌드업 · 비상금과 출구 전략). 색 판 + 3D 아이콘, 콘텐츠 N개 실측', from: 'index.astro → series[4]', h: 380 },
  { n: '07', name: '방금 올라온 콘텐츠', what: '4열 × 2 = 8개(썸네일·제목·날짜, 올리면 확대) + 더 펼쳐보기 → /posts', from: 'posts[0..8]', h: 520 },
  { n: '08', name: '푸터 (Base.astro)', what: '로고 묶음(헤더와 동일) · 태그라인 · 분류 7 · 소개/개인정보/법적 고지/문의/RSS · ©', from: 'src/layouts/Base.astro', h: 200 },
];
---
<Base title="홈 화면 구조" description="머니첵 홈 화면이 어떤 블록으로 짜였는지.">
  <div class="map">
    <h1>홈 화면 구조 — 위에서 아래로 8블록</h1>
    <p class="sub">왼쪽은 화면 비율 그대로 줄인 와이어프레임, 오른쪽은 각 블록이 뭘 그리고 어디서 데이터를 받는지.</p>

    <div class="grid">
      <div class="wire" aria-hidden="true">
        {blocks.map((b) => <div class="w" style={`flex-basis:${b.h / 6}px`}><span>{b.n}</span></div>)}
      </div>
      <ol class="list">
        {blocks.map((b) => (
          <li>
            <span class="no">{b.n}</span>
            <div>
              <b>{b.name}</b>
              <p>{b.what}</p>
              <code>{b.from}</code>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <h2>공통 규칙</h2>
    <ul class="rules">
      <li><b>색</b> — 배경 #101013 · 카드 #1c1d23 · 글자 #e5e8eb · 강조 토스 블루 #3182f6 · 민트 #00d287(로고·datalab) · 분류 배지 7색(민트·앰버·블루·코랄·틸·바이올렛·핑크)</li>
      <li><b>서체</b> — SUIT Variable(대체 Pretendard), 숫자 고정폭. 제목 800 자간 -0.03em, 본문 400</li>
      <li><b>호버</b> — 제목·메뉴 글씨 파랑, 썸네일 1.06배, 카드 테두리 파랑 40%</li>
      <li><b>이미지</b> — 글 썸네일 없으면 분류 3D 아이콘(public/img/icons)으로 대체</li>
      <li><b>테마</b> — 어두운 화면 기본, 헤더 달 버튼으로 밝은 화면(localStorage 기억)</li>
    </ul>
  </div>
</Base>

<style>
  .map { max-width: 960px; margin: 0 auto; padding-top: 44px; }
  .map h1 { margin: 0 0 6px; font-size: 26px; font-weight: 800; letter-spacing: -0.03em; }
  .map h2 { margin: 56px 0 14px; font-size: 20px; font-weight: 800; }
  .sub { margin: 0 0 32px; color: var(--ink-3); font-size: 14px; }
  .grid { display: grid; grid-template-columns: 150px 1fr; gap: 32px; align-items: start; }
  .wire { position: sticky; top: 80px; display: flex; flex-direction: column; gap: 3px; border: 1px solid var(--hair); border-radius: 10px; padding: 6px; background: var(--surface-2); }
  .w { flex: 0 0 auto; border-radius: 4px; background: var(--surface); border: 1px solid var(--hair); display: grid; place-items: center; font-size: 10px; font-weight: 700; color: var(--ink-3); }
  .w:nth-child(4) { background: linear-gradient(45deg, #0f172a, #334155); }
  .w:nth-child(1), .w:nth-child(8) { background: color-mix(in srgb, var(--surface) 60%, var(--bg)); }
  .list { list-style: none; margin: 0; padding: 0; }
  .list li { display: grid; grid-template-columns: 40px 1fr; gap: 14px; padding: 16px 0; border-bottom: 1px solid var(--hair); }
  .no { font-weight: 800; color: var(--money); font-size: 15px; }
  .list b { display: block; font-size: 16px; font-weight: 800; margin-bottom: 4px; }
  .list p { margin: 0 0 6px; font-size: 14px; color: var(--ink-2); line-height: 1.6; }
  .list code { font-size: 12px; color: var(--mint); background: var(--surface-2); padding: 2px 6px; border-radius: 4px; font-family: ui-monospace, Consolas, monospace; }
  .rules { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .rules li { padding: 12px 16px; border-radius: 12px; background: var(--surface); border: 1px solid var(--hair); font-size: 14px; color: var(--ink-2); line-height: 1.6; }
  .rules b { color: var(--ink); margin-right: 8px; }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } .wire { position: static; flex-direction: row; } .w { flex: 1 1 0; height: 40px; } }
</style>
