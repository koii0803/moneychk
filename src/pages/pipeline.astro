---
import Base from '../layouts/Base.astro';
// 홈페이지 구성도 + 고정값(스펙) + 문제점. 값을 바꾸면 여기와 실제 CSS 둘 다 고친다.
const parts = [
  { no: '①', name: '헤더', color: '#8b95a1', file: 'Base.astro',
    spec: ['높이 60px · sticky · 배경 88% 블러', '로고 34px + 빛 2.4초 숨쉬기', 'Moneycheck 19px/800/-0.025em · 빛 훑기 2.5초 · 올리면 #a8efd0', 'POLICY DATA LAB 8.5px/700/0.18em 민트', 'GNB 14.5px/600 · 올리면 파랑 #3182f6', '밝기 토글 36px · localStorage'],
    issues: ['모바일(≤720)에서 GNB 4개가 전부 숨고 토글만 남음 → 메뉴 없음', '"추천 리포트"는 홈 대표카드 앵커(#featured)라 별도 페이지 없음', '"홈페이지 구성" 배지·이 페이지는 내부용 → 운영 전 링크 빼고 noindex'] },
  { no: '②', name: '히어로 롤링', color: '#3182f6', file: 'index.astro rolling[]',
    spec: ['h1 clamp(30~48px)/800/-0.03em · 2줄 높이 128px 고정', '윗줄 0.78em 회색 #8b95a1 · 아랫줄 흰→파랑 그라데이션', '서브 16px 회색 · 2줄 높이 고정', '3.4초 주기 · 페이드 0.45초 · 20쌍', '움직임 줄이기면 1번 고정 · 탭 숨기면 정지'],
    issues: ['문구 20개 중 "계산기·모의계산기" 약속이 4개 → 계산기 열리기 전엔 과장', '검색엔진엔 1번 문구만 h1로 보임(나머지 19개는 JS)'] },
  { no: '③', name: '영역 칩', color: '#35c48a', file: 'index.astro chips',
    spec: ['전체 + 7 = 8개 · 14px/600 · 패딩 8×16 · 둥근 999', '전체 = 검정 배경 흰 글씨(활성)', '가운데 정렬 · ≤760은 왼쪽 스크롤'],
    issues: ['홈에선 "전체"가 항상 켜져 있고 나머지는 분류 페이지로 이동 → 필터처럼 보이지만 링크'] },
  { no: '④', name: '대표 카드', color: '#f5b544', file: 'index.astro .feat',
    spec: ['판 높이 288px · 그라데이션 #0f172a→#1e293b→#334155 · 둥근 24', '썸네일 있으면 사진 + 위 15%→아래 85% 어둡게', '배지 12px/700 파랑 · 제목 clamp(22~30)/700 20ch', '배경: 글 썸네일, 없으면 feat-default.webp(실사) · 덮개 왼쪽 진하고 오른쪽 옅게 90deg .9→.6→.1 고정', '3D 아이콘 80px 고정 · 분류 따라 자동 교체 · 90% + 그림자', '요약 14px 1줄 잘림 · 화살표 40×24 올리면 +6px'],
    issues: ['최신 글 1편 자동 → 편집 선정 불가', '썸네일 사진 위에 3D 아이콘이 겹침(사진 있으면 아이콘 빼야 할지 결정 필요)'] },
  { no: '⑤', name: '두 단', color: '#ff7a5c', file: 'index.astro .two',
    spec: ['320px + 1fr · 간격 56 · ≤900은 1열', '순위: 최신 3 고정 · 번호 18px 파랑 · 1번 NEW 칩', '피드: 2~6번째 5편 고정 · 제목 18px/700 · 요약 2줄 · 분류 배지(⏳분 없앰)', '분류 배지 11px 7색 · 썸네일 220px 16:9', '올리면 썸네일 1.06배 + 2px 테두리 4색 순환(주황·에메랄드·핑크·앰버)'],
    issues: ['NEW = 1번째 글 고정 (날짜 기준 아님)'] },
  { no: '⑥', name: '오리지널 시리즈', color: '#a78bfa', file: 'index.astro series[]',
    spec: ['4카드 고정 · 그림 1:0.85 · 아이콘 62% + 그림자 · 둥근 18', '제목 17px/700 · 설명 13px · 콘텐츠 N개 실측', '올리면 제목 파랑 · 아이콘 1.06배 · 카드 -2px'],
    issues: ['시리즈 = 분류 링크일 뿐, 시리즈 전용 페이지 없음', '카피 속 숫자("연 6%", "종잣돈 5천만 원")는 검증 안 됨'] },
  { no: '⑦', name: '방금 올라온 콘텐츠', color: '#f472b6', file: 'index.astro .recent',
    spec: ['처음 8개 고정 · 4열×2 · 간격 32×20 · ≤900은 2열', '썸네일 16:9 둥근 12 · 없으면 분류 아이콘 46%', '제목 15px/700 · 날짜 12.5px · 올리면 확대·파랑', '아래 가운데 페이지 넘김 ‹ 1 2 3 › · 8개씩 · JS로 그 자리에서 교체'],
    issues: ['✓ 더 펼쳐보기가 /posts로 튀던 것 → 페이지 넘김으로 그 자리에서 해결'] },
  { no: '⑧', name: '푸터', color: '#8b95a1', file: 'Base.astro',
    spec: ['상단 선 · 배경 92% · 패딩 44/48 · 13.5px', '로고 묶음 헤더와 동일', '태그라인 + 고지 2줄 460px', '분류 7 · 링크 5 · ©'],
    issues: ['support@moneychk.com은 도메인 붙인 뒤 라우팅해야 받음', '이용약관 페이지 없음(필수는 아님)', '✓ 글 없는 분류에서 푸터가 화면 중간에 뜨던 것 → 바닥 고정', '✓ 분류 목록·© 줄이 오른쪽에 붕 떠 있던 것 → 끝단 정렬'] },
];
const common = [
  '폰트 CDN 2개(SUIT + Pretendard) 로드 → Pretendard 빼면 가벼워짐',
  '3D 아이콘(대체 이미지)과 실제 글 AI 썸네일(사진풍)이 섞이면 톤이 다름 → 썸네일 프롬프트 톤 정하거나 아이콘 통일',
  '✓ 로컬 커밋 미푸시 → 09-17 발행 커밋(db07f3a)으로 전부 푸시됨. 이후 수정(분류 페이지·페이지 넘김·파비콘 등)은 다시 로컬만',
];
// 클로드 의견(09-17). 순서 = 내가 보는 우선순위. 결정은 사용자.
const opinion = [
  '1. 글이 먼저다. 지금 화면은 글 30편 이상이어야 제 모양이 난다(홈 8×쪽, 분류 6+9). 시험 글 31편 빼면 3편. G1M→G2 파이프라인 돌려서 분류당 최소 6편은 채워야 "인기글"이 비지 않는다.',
  '2. 계산기 59개는 링크가 하나도 없다. 글 속 "10초 모의계산기" 박스가 빈 곳으로 가니, 중위소득 % 계산기 하나만 먼저 만들고 나머지 박스는 그 하나로 보내는 게 낫다. 전부 만들 때까지 박스를 숨기는 것도 방법.',
  '3. 모바일(≤720)에서 메뉴가 통째로 사라진다. 애드센스 트래픽 대부분이 모바일이라 이건 운영 전에 고쳐야 한다. 햄버거 하나면 된다.',
  '4. /pipeline·"홈페이지 구성" 배지는 내부용이다. 도메인 붙이고 검색 등록하기 전에 링크 빼고 noindex. 예시 글(디딤돌)은 숫자 검증 0이라 draft.',
];
---
<Base title="홈페이지 구성" description="머니첵 홈페이지 구역·고정값·문제점.">
  <div class="tree">
    <h1>머니첵 홈페이지 구성도 — 고정값 · 문제점</h1>
    <p class="sub">대주제(홈페이지) → 구역 8 → 고정값(스펙) / 문제. 값 바꾸면 여기와 CSS 둘 다. <b>PC 기준 전부 고정(09-17) — 바꾸려면 승인.</b></p>

    <section class="t1">
      <span class="tag">대주제</span>
      <h2>머니첵 홈페이지 <small>/</small></h2>
      <p class="kv"><b>배경</b> #101013 · <b>카드</b> #1c1d23 · <b>글자</b> #e5e8eb / #9ca3af / #8b95a1 · <b>강조</b> #3182f6 · <b>민트</b> #00d287 · <b>선</b> 흰 7% · <b>폭</b> 1080 · <b>서체</b> SUIT Variable(대체 Pretendard) · <b>숫자</b> 고정폭 · <b>둥근</b> 12~24 · <b>호버</b> 파랑/1.06배/0.15~0.3초</p>
    </section>
    <div class="down"></div>

    <p class="lbl">구역 8 (화면 순서) — 초록 = 고정값, 빨강 = 문제, ✓ 초록 = 해결된 문제</p>
    <ul class="t2">
      {parts.map((p) => (
        <li style={`--b:${p.color}`}>
          <div class="box">
            <span class="pill">{p.no} {p.name}</span>
            <code>{p.file}</code>
          </div>
          <div class="drop"></div>
          <ul class="t3 ok">{p.spec.map((s) => <li>{s}</li>)}</ul>
          <ul class="t3 bad">{p.issues.map((s) => <li class:list={{ done: s.startsWith('✓') }}>{s}</li>)}</ul>
        </li>
      ))}
    </ul>

    <p class="lbl">전체 공통 문제</p>
    <ul class="t3 bad wide">{common.map((s) => <li class:list={{ done: s.startsWith('✓') }}>{s}</li>)}</ul>

    <p class="lbl">클로드 의견 (09-17, 위가 급한 순)</p>
    <ul class="t3 op wide">{opinion.map((s) => <li>{s}</li>)}</ul>
  </div>
</Base>

<style>
  .tree { max-width: 1160px; margin: 0 auto; padding-top: 44px; }
  .tree h1 { margin: 0 0 6px; font-size: 24px; font-weight: 800; letter-spacing: -0.03em; }
  .sub { margin: 0 0 28px; color: var(--ink-3); font-size: 14px; }
  .lbl { margin: 36px 0 12px; font-size: 12.5px; font-weight: 700; color: var(--ink-3); letter-spacing: .02em; }
  .tag { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 800; background: var(--mint); color: #0f1f1a; }
  .t1 { border: 2px solid var(--mint); border-radius: 16px; padding: 18px 22px; background: color-mix(in srgb, var(--surface) 80%, var(--mint) 4%); }
  .t1 h2 { margin: 10px 0 6px; font-size: 24px; font-weight: 800; letter-spacing: -0.02em; }
  .t1 h2 small { font-size: 14px; color: var(--ink-3); font-weight: 600; margin-left: 6px; }
  .kv { margin: 0; font-size: 13px; color: var(--ink-2); line-height: 1.8; }
  .kv b { color: var(--ink); }
  .down { width: 2px; height: 40px; margin: 0 auto; background: var(--mint); position: relative; }
  .down::after { content: ''; position: absolute; left: -5px; bottom: -2px; border: 6px solid transparent; border-top: 8px solid var(--mint); }

  .t2 { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; align-items: start; }
  .box { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; padding: 12px 8px; border-radius: 12px; border: 2px solid var(--b); background: var(--surface); }
  .pill { padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 800; color: #0f1f1a; background: var(--b); white-space: nowrap; }
  .box code { font-size: 10.5px; color: var(--ink-3); font-family: ui-monospace, Consolas, monospace; }
  .drop { width: 0; height: 22px; margin: 0 auto; border-left: 2px dashed color-mix(in srgb, var(--b) 60%, transparent); }
  .t3 { list-style: none; margin: 0 0 8px; padding: 0; display: grid; gap: 5px; }
  .t3 li { padding: 7px 9px; border-radius: 8px; background: var(--surface-2); border-left: 3px solid var(--b); font-size: 11px; line-height: 1.45; color: var(--ink-2); }
  .t3.ok li { border-left-color: #35c48a; }
  .t3.bad li { border-left-color: #ff5c5c; background: color-mix(in srgb, #ff5c5c 8%, var(--surface-2)); color: var(--ink); }
  .t3.wide li { font-size: 13px; padding: 10px 14px; }
  .t3.op li { border-left-color: #3182f6; background: color-mix(in srgb, #3182f6 8%, var(--surface-2)); color: var(--ink); }
  .t3.bad li.done { border-left-color: #35c48a; background: color-mix(in srgb, #35c48a 10%, var(--surface-2)); color: var(--ink-2); }

  @media (max-width: 900px) { .t2 { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .t2 { grid-template-columns: 1fr; } }
</style>
