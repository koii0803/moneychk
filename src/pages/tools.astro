---
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../config/site';
import all from '../data/tools.json';

// 도구 85개(기획 엑셀 → src/data/tools.json). href가 채워진 것만 실제 계산기로 연결된다.
type Tool = (typeof all)[number];
const cats = Object.entries(CATEGORIES);
// 인기 계산기 = 우선순위 1 (26개), 분류 순서대로
const order = Object.keys(CATEGORIES);
const popular = (all as Tool[]).filter((t) => t.priority === 1).sort((a, b) => order.indexOf(a.cat) - order.indexOf(b.cat) || a.no - b.no);
const rest = (all as Tool[]).filter((t) => t.priority !== 1).sort((a, b) => order.indexOf(a.cat) - order.indexOf(b.cat) || a.priority - b.priority || a.no - b.no);
const short = (name: string) => name.replace(/\s*\([^)]*\)\s*$/, '');
---

<Base title="모의계산기" description="지원금 자격·금액을 내 조건으로 바로 계산하는 도구 모음.">
  <header class="tools-head">
    <h1>모의계산기</h1>
    <p>나이·가구원·소득·재산만 넣으면 자격과 예상 금액을 판정합니다. 산식과 기준값은 공식 고시를 그대로 쓰고, 확인일을 함께 표시합니다.</p>
  </header>

  <nav class="chips" aria-label="분류" data-filter>
    <button type="button" class="on" data-cat="all">전체</button>
    {cats.map(([key, c]) => <button type="button" data-cat={key} style={`--b:${c.badge}`}>{c.short}</button>)}
    <a class="chip-link" href="/calc">계산기</a>
  </nav>

  <section class="group">
    <h2 class="section-h">인기 계산기</h2>
    <p class="section-sub">먼저 만드는 순서. 모든 자격 판정의 뿌리부터.</p>
    <ul class="index">
      {popular.map((t) => {
        const c = CATEGORIES[t.cat as keyof typeof CATEGORIES];
        const Tag = t.href ? 'a' : 'div';
        return (
          <li data-cat={t.cat}>
            <Tag class="row" href={t.href || undefined} style={`--c:${c.color};--b:${c.badge}`}>
              <span class="row-name">{short(t.name)}</span>
              <span class="row-thumb" aria-hidden="true"><img src={c.img} alt="" width="60" height="60" loading="lazy" /></span>
              <span class="row-desc">{t.input} → {t.output}</span>
              <span class="row-end">
                <span class="tagpill">{c.short}</span>
                <span class="kind">{t.kind}</span>
                <svg viewBox="0 0 24 24" width="52" height="52" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </span>
            </Tag>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="group">
    <h2 class="section-h">전체 도구</h2>
    <p class="section-sub">각도별 계산기·판정기 {rest.length}개</p>
    <ul class="list">
      {rest.map((t) => {
        const c = CATEGORIES[t.cat as keyof typeof CATEGORIES];
        return (
          <li data-cat={t.cat} style={`--b:${c.badge}`}>
            <span class="tagpill">{c.short}</span>
            <span class="list-name">{short(t.name)}</span>
            <span class="kind">{t.kind}</span>
          </li>
        );
      })}
    </ul>
  </section>

  <script is:inline>
    // 분류 칩: 누르면 그 분류 도구만 남긴다
    document.addEventListener('astro:page-load', () => {
      const nav = document.querySelector('[data-filter]');
      if (!nav) return;
      nav.addEventListener('click', (e) => {
        const b = e.target.closest('button[data-cat]');
        if (!b) return;
        nav.querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
        const cat = b.dataset.cat;
        document.querySelectorAll('li[data-cat]').forEach((li) => { li.hidden = cat !== 'all' && li.dataset.cat !== cat; });
      });
    });
  </script>
</Base>

<style>
  .tools-head { max-width: 760px; padding: 56px 0 28px; }
  .tools-head h1 { margin: 0 0 12px; font-weight: 800; font-size: clamp(30px, 4.6vw, 44px); letter-spacing: -0.03em; }
  .tools-head p { margin: 0; color: var(--ink-2); font-size: 16px; }

  .chips { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; margin: 0 0 48px; padding-bottom: 4px; }
  .chips::-webkit-scrollbar { display: none; }
  .chips button { flex: 0 0 auto; padding: 8px 16px; border-radius: 999px; border: 1px solid var(--hair); background: var(--surface); font-size: 14px; font-weight: 600; color: var(--ink-3); cursor: pointer; }
  .chips button:hover { color: var(--ink); }
  .chips .chip-link { flex: 0 0 auto; padding: 8px 16px; border-radius: 999px; border: 1px solid var(--money); background: var(--money-soft); font-size: 14px; font-weight: 700; color: var(--money); }
  .chips button.on { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .chips button[data-cat]:not([data-cat='all']).on { background: var(--b); border-color: var(--b); color: #0f1f1a; }

  .group { margin-top: 24px; }
  .group + .group { margin-top: 80px; }

  .tagpill { display: inline-block; padding: 3px 8px; border-radius: 5px; font-size: 11px; font-weight: 700; line-height: 1.2; color: var(--b); background: color-mix(in srgb, var(--b) 12%, transparent); border: 1px solid color-mix(in srgb, var(--b) 35%, transparent); white-space: nowrap; }
  .kind { font-size: 12px; font-weight: 600; color: var(--ink-3); white-space: nowrap; }

  /* 토스피드 에디션 목록: 큰 글씨 행, 올리면 흰색 반전 + 썸네일·설명·화살표 */
  .index { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink-3); }
  .index li { border-bottom: 1px solid var(--ink-3); }
  .index li[hidden] { display: none; }
  .row { display: grid; grid-template-columns: auto auto 1fr auto; align-items: center; gap: 0 20px; padding: 22px 28px 22px 32px; margin: 0 -32px; color: var(--ink); transition: background .18s, color .18s; }
  .row-name { font-weight: 700; font-size: clamp(22px, 2.8vw, 34px); letter-spacing: -0.03em; line-height: 1.25; }
  .row-thumb { width: 0; height: 60px; border-radius: 10px; overflow: hidden; display: grid; place-items: center; background: linear-gradient(135deg, color-mix(in srgb, var(--c) 70%, #fff), var(--c)); opacity: 0; transition: width .22s ease, opacity .18s ease; }
  .row-thumb img { width: 52px; height: 52px; object-fit: contain; }
  .row-desc { font-size: 13.5px; color: transparent; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; transition: color .18s; }
  .row-end { display: flex; align-items: center; gap: 14px; }
  .row-end svg { color: transparent; transition: color .18s; }
  .row:hover, .row:focus-visible { background: var(--ink); color: var(--bg); }
  .row:hover .row-thumb { width: 120px; opacity: 1; }
  .row:hover .row-desc { color: color-mix(in srgb, var(--bg) 70%, var(--ink)); }
  .row:hover .row-end svg { color: var(--bg); }
  .row:hover .kind { color: color-mix(in srgb, var(--bg) 60%, var(--ink)); }
  a.row { cursor: pointer; }

  .list { list-style: none; margin: 0; padding: 0; }
  .list li { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--hair); }
  .list li[hidden] { display: none; }
  .list-name { font-size: 16px; font-weight: 600; color: var(--ink-2); }
  .list li:hover .list-name { color: var(--ink); }

  @media (prefers-reduced-motion: reduce) { .row, .row-thumb, .row-desc, .row-end svg { transition: none; } }
  @media (max-width: 720px) {
    .row { grid-template-columns: 1fr auto; padding: 18px 20px; margin: 0 -20px; gap: 6px 12px; }
    .row-thumb { display: none; }
    .row-desc { grid-column: 1 / -1; color: var(--ink-3); }
    .row-end svg { color: var(--ink-3); width: 32px; height: 32px; }
    .row:hover { background: transparent; color: var(--ink); }
    .row:hover .row-desc { color: var(--ink-3); }
    .list li { grid-template-columns: auto 1fr; }
    .list .kind { grid-column: 2; }
  }
</style>
