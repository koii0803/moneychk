---
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../config/site';

// 1군 계산기(기획 엑셀 우선순위 1). 만들어지면 href를 채운다.
const tools = [
  { cat: 'future', name: '중위소득 % 계산기', desc: '가구원 수와 월 소득을 넣으면 기준 중위소득 몇 %인지 판정. 모든 지원금 자격의 출발점.' },
  { cat: 'work', name: '실업급여 계산기', desc: '평균임금·나이·고용보험 가입 기간으로 일 지급액과 소정급여일수 계산.' },
  { cat: 'benefit', name: '기초연금 계산기', desc: '소득인정액을 계산해 단독·부부 가구 선정 기준 통과 여부와 감액 판정.' },
  { cat: 'home', name: '주거급여 계산기', desc: '지역·가구원 수 기준임대료와 실제 임차료로 월 지급액 계산.' },
  { cat: 'future', name: '청년도약계좌 만기 수령액', desc: '월 납입액·소득 구간으로 정부 기여금과 5년 만기 수령액 계산.' },
];
---

<Base title="모의계산기" description="지원금 자격·금액을 내 조건으로 바로 계산하는 도구 모음.">
  <div class="page">
    <h1>모의계산기</h1>
    <p>나이·가구원·소득·재산만 넣으면 자격과 예상 금액을 판정합니다. 산식과 기준값은 공식 고시를 그대로 쓰고, 기준값 확인일을 함께 표시합니다.</p>

    <ul class="tool-list">
      {tools.map((t) => {
        const c = CATEGORIES[t.cat as keyof typeof CATEGORIES];
        return (
          <li class="tool">
            <span class="tool-icon" aria-hidden="true">{c.icon}</span>
            <div>
              <p class="tool-cat">{c.name}</p>
              <h2>{t.name}</h2>
              <p class="tool-desc">{t.desc}</p>
            </div>
            <span class="chip">준비 중</span>
          </li>
        );
      })}
    </ul>
  </div>
</Base>

<style>
  .tool-list { list-style: none; margin: 32px 0 0; padding: 0; display: grid; gap: 12px; }
  .tool { display: grid; grid-template-columns: 48px 1fr auto; gap: 16px; align-items: center; padding: 20px; border-radius: 16px; background: var(--surface); border: 1px solid var(--hair); }
  .tool-icon { font-size: 28px; text-align: center; }
  .tool-cat { margin: 0 0 2px; font-size: 12.5px; font-weight: 600; color: var(--ink-3); }
  .tool h2 { margin: 0 0 4px; font-size: 17px; font-weight: 700; }
  .tool-desc { margin: 0; font-size: 13.5px; color: var(--ink-2); }
  @media (max-width: 560px) { .tool { grid-template-columns: 40px 1fr; } .tool .chip { grid-column: 2; justify-self: start; } }
</style>
