---
import { render } from 'astro:content';
import { getPublished } from '../../lib/posts';
import Base from '../../layouts/Base.astro';
import { CATEGORIES, SITE, fmtDate } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getPublished();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, related: posts.filter((p) => p.id !== post.id && p.data.category === post.data.category).slice(0, 3) },
  }));
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const cat = CATEGORIES[d.category];
const toc = headings.filter((h) => h.depth === 2);
// 읽는 시간: 한글 기준 분당 500자
const minutes = Math.max(1, Math.round((post.body ?? '').replace(/\s+/g, '').length / 500));

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  ...(d.updatedDate && { dateModified: d.updatedDate.toISOString() }),
  ...(d.thumbnail && { image: new URL(d.thumbnail, SITE.url).href }),
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name },
  mainEntityOfPage: new URL(`/posts/${post.id}`, SITE.url).href,
});
---

<Base title={d.title} description={d.description} article ogImage={d.thumbnail} pubDate={d.pubDate} updatedDate={d.updatedDate}>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />

  {/* 글 페이지 강조색 = 분류 기준색. 어두운 화면은 밝은 badge, 밝은 화면은 진한 color */}
  <div class="post-page" style={`--cat:${cat.badge};--cat-dark:${cat.color}`}>
  <div class="progress" aria-hidden="true"><i></i></div>

  <p class="back"><a href={`/${d.category}`}>← {cat.name} 목록으로</a></p>

  <header class="post-head" style={`--c:${cat.color}`}>
    <a class="post-cat" href={`/${d.category}`}>{cat.name} · {cat.desc}</a>
    <h1>{d.title}</h1>
    <p class="post-meta">
      <time datetime={d.pubDate.toISOString()}>{fmtDate(d.pubDate)}</time>
      <span>•</span><span class="who wordmark-mark"><i class="glow"></i><img src="/img/icons/logo.webp" alt={SITE.name} width="20" height="20" /></span>
      <span>•</span><span>{minutes}분 완독</span>
      <span class="views" data-views={post.id} hidden><span>•</span> 조회 <b>0</b></span>
      {d.updatedDate && <><span>•</span><span>수정 {fmtDate(d.updatedDate)}</span></>}
    </p>
  </header>

  <div class="post-grid">
    <aside class="rail" aria-label="글 도구">
      <button type="button" class="rail-btn" data-share aria-label="공유">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg>
        <span>공유</span>
      </button>
      <a class="rail-btn" href="#top" data-top aria-label="맨 위로">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
        <span>위로</span>
      </a>
    </aside>

    <article class="post">
      {d.thumbnail && <img class="post-hero" src={d.thumbnail} alt={d.title} loading="eager" width="1280" height="720" />}
      {/* 09-17 사용자 지시: "3초 즉답 판정 요약" 카드 삭제(PC·모바일). description은 meta·홈 요약에만 쓴다 */}

      <div class="prose">
        <Content />
      </div>

      <a class="calc" href="/tools" data-calc>
        <div class="calc-text">
          <span class="calc-tag">Interactive Tool</span>
          <strong>내 {cat.name} 한도·금액 10초 모의계산기</strong>
          <span>나이, 소득, 가구원만 입력하면 예상 수령액과 자격을 판정합니다.</span>
        </div>
        <img class="calc-icon" src="/img/icons/calc.webp" alt="" width="64" height="64" loading="lazy" />
        <span class="calc-btn">내 수령 가능 금액 직접 계산하기 →</span>
      </a>

      {d.tags.length > 0 && (
        <ul class="post-tags">
          {d.tags.map((t) => <li><a href={`/tag/${t}`}>#{t}</a></li>)}
        </ul>
      )}

      <aside class="post-note">
        <p>본 콘텐츠는 공공데이터 행정 고시를 바탕으로 분석·제작한 일반 정보이며, 개인의 자격·금액 판정은 해당 기관의 최종 심사에 따릅니다.</p>
        <p>제도·금액·기한은 발행일 기준이므로 신청 전 기관 공고에서 다시 확인하세요.</p>
      </aside>
    </article>

    <nav class="toc" aria-label="목차">
      {toc.length > 1 && (
        <>
          <p class="toc-h">목차 바로가기</p>
          <ol>
            {toc.map((h, i) => <li><a href={`#${h.slug}`}>{i + 1}. {h.text.replace(/^\d+[.)]\s*/, '')}</a></li>)}
          </ol>
        </>
      )}
    </nav>
  </div>

  <div class="toast" data-toast role="status" aria-live="polite"></div>

  <div class="bar" data-bar>
    <p>발행일 {fmtDate(d.pubDate)} 기준 수치입니다. 신청 전 공식 공고를 다시 확인하세요.</p>
    <a class="bar-btn" href={`/${d.category}`}>{cat.name} 전체 보기</a>
    <button type="button" class="bar-x" data-bar-close aria-label="닫기">×</button>
  </div>
  <button type="button" class="up-m" data-top aria-label="맨 위로"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>

  {related.length > 0 && (
    <section class="related">
      <h2 class="section-h">같이 볼 글</h2>
      <p class="section-sub">{cat.name}에서 이어지는 글</p>
      <ul class="related-list">
        {related.map((p) => (
          <li style={`--c:${cat.color}`}>
            <a href={`/posts/${p.id}`}>
              <div class="thumb">
                {p.data.thumbnail
                  ? <img src={p.data.thumbnail} alt={p.data.title} width="640" height="360" loading="lazy" />
                  : <div class="thumb-fallback"><img src={cat.img} alt="" width="120" height="120" loading="lazy" /></div>}
              </div>
              <span class="t">{p.data.title}</span>
              <span class="s">{fmtDate(p.data.pubDate)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
  </div>

  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      // 목차: 화면에 보이는 소제목에 표시
      // 기준선을 지난 마지막 소제목이 현재 위치. 기준선은 맨 위에선 140px, 바닥에 가까울수록 화면 아래로 내려가
      // 마지막 절이 짧아도 끝까지 내리면 마지막 항목에 닿는다.
      const links = [...document.querySelectorAll('.toc a')];
      if (links.length) {
        const heads = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));
        const mark = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const p = max > 0 ? Math.min(1, window.scrollY / max) : 1;
          const line = 140 + p * (window.innerHeight - 140);
          let idx = 0;
          heads.forEach((h, i) => { if (h && h.getBoundingClientRect().top <= line) idx = i; });
          links.forEach((a, i) => a.classList.toggle('on', i === idx));
        };
        mark();
        window.addEventListener('scroll', mark, { passive: true });
        window.addEventListener('resize', mark);
      }
      // 계산기 박스를 본문 3번째 소제목 앞으로
      const calc = document.querySelector('[data-calc]');
      const h2s = document.querySelectorAll('.prose h2');
      if (calc && h2s.length >= 3) h2s[2].before(calc);
      // 읽은 만큼 진행 바
      const bar = document.querySelector('.progress i');
      if (bar) {
        const tick = () => {
          const total = document.documentElement.scrollHeight - window.innerHeight;
          const done = Math.min(1, Math.max(0, window.scrollY / (total || 1)));
          bar.style.transform = 'scaleX(' + done + ')';
        };
        tick();
        window.addEventListener('scroll', tick, { passive: true });
      }
      // 공유: 기기 공유창, 없으면 주소 복사
      const share = document.querySelector('[data-share]');
      const toast = document.querySelector('[data-toast]');
      const say = (msg) => {
        if (!toast) return;
        toast.textContent = msg; toast.classList.add('show');
        clearTimeout(toast._t); toast._t = setTimeout(() => toast.classList.remove('show'), 2400);
      };
      share?.addEventListener('click', async () => {
        try {
          if (navigator.share) await navigator.share({ title: document.title, url: location.href });
          else { await navigator.clipboard.writeText(location.href); say('링크가 클립보드에 복사되었습니다.'); }
        } catch (e) {}
      });
      // 조회수: 글 열리면 +1 하고 숫자 표시(워커 /api/view). 실패하면 그냥 숨긴 채로 둔다
      const v = document.querySelector('[data-views]');
      if (v && !v.dataset.on) {
        v.dataset.on = '1';
        fetch('/api/view/' + encodeURIComponent(v.dataset.views), { method: 'POST' })
          .then((r) => r.json()).then((d) => { if (typeof d.views === 'number') { v.querySelector('b').textContent = d.views.toLocaleString('ko-KR'); v.hidden = false; } })
          .catch(() => {});
      }
      // 위로: #top이 sticky 헤더라 앵커로는 안 올라감 → 직접 스크롤
      document.querySelectorAll('[data-top]').forEach((el) => el.addEventListener('click', (e) => { e.preventDefault(); window.scrollTo({ top: 0, behavior: 'smooth' }); }));
      // 모바일 위로 버튼: 600px 넘게 내려가면 보임
      const upM = document.querySelector('.up-m');
      if (upM) { const t = () => upM.classList.toggle('show', window.scrollY > 600); t(); window.addEventListener('scroll', t, { passive: true }); }
      // 바닥 바: 어느 정도 읽으면 나오고, 닫으면 이 페이지에선 다시 안 뜸
      const foot = document.querySelector('[data-bar]');
      if (foot) {
        const show = () => { if (window.scrollY > 600) foot.classList.add('show'); };
        show();
        window.addEventListener('scroll', show, { passive: true });
        foot.querySelector('[data-bar-close]')?.addEventListener('click', () => { foot.remove(); });
      }
    });
  </script>
</Base>

<style is:global>
  /* 분류 기준색을 이 페이지의 --money로 덮어씀 → 알약·즉답 카드·표 머리·✓·계산기 박스·하단 바·목차·링크 전부 분류색 */
  .post-page { --money: var(--cat); --money-soft: color-mix(in srgb, var(--cat) 14%, transparent); }
  :root[data-theme='light'] .post-page { --money: var(--cat-dark); --money-soft: color-mix(in srgb, var(--cat-dark) 10%, transparent); }
  .post-head { max-width: 760px; margin: 0 auto; padding: 96px 0 120px; text-align: center; }
  .back { max-width: 1300px; margin: 28px auto 0; padding: 0; font-size: 12.5px; font-weight: 600; color: var(--ink-3); }
  .back a:hover { color: var(--ink); }
  .post-cat {
    display: inline-block; padding: 5px 12px; border-radius: 999px; font-size: 12.5px; font-weight: 700;
    color: var(--money); background: var(--money-soft); border: 1px solid color-mix(in srgb, var(--money) 25%, transparent);
  }
  .post-meta .views b { font-weight: 600; color: var(--ink); }
  .post-meta .views > span { margin-right: 8px; }
  .post-meta .who { width: 22px; height: 22px; } /* 헤더 .wordmark-mark + .glow 재사용, 크기만 축소 */
  .post-meta .who img { width: 20px; height: 20px; }
  .post-meta .who .glow { inset: -4px; }
  .post-head h1 {
    margin: 14px 0 16px; font-weight: 800;
    font-size: clamp(30px, 4.6vw, 48px); line-height: 1.28; letter-spacing: -0.03em;
  }
  .post-meta { margin: 0; display: flex; justify-content: center; align-items: center; gap: 8px; font-size: 15px; color: var(--ink-2); }

  .progress { position: fixed; top: 59px; left: 0; right: 0; height: 3px; z-index: 41; }
  .progress i { display: block; height: 100%; background: var(--ink); transform: scaleX(0); transform-origin: left; }

  /* 토스피드 배치: 레일 64 · 본문 700 · 목차 220, 사이 110/150. 가운데 정렬, .wrap(1080)보다 넓어 밖으로 뺀다 */
  /* 양옆 칸은 minmax(0,1fr)라 항상 같은 폭 → 본문이 제목과 같은 중심선. 옆 칸이 좁으면 레일·목차 여백이 줄어든다 */
  .post-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 700px) minmax(0, 1fr); column-gap: 0; align-items: start; width: min(1300px, 100vw - 40px); margin-left: 50%; transform: translateX(-50%); }
  .rail { justify-self: end; margin-right: min(110px, 30%); }
  .toc { justify-self: start; margin-left: calc(min(110px, 30%) + 64px); width: min(220px, 70%); } /* 본문이 32px 오른쪽으로 밀려 있어(.post) 공유 버튼과 간격을 맞추려면 rail 여백 + 64px */
  .post { min-width: 0; transform: translateX(32px); } /* 오른쪽 목차 무게 때문에 눈에는 왼쪽으로 보여 살짝 오른쪽으로 */

  .rail { position: sticky; top: 110px; display: flex; flex-direction: column; gap: 8px; }
  .rail-btn {
    width: 64px; height: 64px; border-radius: 12px; border: 1px solid var(--hair); background: var(--surface);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
    font-size: 11.5px; color: var(--ink-2); cursor: pointer;
  }
  .rail-btn:hover { color: var(--ink); border-color: var(--ink-3); }

  .bar {
    position: fixed; left: calc(50% + 32px); bottom: 20px; transform: translate(-50%, 140%); z-index: 38; /* 본문(.post)이 32px 오른쪽으로 밀려 있어 그 중앙에 맞춤 */
    width: min(720px, calc(100% - 32px)); display: flex; align-items: center; gap: 14px;
    padding: 12px 12px 12px 20px; border-radius: 16px;
    background: color-mix(in srgb, var(--surface) 90%, var(--money)); border: 1px solid var(--hair); box-shadow: var(--shadow);
    transition: transform .3s ease;
  }
  .bar.show { transform: translate(-50%, 0); }
  .bar p { margin: 0; flex: 1; font-size: 14px; color: var(--ink-2); }
  .bar-btn { padding: 10px 16px; border-radius: 12px; background: var(--money); color: var(--money-ink); font-weight: 700; font-size: 14px; white-space: nowrap; }
  .bar-x { border: 0; background: transparent; font-size: 20px; color: var(--ink-3); cursor: pointer; padding: 0 4px; }
  @media (prefers-reduced-motion: reduce) { .bar { transition: none; } }
  .post-hero { border-radius: 8px; margin-bottom: 36px; aspect-ratio: 16 / 9; object-fit: cover; width: 100%; }
  .answer { margin: 0 0 36px; padding: 20px 24px; border-left: 4px solid var(--money); border-radius: 6px 16px 16px 6px; background: var(--surface); box-shadow: var(--shadow); }
  .answer-h { margin: 0 0 8px; font-size: 14px; font-weight: 700; color: var(--ink); }
  .answer p:last-child { margin: 0; color: var(--ink-2); font-size: 15.5px; line-height: 1.7; }

  .prose { font-size: 17px; line-height: 1.85; }
  .prose h2 { font-weight: 800; font-size: 24px; letter-spacing: -0.02em; margin: 60px 0 16px; scroll-margin-top: 80px; }
  .prose h3 { font-weight: 700; font-size: 19px; margin: 36px 0 10px; scroll-margin-top: 80px; }
  .prose p { margin: 0 0 26px; }
  .prose strong { font-weight: 700; color: var(--ink); }
  .prose ol { padding-left: 22px; margin: 0 0 20px; }
  .prose ul { list-style: none; padding: 0; margin: 0 0 24px; display: grid; gap: 10px; }
  .prose ul li { display: grid; grid-template-columns: 20px 1fr; gap: 12px; align-items: start; padding: 14px 16px; border-radius: 12px; background: var(--surface); border: 1px solid var(--hair); font-size: 15px; line-height: 1.6; color: var(--ink); }
  .prose ul li::before { content: '✓'; width: 20px; height: 20px; border-radius: 999px; display: grid; place-items: center; background: var(--money-soft); color: var(--money); font-size: 12px; font-weight: 800; margin-top: 2px; }
  .prose ul li p { margin: 0; }
  .prose li { margin-bottom: 0; }
  .prose ol li { margin-bottom: 6px; }

  .calc { display: grid; grid-template-columns: 1fr auto; gap: 12px 16px; margin: 36px 0; padding: 24px; border-radius: 18px; background: linear-gradient(90deg, var(--surface), color-mix(in srgb, var(--surface) 85%, var(--money))); border: 1px solid color-mix(in srgb, var(--money) 30%, transparent); box-shadow: var(--shadow); }
  .calc-text { display: flex; flex-direction: column; gap: 4px; }
  .calc-tag { align-self: flex-start; padding: 2px 8px; border-radius: 4px; background: var(--money-soft); color: var(--money); font-size: 11px; font-weight: 700; text-transform: uppercase; }
  .calc-text strong { font-size: 18px; font-weight: 700; color: var(--ink); margin-top: 4px; }
  .calc-text span:last-child { font-size: 12.5px; color: var(--ink-3); }
  .prose .calc-icon { width: 64px; height: 64px; aspect-ratio: 1; margin: 0; border-radius: 0; object-fit: contain; filter: drop-shadow(0 8px 16px rgba(0,0,0,.35)); } /* 3D 계산기 아이콘(누끼제거/Calculator_pastel_3d) — 분류 무관 공통 */
  .calc-btn { grid-column: 1 / -1; display: block; padding: 12px; border-radius: 12px; background: var(--money); color: #fff; font-size: 14px; font-weight: 700; text-align: center; box-shadow: 0 8px 20px color-mix(in srgb, var(--money) 25%, transparent); }
  .calc:hover .calc-btn { filter: brightness(1.08); }
  .prose blockquote { margin: 28px 0; padding: 16px 20px; border-left: 3px solid var(--money); background: var(--surface); border-radius: 0 12px 12px 0; font-size: 15.5px; }
  .prose blockquote p { margin: 0; }
  .prose table { width: 100%; border-collapse: separate; border-spacing: 0; margin: 28px 0; font-size: 14.5px; line-height: 1.55; border: 1px solid var(--hair); border-radius: 12px; overflow: hidden; background: var(--surface-2); }
  .prose thead th { font-size: 13.5px; color: var(--ink); background: var(--surface); padding: 13px 14px; text-align: left; white-space: nowrap; border-bottom: 1px solid var(--hair); }
  .prose tbody td { border-bottom: 1px solid var(--hair); padding: 13px 14px; vertical-align: top; color: var(--ink-2); }
  .prose tbody td:first-child { color: var(--ink); font-weight: 500; }
  /* 표 안 강조 규칙: 머리칸 **굵게** = 파랑, 본문 **굵게** = 흰색, <mark> = 주황(주의 값) */
  .prose th strong { color: var(--money); }
  .prose td strong { color: var(--ink); font-weight: 700; }
  .prose mark { background: none; color: #fb923c; font-weight: 600; }
  .prose tbody tr:last-child td { border-bottom: 0; }
  .prose em { display: block; margin: -12px 0 24px; font-size: 13px; color: var(--ink-3); font-style: italic; }
  .prose hr { border: 0; border-top: 1px solid var(--hair); margin: 44px 0; }
  .prose a { color: var(--money); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: color-mix(in srgb, var(--money) 40%, transparent); }
  .prose a:hover { text-decoration-color: var(--money); }
  .prose img { border-radius: 14px; margin: 28px 0; aspect-ratio: 16 / 9; object-fit: cover; width: 100%; }

  .post-tags { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 40px 0 0; padding: 0; }
  .post-tags a { display: inline-block; padding: 5px 12px; border-radius: 999px; background: var(--surface); font-size: 13px; color: var(--ink-2); }
  .post-tags a:hover { color: var(--money); }
  .post-note { margin: 40px 0 0; padding: 24px 0 0; border-top: 1px solid var(--hair); font-size: 13px; color: var(--ink-3); line-height: 1.7; }
  .post-note p { margin: 0 0 4px; }
  .toast {
    position: fixed; left: 50%; bottom: 96px; transform: translate(-50%, 20px); z-index: 50; opacity: 0; pointer-events: none;
