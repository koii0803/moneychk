---
import { render } from 'astro:content';
import { getPublished } from '../../lib/posts';
import Base from '../../layouts/Base.astro';
import { CATEGORIES, SITE, fmtDate } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getPublished();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, related: posts.filter((p) => p.id !== post.id && p.data.category === post.data.category).slice(0, 3) },
  }));
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const cat = CATEGORIES[d.category];
const toc = headings.filter((h) => h.depth === 2);
// 읽는 시간: 한글 기준 분당 500자
const minutes = Math.max(1, Math.round((post.body ?? '').replace(/\s+/g, '').length / 500));

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  ...(d.updatedDate && { dateModified: d.updatedDate.toISOString() }),
  ...(d.thumbnail && { image: new URL(d.thumbnail, SITE.url).href }),
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name },
  mainEntityOfPage: new URL(`/posts/${post.id}`, SITE.url).href,
});
---

<Base title={d.title} description={d.description} article ogImage={d.thumbnail} pubDate={d.pubDate} updatedDate={d.updatedDate}>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />

  <header class="post-head" style={`--c:${cat.color}`}>
    <a class="post-cat" href={`/${d.category}`}>{cat.name}</a>
    <h1>{d.title}</h1>
    <p class="post-meta">
      <time datetime={d.pubDate.toISOString()}>{fmtDate(d.pubDate)}</time>
      <span>·</span><span>{SITE.name}</span>
      <span>·</span><span>{minutes}분</span>
      {d.updatedDate && <><span>·</span><span>수정 {fmtDate(d.updatedDate)}</span></>}
    </p>
  </header>

  <div class="post-grid">
    <article class="post">
      {d.thumbnail && <img class="post-hero" src={d.thumbnail} alt={d.title} loading="eager" width="1280" height="720" />}
      <p class="post-desc">{d.description}</p>

      <div class="prose">
        <Content />
      </div>

      {d.tags.length > 0 && (
        <ul class="post-tags">
          {d.tags.map((t) => <li><a href={`/tag/${t}`}>#{t}</a></li>)}
        </ul>
      )}

      <aside class="post-note">
        이 글은 공식 자료를 근거로 한 일반 정보이며, 개인의 자격·금액 판정은 해당 기관의 최종 심사에 따릅니다.
        제도·금액·기한은 발행일 기준이므로 신청 전 기관 공고에서 다시 확인하세요.
      </aside>
    </article>

    {toc.length > 1 && (
      <nav class="toc" aria-label="목차">
        <p class="toc-h">목차</p>
        <ol>
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
    )}
  </div>

  {related.length > 0 && (
    <section class="related">
      <h2 class="section-h">같이 볼 글</h2>
      <p class="section-sub">{cat.name}에서 이어지는 글</p>
      <ul class="related-list">
        {related.map((p) => (
          <li style={`--c:${cat.color}`}>
            <a href={`/posts/${p.id}`}>
              <div class="thumb">
                {p.data.thumbnail
                  ? <img src={p.data.thumbnail} alt={p.data.title} width="640" height="360" loading="lazy" />
                  : <div class="thumb-fallback">₩</div>}
              </div>
              <span class="t">{p.data.title}</span>
              <span class="s">{fmtDate(p.data.pubDate)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <script is:inline>
    // 목차: 화면에 보이는 소제목에 표시
    document.addEventListener('astro:page-load', () => {
      const links = [...document.querySelectorAll('.toc a')];
      if (!links.length) return;
      const map = new Map(links.map((a) => [a.getAttribute('href').slice(1), a]));
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((a) => a.classList.remove('on'));
            map.get(e.target.id)?.classList.add('on');
          }
        });
      }, { rootMargin: '-80px 0px -70% 0px' });
      map.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
    });
  </script>
</Base>

<style is:global>
  .post-head { max-width: 760px; margin: 0 auto; padding: 56px 0 36px; text-align: center; }
  .post-cat { font-size: 14px; font-weight: 700; color: var(--c); }
  .post-head h1 {
    margin: 14px 0 16px; font-weight: 800;
    font-size: clamp(28px, 4.2vw, 42px); line-height: 1.3; letter-spacing: -0.03em;
  }
  .post-meta { margin: 0; display: flex; justify-content: center; gap: 8px; font-size: 14px; color: var(--ink-3); }

  .post-grid { display: grid; grid-template-columns: 1fr 220px; gap: 56px; align-items: start; }
  .post { max-width: 760px; margin: 0 auto; min-width: 0; }
  .post-hero { border-radius: 18px; margin-bottom: 32px; aspect-ratio: 16 / 9; object-fit: cover; width: 100%; box-shadow: var(--shadow); }
  .post-desc { margin: 0 0 32px; padding: 18px 22px; border-radius: 14px; background: var(--surface); color: var(--ink-2); font-size: 16px; line-height: 1.7; }

  .prose { font-size: 17px; line-height: 1.85; }
  .prose h2 { font-weight: 800; font-size: 24px; letter-spacing: -0.02em; margin: 60px 0 16px; scroll-margin-top: 80px; }
  .prose h3 { font-weight: 700; font-size: 19px; margin: 36px 0 10px; scroll-margin-top: 80px; }
  .prose p { margin: 0 0 20px; }
  .prose strong { font-weight: 700; color: var(--ink); }
  .prose ul, .prose ol { padding-left: 22px; margin: 0 0 20px; }
  .prose li { margin-bottom: 6px; }
  .prose blockquote { margin: 28px 0; padding: 16px 20px; border-left: 3px solid var(--money); background: var(--surface); border-radius: 0 12px 12px 0; font-size: 15.5px; }
  .prose blockquote p { margin: 0; }
  .prose table { width: 100%; border-collapse: collapse; margin: 28px 0; font-size: 14.5px; line-height: 1.55; }
  .prose thead th { font-size: 13.5px; background: var(--surface); padding: 11px 12px; text-align: left; white-space: nowrap; border-bottom: 1px solid var(--hair); }
  .prose thead th:first-child { border-radius: 10px 0 0 0; }
  .prose thead th:last-child { border-radius: 0 10px 0 0; }
  .prose tbody td { border-bottom: 1px solid var(--hair); padding: 11px 12px; vertical-align: top; }
  .prose td:not(:first-child), .prose th:not(:first-child) { text-align: right; }
  .prose hr { border: 0; border-top: 1px solid var(--hair); margin: 44px 0; }
  .prose a { color: var(--money); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: color-mix(in srgb, var(--money) 40%, transparent); }
  .prose a:hover { text-decoration-color: var(--money); }
  .prose img { border-radius: 14px; margin: 28px 0; aspect-ratio: 16 / 9; object-fit: cover; width: 100%; }

  .post-tags { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 40px 0 0; padding: 0; }
  .post-tags a { display: inline-block; padding: 5px 12px; border-radius: 999px; background: var(--surface); font-size: 13px; color: var(--ink-2); }
  .post-tags a:hover { color: var(--money); }
  .post-note { margin: 32px 0 0; padding: 16px 20px; border-radius: 12px; background: var(--surface); font-size: 14px; color: var(--ink-2); line-height: 1.7; }

  .toc { position: sticky; top: 84px; border-left: 1px solid var(--hair); padding-left: 16px; font-size: 13.5px; }
  .toc-h { margin: 0 0 10px; font-weight: 700; color: var(--ink-3); font-size: 12.5px; }
  .toc ol { list-style: none; margin: 0; padding: 0; }
  .toc li { margin: 0 0 10px; }
  .toc a { display: block; color: var(--ink-2); line-height: 1.45; margin-left: -17px; padding-left: 16px; border-left: 2px solid transparent; }
  .toc a:hover { color: var(--ink); }
  .toc a.on { color: var(--money); border-left-color: var(--money); font-weight: 600; }

  .related { max-width: 760px; margin: 80px auto 0; }
  .related-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .related-list a { display: flex; flex-direction: column; gap: 6px; }
  .related-list .thumb { margin-bottom: 4px; }
  .related-list .t { font-weight: 700; font-size: 15px; line-height: 1.45; }
  .related-list a:hover .t { color: var(--money); }
  .related-list .s { font-size: 12.5px; color: var(--ink-3); }

  @media (max-width: 960px) {
    .post-grid { grid-template-columns: 1fr; }
    .toc { display: none; }
  }
  @media (max-width: 640px) {
    .related-list { grid-template-columns: 1fr; }
    .post-head { padding-top: 36px; }
  }
</style>
