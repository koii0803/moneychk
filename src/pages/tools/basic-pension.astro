---
import Base from '../../layouts/Base.astro';
import CalcDock from '../../components/CalcDock.astro';
import { SITE, CATEGORIES } from '../../config/site';
import calc from '../../data/calcs/basic-pension.json';
import tools from '../../data/tools.json';

// 계산기 한 장 = JSON 한 장(src/data/calcs/<slug>.json). 이 페이지는 그 JSON을 읽어 그린다.
// 선정기준액·기준연금액·공제액·환산율·감액률은 JSON params(연도 키)에서만 온다. 코드에 숫자를 박지 않는다.
const cat = CATEGORIES[calc.cat as keyof typeof CATEGORIES];
const pageUrl = `${SITE.url}/tools/${calc.slug}`;
// 구조화 데이터: 이 페이지가 "무료 웹 계산기"라는 것과 사이트 안 위치를 구글에 알려 준다.
// 계산기용 리치결과는 구글에 없다 — 엔티티 이해·사이트링크·빵부스러기 경로에 쓰인다.
const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: calc.name,
    url: pageUrl,
    description: calc.description,
    applicationCategory: 'FinanceApplication',
    applicationSubCategory: '모의계산기',
    operatingSystem: 'All',
    browserRequirements: 'JavaScript',
    inLanguage: 'ko',
    isAccessibleForFree: true,
    dateModified: calc.basis_date,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    ...(calc.keyword ? { keywords: calc.keyword } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: SITE.url },
      { '@type': 'ListItem', position: 2, name: '모의계산기', item: `${SITE.url}/tools` },
      { '@type': 'ListItem', position: 3, name: calc.name, item: pageUrl },
    ],
  },
]);
const byStep = (n: number) => calc.inputs.filter((i) => i.step === n);
const related = calc.related_calcs.map((r) => {
  const t = r.tool_no ? tools.find((x) => x.no === r.tool_no) : undefined;
  return { ...r, href: t?.href || r.href || '' };
});
const basisYear = calc.basis_date.slice(0, 4);
const P = calc.params as Record<string, unknown>;
const params = P[basisYear] as Record<string, unknown>;
const stepTitle = ['', '가구', '소득', '재산'];
const stepSub = ['', '단독·부부, 나이', '월 세전 금액', '부부 합산 재산·부채'];
---

<Base title={calc.name} description={calc.description}>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />
  <div class="calc" data-calc>
    <header class="hero">
      <span class="eyebrow">모의계산기 · {cat.short}</span>
      <h1>{calc.name}</h1>
      <p class="lede">{calc.lede}</p>
      <div class="stamps">
        <span class="stamp gold"><b>{calc.basis_label}</b></span>
        <span class="stamp">확인일 <b>{calc.basis_date.replace(/-/g, '.')}</b></span>
        <span class="stamp">기준 <b>보건복지부고시 제2026-156호</b></span>
      </div>
    </header>

    <div class="cols">
      <div class="in">
        {[1, 2, 3].map((n) => (
          <section class="card" id={`s${n}`}>
            <div class="card-h">
              <span class="num">STEP {n}</span>
              <h2>{stepTitle[n]}</h2>
              <p>{stepSub[n]}</p>
            </div>
            <div class="grid">
              {byStep(n).map((f) => (
                <div class="field" data-show={f.show || undefined}>
                  {f.type === 'check' ? (
                    <label class="toggle">
                      <input type="checkbox" id={`f-${f.id}`} data-in={f.id} data-type="check" checked={f.id === 'age65'} />
                      <span>{f.label}<small>{f.help}</small></span>
                    </label>
                  ) : (
                    <>
                      <label for={`f-${f.id}`}>{f.label}{f.optional && <small> (선택)</small>}</label>
                      <div class="inp">
                        {f.type === 'select' ? (
                          <select id={`f-${f.id}`} data-in={f.id} data-type="select">
                            {(f.options || []).map((o) => <option value={o.value}>{o.label}</option>)}
                          </select>
                        ) : (
                          <input type="text" inputmode="numeric" id={`f-${f.id}`} data-in={f.id} data-type="won" placeholder="0" autocomplete="off" />
                        )}
                        {f.type === 'won' && <span class="unit">원</span>}
                      </div>
                      {f.help && <p class="sub">{f.help}</p>}
                    </>
                  )}
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="out">
        <section class="card result" id="result" aria-live="polite">
          <div class="card-h"><span class="num">결과</span><h2>기초연금 계산표</h2><p>{calc.basis_label}</p></div>
          <p class="answer" data-answer>소득과 재산을 넣으면 소득인정액과 월 기초연금액이 나온다.</p>
          <div class="tbl-wrap">
            <table>
              <thead><tr><th>항목</th><th class="r">금액</th><th class="f">산식</th></tr></thead>
              <tbody>
                {calc.steps.map((s) => (
                  <tr class={s.total ? 'total' : ''} data-row={s.id}>
                    <td><span class="no">({s.no})</span> {s.label}<small class="f2">{s.formula}</small></td>
                    <td class="r"><b data-val={s.id}>—</b></td>
                    <td class="f"><code>{s.formula}</code></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="hint" data-warn hidden></p>
        </section>
      </div>
    </div>

    <section class="card slim">
      <div class="card-h"><span class="num">관련</span><h2>같이 쓰는 계산기</h2></div>
      <div class="rel">
        {related.map((r) => r.href
          ? <a class="rel-btn" href={r.href}>{r.name}</a>
          : <span class="rel-btn off" aria-disabled="true">{r.name} <small>준비 중</small></span>)}
      </div>
      <div class="share" data-share data-url={pageUrl} data-title={`${calc.name} — ${SITE.name}`}>
        <span class="share-l">공유</span>
        <a class="share-btn" data-share-fb href="#" target="_blank" rel="noopener">페이스북</a>
        <a class="share-btn" data-share-x href="#" target="_blank" rel="noopener">X</a>
        <a class="share-btn" data-share-naver href="#" target="_blank" rel="noopener">네이버 블로그</a>
        <a class="share-btn" data-share-band href="#" target="_blank" rel="noopener">밴드</a>
      </div>
    </section>

    <div class="ad-slot" data-slot="in-article"></div>

    <section class="card slim">
      <div class="card-h"><span class="num">※</span><h2>산식과 근거</h2><p>확인일 {calc.basis_date.replace(/-/g, '.')}</p></div>
      <ol class="notes">
        {calc.notes.map((n) => <li>{n}</li>)}
      </ol>
      <p class="src">
        {calc.law.map((l) => <span>· <a href={l.url} target="_blank" rel="noopener">{l.name}</a> <em>{l.ver}</em><br /></span>)}
      </p>
    </section>

    <section class="card slim hist-card">
      <div class="card-h"><span class="num">이력</span><h2>기준값 이력</h2><p>바뀌면 줄이 늘어난다</p></div>
      <div class="tbl-wrap">
        <table class="hist">
          <thead><tr><th>날짜</th><th>기준값</th><th class="r">값</th><th>출처</th></tr></thead>
          <tbody>
            {calc.history.map((h) => (
              <tr><td>{h.date.replace(/-/g, '.')}</td><td><code>{h.param}</code></td><td class="r"><b>{h.value}</b></td><td>{h.src}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <p class="foot-note">{calc.disclaimer}<br />입력값은 이 브라우저 안에서만 계산되며 서버로 보내지 않는다.</p>
  </div>

  <script type="application/json" id="calc-params" set:html={JSON.stringify(params)} />
  <script is:inline>
    // 순수 JS. 입력이 바뀌면 즉시 다시 계산한다. 산식은 JSON steps.formula와 같은 순서.
    // 소득인정액 = 소득평가액 + 재산의 소득환산액 (법 제2조). 수급 = 소득인정액 ≤ 선정기준액 (법 제3조).
    // 기초연금액 = 기준연금액 → 국민연금 연계(법 제5조·제6조, 영 제10조) → 부부 20% 감액(법 제8조 제1항) → 소득역전 방지 감액(법 제8조 제2항, 영 제11조).
    (function () {
      function init() {
        var root = document.querySelector('[data-calc]');
        if (!root || root.dataset.ready) return;
        root.dataset.ready = '1';
        var P = JSON.parse(document.getElementById('calc-params').textContent);

        var fmt = function (n) {
          if (n === null || n === undefined || isNaN(n)) return '—';
          return String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        };
        var won = function (n) { return n === null ? '—' : fmt(n) + '원'; };
        var num = function (el) { return Number((el.value || '').replace(/[^\d]/g, '')) || 0; };

        var I = {};
        root.querySelectorAll('[data-in]').forEach(function (el) { I[el.dataset.in] = el; });
        var V = {};
        root.querySelectorAll('[data-val]').forEach(function (el) { V[el.dataset.val] = el; });
        var answer = root.querySelector('[data-answer]');
        var warn = root.querySelector('[data-warn]');
        var totalRow = root.querySelector('[data-row="monthly"]');
        var selRow = root.querySelector('[data-row="selection"]');
        var showFields = root.querySelectorAll('[data-show]');

        function set(id, text) { if (V[id]) V[id].textContent = text; }
        function calc() {
          var couple = I.household.value === 'couple';
          showFields.forEach(function (el) { el.hidden = el.dataset.show === 'couple' ? !couple : false; });
          var two = couple && I.couple_type.value === 'both';
          var age = I.age65.checked, pub = I.public_pension.checked;
          var msgs = [];
          Object.keys(V).forEach(function (k) { set(k, '—'); });
          totalRow.classList.remove('bad'); selRow.classList.remove('bad');

          var SP = P.standard_pension;
          var sel = P.selection[couple ? 'couple' : 'single'];
          var ws = num(I.work_self), wsp = couple ? num(I.work_spouse) : 0;
          var ns = num(I.nps_self), nsp = couple ? num(I.nps_spouse) : 0;
          var oth = num(I.other_income);
          var gen = num(I.prop_general), fin = num(I.prop_fin), debt = num(I.debt), lux = num(I.luxury);
          var filled = [I.work_self, I.work_spouse, I.nps_self, I.nps_spouse, I.other_income, I.prop_general, I.prop_fin, I.luxury].some(function (el) { return el.value !== ''; });

          // (1) 소득평가액: 근로소득은 각자 (근로 − 116만, 0 미만은 0) × 70%. 국민연금·기타소득은 전액.
          var workEval = function (w) { return Math.max(w - P.work_basic_deduct, 0) * (100 - P.work_extra_rate) / 100; };
          var evSelf = workEval(ws), evSp = workEval(wsp);
          var incomeEval = evSelf + evSp + ns + nsp + oth;
          set('income_eval', won(incomeEval));
          if (ws > 0 || wsp > 0) {
            var parts = [];
            if (ws > 0) parts.push('본인 근로 ' + won(ws) + ' → (' + won(ws) + ' − 1,160,000원) × 70% = ' + won(evSelf) + (ws <= P.work_basic_deduct ? ' (116만원 이하라 0원)' : ''));
            if (wsp > 0) parts.push('배우자 근로 ' + won(wsp) + ' → ' + won(evSp) + (wsp <= P.work_basic_deduct ? ' (116만원 이하라 0원)' : ''));
            msgs.push(parts.join(', ') + '. 국민연금 ' + won(ns + nsp) + '과 기타소득 ' + won(oth) + '은 전액 더한다.');
          }

          // (2) 재산의 소득환산액: (일반 − 기본재산액)₊ + (금융 − 2천만)₊ − 부채, 0 미만은 0, × 4% ÷ 12 + 고급차·회원권
          var basic = P.basic_property[I.region.value];
          var genNet = Math.max(gen - basic, 0), finNet = Math.max(fin - P.fin_deduct, 0);
          var baseAmt = Math.max(genNet + finNet - debt, 0);
          var convMonthly = baseAmt * P.conv_rate_year / 100 / 12;
          var propConv = convMonthly + lux;
          set('property_conv', won(propConv));
          if (gen + fin + debt > 0) {
            msgs.push('재산: 일반 ' + won(gen) + ' − 기본재산액 ' + won(basic) + ' = ' + won(genNet) + ', 금융 ' + won(fin) + ' − 2,000만원 = ' + won(finNet) + (debt ? ', 부채 ' + won(debt) + ' 차감' : '') + ' → ' + won(baseAmt) + ' × 4% ÷ 12 = 월 ' + won(convMonthly) + '.');
          }
          if (lux > 0) msgs.push('고급자동차·회원권 ' + won(lux) + '은 공제 없이 가액 전액이 매달 소득으로 잡힌다. 차령 10년 이상·생업용 차는 일반재산(4%)이라 실제는 훨씬 낮을 수 있다.');

          // (3) 소득인정액, (4) 판정
          var recognized = incomeEval + propConv;
          set('recognized', won(recognized));
          var eligible = recognized <= sel;
          var gap = sel - recognized;
          set('selection', (couple ? '부부 ' : '단독 ') + won(sel) + (eligible ? ' 이하 → 수급 (여유 ' + won(gap) + ')' : ' 초과 ' + won(-gap) + ' → 대상 아님'));
          if (!eligible) selRow.classList.add('bad');

          // (5) 기준연금액
          set('standard', won(SP));

          // (6) 국민연금 연계: ≤150% 전액, 150~200% (250% − 국민연금)과 부가연금액 중 큰 값, >200% 부가연금액(하한). A급여 산식은 안 쓴다.
          var full = SP * P.nps_full_rate / 100, twoX = SP * 2, sup = SP * P.supplement_rate / 100;
          var linked = function (nps) {
            if (nps <= full) return SP;
            if (nps <= twoX) return Math.min(SP, Math.max(SP * P.nps_formula_rate / 100 - nps, sup));
            return sup;
          };
          var b1 = linked(ns), b2 = two ? linked(nsp) : 0;
          var linkedTotal = b1 + b2;
          set('nps_linked', won(b1) + (two ? ' + 배우자 ' + won(b2) : ''));
          if (ns > full) msgs.push('본인 국민연금 ' + won(ns) + '이 기준연금액의 150%(' + won(full) + ')를 넘어 기초연금액이 ' + won(b1) + '으로 줄었다. 실제는 국민연금공단의 A급여액 산식으로 정해지며 이 값 이상 ' + won(SP) + ' 이하다.');
          if (two && nsp > full) msgs.push('배우자 국민연금 ' + won(nsp) + '이 150%를 넘어 배우자 기초연금액은 ' + won(b2) + ' (하한).');

          // (7) 부부 감액 20%
          var cut1 = two ? b1 * P.couple_cut_rate / 100 : 0, cut2 = two ? b2 * P.couple_cut_rate / 100 : 0;
          var a1 = b1 - cut1, a2 = b2 - cut2, afterCouple = a1 + a2;
          set('couple_cut', two ? '− ' + won(cut1 + cut2) + ' (각 20%)' : '0원' + (couple ? ' (1인 수급)' : ''));

          // (8) 소득역전 방지: 소득인정액 + 기초연금액 > 선정기준액이면 (선정기준액 − 소득인정액)까지, 최저 10%(부부 2인 20%)
          var floorAmt = SP * (two ? P.floor_rate_couple : P.floor_rate_single) / 100;
          var pay = afterCouple, revCut = 0;
          if (eligible && recognized + afterCouple > sel) {
            pay = Math.min(afterCouple, Math.max(gap, floorAmt));
            revCut = afterCouple - pay;
          }
          set('reversal_cut', revCut > 0 ? '− ' + won(revCut) : '0원');
          if (revCut > 0) msgs.push('소득인정액 ' + won(recognized) + ' + 기초연금액 ' + won(afterCouple) + ' = ' + won(recognized + afterCouple) + '이 선정기준액 ' + won(sel) + '을 넘어 ' + won(revCut) + ' 감액 (최저 ' + won(floorAmt) + '은 보장).');

          // 부부 2인 수급이면 감액 후 금액을 각자 기초연금액에 비례 배분, 1인당 최저 10%
          var p1 = pay, p2 = 0;
          if (two) {
            p1 = afterCouple > 0 ? pay * a1 / afterCouple : 0; p2 = pay - p1;
            var min1 = SP * P.floor_rate_single / 100;
            if (p1 < min1) { p1 = min1; p2 = pay - p1; }
            if (p2 < min1) { p2 = min1; p1 = pay - p2; }
          }

          // (9) 월 수령액
          if (!filled) {
            set('monthly', won(pay) + ' (소득·재산 0 기준)');
            answer.textContent = couple ? '부부 소득·재산을 넣으면 소득인정액과 월 기초연금액이 나온다.' : '소득과 재산을 넣으면 소득인정액과 월 기초연금액이 나온다.';
            if (pub) { answer.textContent = '직역연금 수급권자(또는 배우자)는 기초연금 대상이 아니다.'; set('monthly', '대상 아님'); totalRow.classList.add('bad'); }
            warn.innerHTML = msgs.join('<br />'); warn.hidden = msgs.length === 0; return;
          }
          if (pub) {
            set('monthly', '대상 아님'); totalRow.classList.add('bad');
            answer.textContent = '공무원·사학·군인·별정우체국 퇴직연금 수급권자와 그 배우자는 기초연금 대상이 아니다.';
            msgs.unshift('기초연금법 제3조 제3항. 퇴직일시금·유족일시금을 받은 사람(직역 재직 10년 미만 연계연금 등)은 대상이므로 해당하면 체크를 끈다.');
          } else if (!eligible) {
            set('monthly', '대상 아님'); totalRow.classList.add('bad');
            answer.textContent = (couple ? '부부가구' : '단독가구') + ' 소득인정액 ' + won(recognized) + '은 선정기준액 ' + won(sel) + '을 ' + won(-gap) + ' 넘어 기초연금 대상이 아니다.';
          } else {
            set('monthly', two ? won(pay) + ' (본인 ' + won(p1) + ' + 배우자 ' + won(p2) + ')' : won(pay));
            answer.textContent = (couple ? '부부가구' : '단독가구') + ' 소득인정액 ' + won(recognized) + '이면 ' + (two ? '부부 합산 월 기초연금은 ' : '월 기초연금은 ') + won(pay) + '이다.';
            if (!age) msgs.unshift('신청자가 만 65세 미만이면 아직 받을 수 없다. 위 금액은 65세가 된 뒤 같은 소득·재산일 때의 값이다.');
          }
          msgs.push('실제 수급 여부와 금액은 국민연금공단·주민센터의 소득·재산 조사와 A급여액 산정으로 결정된다. 무료임차소득·증여재산 등 이 계산기가 다루지 않는 항목이 있으면 달라진다.');
          warn.innerHTML = msgs.join('<br />');
          warn.hidden = msgs.length === 0;
        }

        // 금액 칸: 숫자만 남기고 천 단위 콤마
        root.querySelectorAll('[data-type="won"]').forEach(function (el) {
          el.addEventListener('input', function () {
            var raw = el.value.replace(/[^\d]/g, '').replace(/^0+(?=\d)/, '');
            el.value = raw ? raw.replace(/\B(?=(\d{3})+(?!\d))/g, ',') : '';
            calc();
          });
        });
