---
import Base from '../../layouts/Base.astro';
import { SITE, CATEGORIES } from '../../config/site';
import calc from '../../data/calcs/median-income.json';
import tools from '../../data/tools.json';

// 계산기 한 장 = JSON 한 장(src/data/calcs/<slug>.json). 이 페이지는 그 JSON을 읽어 그린다.
// 기준 중위소득·급여별 선정기준·기준선 목록은 JSON params(연도 키)에서만 온다. 코드에 숫자를 박지 않는다.
const cat = CATEGORIES[calc.cat as keyof typeof CATEGORIES];
const pageUrl = `${SITE.url}/tools/${calc.slug}`;
const byStep = (n: number) => calc.inputs.filter((i) => i.step === n);
const related = calc.related_calcs.map((r) => {
  const t = r.tool_no ? tools.find((x) => x.no === r.tool_no) : undefined;
  return { ...r, href: t?.href || r.href || '' };
});
const basisYear = calc.basis_date.slice(0, 4);
const P = calc.params as Record<string, unknown>;
const params = P[basisYear] as { lines: { pct: number; key?: string; label: string; src?: string }[] } & Record<string, unknown>;
const lines = params.lines;
const stepTitle = ['', '가구', '소득'];
const stepSub = ['', '가구원 수', '세전 가구 합산 월 소득'];
---

<Base title={calc.name} description={calc.description}>
  <div class="calc" data-calc>
    <header class="hero">
      <span class="eyebrow">모의계산기 · {cat.short}</span>
      <h1>{calc.name}</h1>
      <p class="lede">{calc.lede}</p>
      <div class="stamps">
        <span class="stamp gold"><b>{calc.basis_label}</b></span>
        <span class="stamp">확인일 <b>{calc.basis_date.replace(/-/g, '.')}</b></span>
        <span class="stamp">기준 <b>보건복지부고시 제2025-135호</b></span>
      </div>
    </header>

    <div class="cols">
      <div class="in">
        {[1, 2].map((n) => (
          <section class="card" id={`s${n}`}>
            <div class="card-h">
              <span class="num">STEP {n}</span>
              <h2>{stepTitle[n]}</h2>
              <p>{stepSub[n]}</p>
            </div>
            <div class="grid">
              {byStep(n).map((f) => (
                <div class="field">
                  <label for={`f-${f.id}`}>{f.label}{f.optional && <small> (선택)</small>}</label>
                  <div class="inp">
                    {f.type === 'select' ? (
                      <select id={`f-${f.id}`} data-in={f.id} data-type="select">
                        {(f.options || []).map((o) => <option value={o.value}>{o.label}</option>)}
                      </select>
                    ) : (
                      <input type="text" inputmode="numeric" id={`f-${f.id}`} data-in={f.id} data-type="won" placeholder="0" autocomplete="off" />
                    )}
                    {f.type === 'won' && <span class="unit">원</span>}
                  </div>
                  {f.help && <p class="sub">{f.help}</p>}
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="out">
        <section class="card result" id="result" aria-live="polite">
          <div class="card-h"><span class="num">결과</span><h2>중위소득 % 계산표</h2><p>{calc.basis_label}</p></div>
          <p class="answer" data-answer>가구원 수와 월 소득을 넣으면 기준 중위소득 대비 %가 나온다.</p>
          <div class="tbl-wrap">
            <table>
              <thead><tr><th>항목</th><th class="r">값</th><th class="f">산식</th></tr></thead>
              <tbody>
                {calc.steps.map((s) => (
                  <tr class={s.total ? 'total' : ''} data-row={s.id}>
                    <td><span class="no">({s.no})</span> {s.label}<small class="f2">{s.formula}</small></td>
                    <td class="r"><b data-val={s.id}>—</b></td>
                    <td class="f"><code>{s.formula}</code></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="hint" data-warn hidden></p>

          <div class="card-h lines-h"><span class="num">기준선</span><h2>어디까지 해당되나</h2><p>월 소득 ≤ 기준선 금액이면 ✓</p></div>
          <div class="tbl-wrap">
            <table class="lines">
              <thead><tr><th>비율</th><th class="r">금액</th><th class="c">해당</th></tr></thead>
              <tbody>
                {lines.map((l) => (
                  <tr data-line={l.pct}>
                    <td><b class="pct">{l.pct}%</b><small class="lbl">{l.label.replace(/^\d+% ?/, '')}</small></td>
                    <td class="r"><b data-line-amt={l.pct}>—</b></td>
                    <td class="c"><span class="mark" data-line-ok={l.pct}>—</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </div>

    <section class="card slim">
      <div class="card-h"><span class="num">관련</span><h2>같이 쓰는 계산기</h2></div>
      <div class="rel">
        {related.map((r) => r.href
          ? <a class="rel-btn" href={r.href}>{r.name}</a>
          : <span class="rel-btn off" aria-disabled="true">{r.name} <small>준비 중</small></span>)}
      </div>
      <div class="share" data-share data-url={pageUrl} data-title={`${calc.name} — ${SITE.name}`}>
        <span class="share-l">공유</span>
        <a class="share-btn" data-share-fb href="#" target="_blank" rel="noopener">페이스북</a>
        <a class="share-btn" data-share-x href="#" target="_blank" rel="noopener">X</a>
        <a class="share-btn" data-share-naver href="#" target="_blank" rel="noopener">네이버 블로그</a>
        <a class="share-btn" data-share-band href="#" target="_blank" rel="noopener">밴드</a>
      </div>
    </section>

    <div class="ad-slot" data-slot="in-article"></div>

    <section class="card slim">
      <div class="card-h"><span class="num">※</span><h2>산식과 근거</h2><p>확인일 {calc.basis_date.replace(/-/g, '.')}</p></div>
      <ol class="notes">
        {calc.notes.map((n) => <li>{n}</li>)}
      </ol>
      <p class="src">
        {calc.law.map((l) => <span>· <a href={l.url} target="_blank" rel="noopener">{l.name}</a> <em>{l.ver}</em><br /></span>)}
      </p>
    </section>

    <section class="card slim">
      <div class="card-h"><span class="num">이력</span><h2>기준값 이력</h2><p>바뀌면 줄이 늘어난다</p></div>
      <div class="tbl-wrap">
        <table class="hist">
          <thead><tr><th>날짜</th><th>기준값</th><th class="r">값</th><th>출처</th></tr></thead>
          <tbody>
            {calc.history.map((h) => (
              <tr><td>{h.date.replace(/-/g, '.')}</td><td><code>{h.param}</code></td><td class="r"><b>{h.value}</b></td><td>{h.src}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <p class="foot-note">{calc.disclaimer}<br />입력값은 이 브라우저 안에서만 계산되며 서버로 보내지 않는다.</p>
  </div>

  <script type="application/json" id="calc-params" set:html={JSON.stringify(params)} />
  <script is:inline>
    // 순수 JS. 입력이 바뀌면 즉시 다시 계산한다. 산식은 JSON steps.formula와 같은 순서.
    // % = 판정 소득 ÷ 가구 기준 중위소득 × 100. 기준선 금액은 고시 표 금액(32·40·48·50%) 또는 중위소득 × 비율(반올림).
    (function () {
      function init() {
        var root = document.querySelector('[data-calc]');
        if (!root || root.dataset.ready) return;
        root.dataset.ready = '1';
        var P = JSON.parse(document.getElementById('calc-params').textContent);

        var fmt = function (n) {
          if (n === null || n === undefined || isNaN(n)) return '—';
          return String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        };
        var won = function (n) { return n === null ? '—' : fmt(n) + '원'; };
        var num = function (el) { return Number((el.value || '').replace(/[^\d]/g, '')) || 0; };

        // 가구원 수별 고시 금액. 표에 없는 인원은 고시의 1인 증가분으로 늘린다.
        function byMembers(table, n, stepKey) {
          var keys = Object.keys(table).map(Number);
          var max = Math.max.apply(null, keys);
          if (n <= max) return table[String(n)];
          return table[String(max)] + P[stepKey] * (n - max);
        }
        function median(n) { return byMembers(P.median, n, 'median_step_over8'); }
        function lineAmount(line, n, med) {
          if (line.key === 'living') return byMembers(P.living, n, 'living_step_over8');
          if (line.key === 'medical') return byMembers(P.medical, n, 'medical_step_over8');
          if (line.key === 'housing') return byMembers(P.housing, n, 'housing_step_over7');
          if (line.key === 'education') return byMembers(P.education, n, 'education_step_over8');
          return Math.round(med * line.pct / 100);
        }

        var I = {};
        root.querySelectorAll('[data-in]').forEach(function (el) { I[el.dataset.in] = el; });
        var V = {};
        root.querySelectorAll('[data-val]').forEach(function (el) { V[el.dataset.val] = el; });
        var answer = root.querySelector('[data-answer]');
        var warn = root.querySelector('[data-warn]');
        var totalRow = root.querySelector('[data-row="ratio"]');
        var LA = {}, LO = {}, LR = {};
        root.querySelectorAll('[data-line-amt]').forEach(function (el) { LA[el.dataset.lineAmt] = el; });
        root.querySelectorAll('[data-line-ok]').forEach(function (el) { LO[el.dataset.lineOk] = el; });
        root.querySelectorAll('[data-line]').forEach(function (el) { LR[el.dataset.line] = el; });

        function set(id, text) { if (V[id]) V[id].textContent = text; }
        function calc() {
          var n = Number(I.members.value);
          var income = num(I.income), recognized = num(I.recognized);
          var useRec = I.recognized.value !== '' && recognized > 0;
          var base = useRec ? recognized : income;
          var filled = useRec || I.income.value !== '';
          var msgs = [];
          Object.keys(V).forEach(function (k) { set(k, '—'); });
          totalRow.classList.remove('bad');

          // (1) 가구 기준 중위소득 — 고시 금액 그대로 (8인 초과는 증가분)
          var med = median(n);
          set('median', won(med));
          if (n > 8) msgs.push(n + '인 가구 기준 중위소득 = 8인 ' + won(P.median['8']) + ' + ' + won(P.median_step_over8) + ' × ' + (n - 8) + ' (고시 8인 이상 증가분).');

          // 기준선 표 금액은 소득과 무관하게 항상 채운다
          P.lines.forEach(function (l) {
            var amt = lineAmount(l, n, med);
            LA[l.pct].textContent = won(amt);
            var row = LR[l.pct], ok = LO[l.pct];
            row.classList.remove('yes', 'no');
            if (!filled) { ok.textContent = '—'; return; }
            var hit = base <= amt;
            ok.textContent = hit ? '✓' : '✗';
            row.classList.add(hit ? 'yes' : 'no');
          });

          if (!filled) {
            answer.textContent = n + '인 가구 기준 중위소득은 ' + won(med) + '이다. 월 소득을 넣으면 몇 %인지 나온다.';
            warn.innerHTML = msgs.join('<br />'); warn.hidden = msgs.length === 0; return;
          }

          // (2) 판정 소득 (3) 비율
          set('income', won(base) + (useRec ? ' (소득인정액)' : ''));
          var ratio = base / med * 100;
          set('ratio', ratio.toFixed(1) + '%');
          answer.textContent = n + '인 가구 ' + (useRec ? '소득인정액 ' : '월 ') + won(base) + '은 기준 중위소득의 ' + ratio.toFixed(1) + '%다.';

          // 해당 구간: 소득 이하인 가장 낮은 기준선
          var first = null;
          for (var i = 0; i < P.lines.length; i++) {
            if (base <= lineAmount(P.lines[i], n, med)) { first = P.lines[i]; break; }
          }
          if (first) {
            msgs.push('기준 중위소득 ' + first.pct + '% 이하 기준선부터 해당한다' + (first.key ? ' (' + first.label + ' 금액 이하)' : '') + (first === P.lines[0] ? '. 표의 모든 기준선에 해당한다.' : '. 그 아래 비율의 기준선에는 해당하지 않는다.'));
          } else {
            var last = P.lines[P.lines.length - 1];
            msgs.push('기준 중위소득 ' + last.pct + '%를 넘어 이 표의 기준선에는 모두 해당하지 않는다.');
            totalRow.classList.add('bad');
          }
          if (useRec && I.income.value !== '') msgs.push('소득인정액을 넣었으므로 월 소득 ' + won(income) + ' 대신 소득인정액으로 판정했다.');
          msgs.push('✓는 월 소득이 그 기준선 금액 이하라는 뜻이다. 제도마다 소득인정액 산정(근로소득 공제·재산 환산·건강보험료 기준 등)이 달라 수급 여부는 각 제도 기준으로 판정한다.');
          warn.innerHTML = msgs.join('<br />');
          warn.hidden = msgs.length === 0;
        }

        // 금액 칸: 숫자만 남기고 천 단위 콤마
        root.querySelectorAll('[data-type="won"]').forEach(function (el) {
          el.addEventListener('input', function () {
            var raw = el.value.replace(/[^\d]/g, '').replace(/^0+(?=\d)/, '');
            el.value = raw ? raw.replace(/\B(?=(\d{3})+(?!\d))/g, ',') : '';
            calc();
          });
        });
        root.querySelectorAll('[data-type="select"]').forEach(function (el) {
          el.addEventListener('input', calc); el.addEventListener('change', calc);
        });

        // 공유 주소 (기획서 3번)
        var sh = root.querySelector('[data-share]');
        if (sh) {
          var u = encodeURIComponent(sh.dataset.url), t = encodeURIComponent(sh.dataset.title);
          sh.querySelector('[data-share-fb]').href = 'https://www.facebook.com/sharer/sharer.php?u=' + u;
          sh.querySelector('[data-share-x]').href = 'https://twitter.com/intent/tweet?url=' + u + '&text=' + t;
          sh.querySelector('[data-share-naver]').href = 'https://share.naver.com/web/shareView?url=' + u + '&title=' + t;
          sh.querySelector('[data-share-band]').href = 'https://band.us/plugin/share?body=' + t + '%20' + u + '&route=' + u;
        }
        calc();
      }
      document.addEventListener('astro:page-load', init);
      if (document.readyState !== 'loading') init(); else document.addEventListener('DOMContentLoaded', init);
    })();
  </script>
</Base>

<style>
  /* 계산기 무드: 생계급여 계산기(living-benefit.astro)와 같은 유리 카드·금색 강조 토큰을 이 페이지 안에서만 정의 */
  .calc {
    --gold: #f5b544; --gold-ink: #ffd27a; --gold-soft: rgba(245, 181, 68, .12);
    --rose: #ff6b7a; --rose-soft: rgba(255, 107, 122, .12);
    --green: #35c48a; --green-soft: rgba(53, 196, 138, .12);
    --hair-2: rgba(255, 255, 255, .14);
    --glass: rgba(18, 24, 38, .66); --glass-2: rgba(22, 28, 44, .55);
    --field: rgba(9, 12, 22, .55);
    --cshadow: 0 24px 60px -20px rgba(0, 0, 0, .6), 0 8px 18px -8px rgba(0, 0, 0, .4), inset 0 1px 0 rgba(255, 255, 255, .08);
    --r-sm: 12px;
    max-width: 920px; margin: 0 auto; font-size: 15.5px; letter-spacing: -.01em;
  }
  :global(:root[data-theme='light']) .calc {
    --gold: #c98a12; --gold-ink: #a86f0a; --gold-soft: rgba(201, 138, 18, .10);
    --rose: #e0475a; --rose-soft: rgba(224, 71, 90, .10);
    --green: #177a53; --green-soft: rgba(23, 122, 83, .10);
    --hair-2: #d3d8e0; --glass: rgba(255, 255, 255, .78); --glass-2: rgba(255, 255, 255, .6); --field: rgba(255, 255, 255, .85);
    --cshadow: 0 24px 60px -24px rgba(25, 31, 40, .18), 0 6px 14px -8px rgba(25, 31, 40, .12), inset 0 1px 0 rgba(255, 255, 255, .9);
  }

  .hero { padding: 54px 0 26px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 700; color: var(--gold); letter-spacing: .02em; text-transform: uppercase; }
  .eyebrow::before { content: ''; width: 22px; height: 1px; background: var(--gold); }
  h1 { font-size: clamp(30px, 4.6vw, 44px); line-height: 1.15; letter-spacing: -.035em; margin: 12px 0 14px; font-weight: 800; }
  .lede { color: var(--ink-2); font-size: 16px; max-width: 640px; margin: 0; line-height: 1.6; }
  .stamps { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
  .stamp { font-size: 12.5px; padding: 7px 12px; border-radius: 99px; border: 1px solid var(--hair-2); color: var(--ink-2); background: var(--glass-2); backdrop-filter: blur(8px); }
  .stamp b { color: var(--ink); font-weight: 700; }
  .stamp.gold { border-color: color-mix(in srgb, var(--gold) 45%, transparent); color: var(--gold-ink); background: var(--gold-soft); }

  .cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0 18px; align-items: start; }
  .out { position: sticky; top: 76px; }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr; } .out { position: static; } }

  .card { position: relative; background: var(--glass); border: 1px solid var(--hair-2); border-radius: var(--r); box-shadow: var(--cshadow); backdrop-filter: blur(22px) saturate(170%); -webkit-backdrop-filter: blur(22px) saturate(170%); padding: 24px 24px 22px; margin: 18px 0; }
  .card::before { content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; background: radial-gradient(circle at 50% -10%, rgba(255, 255, 255, .14), transparent 60%); mix-blend-mode: overlay; }
  :global(:root[data-theme='light']) .card::before { display: none; }
  .card-h { display: flex; align-items: baseline; gap: 14px; margin-bottom: 16px; flex-wrap: wrap; }
  .num { font-size: 12px; font-weight: 800; color: var(--gold); letter-spacing: .06em; }
  .card-h h2 { font-size: 19px; margin: 0; font-weight: 800; letter-spacing: -.02em; }
  .card-h p { margin: 0 0 0 auto; font-size: 13px; color: var(--ink-3); }
  .lines-h { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--hair); }
  .lines-h h2 { font-size: 16px; }
  .hint { font-size: 13px; color: var(--ink-2); margin: 12px 0 0; line-height: 1.6; padding: 12px 14px; border-radius: 12px; background: var(--gold-soft); border: 1px solid color-mix(in srgb, var(--gold) 35%, transparent); }
  .hint[hidden] { display: none; }

  .grid { display: grid; gap: 14px 18px; grid-template-columns: 1fr; }
  .field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .field > label { font-size: 13.5px; font-weight: 600; color: var(--ink-2); }
  .field label small { font-weight: 500; color: var(--ink-3); }
  .inp { position: relative; }
  .inp input, .inp select { width: 100%; height: 46px; padding: 0 14px; border-radius: var(--r-sm); border: 1px solid var(--hair-2); background: var(--field); color: var(--ink); font: inherit; font-size: 16px; font-weight: 600; letter-spacing: -.01em; outline: none; transition: border-color .15s, box-shadow .15s; }
  .inp select { appearance: none; -webkit-appearance: none; padding-right: 40px; cursor: pointer; }
  .inp select option { color: #191f28; background: #fff; }
  .inp:has(select)::after { content: ''; position: absolute; right: 16px; top: 50%; width: 8px; height: 8px; border-right: 2px solid var(--ink-3); border-bottom: 2px solid var(--ink-3); transform: translateY(-70%) rotate(45deg); pointer-events: none; }
  .inp input[data-type='won'] { text-align: right; padding-right: 40px; }
  .inp input:focus, .inp select:focus { border-color: var(--gold); box-shadow: 0 0 0 3px var(--gold-soft); }
  .inp input::placeholder { color: var(--ink-3); font-weight: 400; }
  .inp .unit { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); font-size: 13px; color: var(--ink-3); pointer-events: none; }
  .sub { font-size: 12.5px; color: var(--ink-3); margin: 0; line-height: 1.5; }

  /* 결과표: 항목 | 값 | 산식 (모바일은 산식 열을 숨기고 항목 밑에 작게) */
  .answer { margin: 0 0 14px; font-size: clamp(19px, 2.6vw, 24px); font-weight: 800; letter-spacing: -.03em; line-height: 1.3; background: linear-gradient(100deg, var(--ink) 0%, var(--ink) 55%, var(--gold-ink)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .tbl-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
