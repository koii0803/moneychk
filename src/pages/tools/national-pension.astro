---
import Base from '../../layouts/Base.astro';
import CalcDock from '../../components/CalcDock.astro';
import { SITE, CATEGORIES } from '../../config/site';
import calc from '../../data/calcs/national-pension.json';
import tools from '../../data/tools.json';

// 계산기 한 장 = JSON 한 장(src/data/calcs/<slug>.json). 이 페이지는 그 JSON을 읽어 그린다.
// 산식·A값·상수는 JSON params(연도 키)에서만 온다. 코드에 숫자를 박지 않는다.
const cat = CATEGORIES[calc.cat as keyof typeof CATEGORIES];
const pageUrl = `${SITE.url}/tools/${calc.slug}`;
// 구조화 데이터: 이 페이지가 "무료 웹 계산기"라는 것과 사이트 안 위치를 구글에 알려 준다.
// 계산기용 리치결과는 구글에 없다 — 엔티티 이해·사이트링크·빵부스러기 경로에 쓰인다.
const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: calc.name,
    url: pageUrl,
    description: calc.description,
    applicationCategory: 'FinanceApplication',
    applicationSubCategory: '모의계산기',
    operatingSystem: 'All',
    browserRequirements: 'JavaScript',
    inLanguage: 'ko',
    isAccessibleForFree: true,
    dateModified: calc.basis_date,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    ...(calc.keyword ? { keywords: calc.keyword } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: SITE.url },
      { '@type': 'ListItem', position: 2, name: '모의계산기', item: `${SITE.url}/tools` },
      { '@type': 'ListItem', position: 3, name: calc.name, item: pageUrl },
    ],
  },
]);
const byStep = (n: number) => calc.inputs.filter((i) => i.step === n);
const related = calc.related_calcs.map((r) => {
  const t = r.tool_no ? tools.find((x) => x.no === r.tool_no) : undefined;
  return { ...r, href: t?.href || '' };
});
const basisYear = calc.basis_date.slice(0, 4);
const P = calc.params as Record<string, unknown>;
const params = P[basisYear] as Record<string, unknown>;
const firstYear = Number(params.first_year), baseYear = Number(params.base_year);
// 첫 가입 연도 선택지: 비움(2026년 상수만) + 1988~2025
const startYears = Array.from({ length: baseYear - firstYear }, (_, i) => firstYear + i);
const optionsOf = (f: (typeof calc.inputs)[number]) =>
  f.id === 'start_year'
    ? [{ value: '', label: `비움 — 전 기간 ${baseYear}년 상수 ${params.const_current} 적용` }, ...startYears.map((y) => ({ value: String(y), label: `${y}년` }))]
    : f.options || [];
const stepTitle = ['', '출생·나이', '소득·가입기간', '수령 시점'];
const stepSub = ['', '수급 개시 연령', '현재가치 기준', '정상·조기·연기'];
---

<Base title={calc.name} description={calc.description}>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />
  <div class="calc" data-calc>
    <header class="hero">
      <span class="eyebrow">모의계산기 · {cat.short}</span>
      <h1>{calc.name}</h1>
      <p class="lede">{calc.lede}</p>
      <div class="stamps">
        <span class="stamp gold"><b>{calc.basis_label}</b></span>
        <span class="stamp">확인일 <b>{calc.basis_date.replace(/-/g, '.')}</b></span>
        <span class="stamp">산식 <b>국민연금법 제51조 · 공단 예상연금월액표</b></span>
      </div>
    </header>

    <div class="cols">
      <div class="in">
        {[1, 2, 3].map((n) => (
          <section class="card" id={`s${n}`}>
            <div class="card-h">
              <span class="num">STEP {n}</span>
              <h2>{stepTitle[n]}</h2>
              <p>{stepSub[n]}</p>
            </div>
            <div class={`grid${n === 1 ? ' two' : ''}`}>
              {byStep(n).map((f) => (
                <div class="field">
                  <label for={`f-${f.id}`}>{f.label}{f.optional && <small> (선택)</small>}</label>
                  <div class="inp">
                    {f.type === 'select' ? (
                      <select id={`f-${f.id}`} data-in={f.id} data-type="select">
                        {optionsOf(f).map((o) => <option value={o.value}>{o.label}</option>)}
                      </select>
                    ) : f.type === 'won' ? (
                      <input type="text" inputmode="numeric" id={`f-${f.id}`} data-in={f.id} data-type="won" placeholder="0" autocomplete="off" />
                    ) : (
                      <input type="text" inputmode="numeric" id={`f-${f.id}`} data-in={f.id} data-type="int" placeholder={f.type === 'year' ? '예: 1980' : '0'} maxlength={f.type === 'year' ? 4 : 3} autocomplete="off" />
                    )}
                    {f.type === 'won' && <span class="unit">원</span>}
                    {f.type === 'year' && <span class="unit">년</span>}
                    {f.type === 'int' && <span class="unit">{f.id === 'months' ? '개월' : '세'}</span>}
                  </div>
                  {f.help && <p class="sub">{f.help}</p>}
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="out">
        <section class="card result" id="result" aria-live="polite">
          <div class="card-h"><span class="num">결과</span><h2>예상 연금 계산표</h2><p>{calc.basis_label}</p></div>
          <p class="answer" data-answer>출생연도·평균 소득월액·총 가입 개월을 넣으면 월 예상 연금액이 나온다.</p>
          <div class="tbl-wrap">
            <table>
              <thead><tr><th>항목</th><th class="r">값</th><th class="f">산식</th></tr></thead>
              <tbody>
                {calc.steps.map((s) => (
                  <tr class={s.total ? 'total' : ''} data-row={s.id}>
                    <td><span class="no">({s.no})</span> {s.label}<small class="f2">{s.formula}</small></td>
                    <td class="r"><b data-val={s.id}>—</b></td>
                    <td class="f"><code>{s.formula}</code></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="basis-note">현재가치 기준, 물가 상승 반영 전. 부양가족연금·크레딧·세금 제외.</p>
          <p class="hint" data-warn hidden></p>
        </section>
      </div>
    </div>

    <section class="card slim">
      <div class="card-h"><span class="num">관련</span><h2>같이 쓰는 계산기</h2></div>
      <div class="rel">
        {related.map((r) => r.href
          ? <a class="rel-btn" href={r.href}>{r.name}</a>
          : <span class="rel-btn off" aria-disabled="true">{r.name} <small>준비 중</small></span>)}
      </div>
      <div class="share" data-share data-url={pageUrl} data-title={`${calc.name} — ${SITE.name}`}>
        <span class="share-l">공유</span>
        <a class="share-btn" data-share-fb href="#" target="_blank" rel="noopener">페이스북</a>
        <a class="share-btn" data-share-x href="#" target="_blank" rel="noopener">X</a>
        <a class="share-btn" data-share-naver href="#" target="_blank" rel="noopener">네이버 블로그</a>
        <a class="share-btn" data-share-band href="#" target="_blank" rel="noopener">밴드</a>
      </div>
    </section>

    <div class="ad-slot" data-slot="in-article"></div>

    <section class="card slim">
      <div class="card-h"><span class="num">※</span><h2>산식과 근거</h2><p>확인일 {calc.basis_date.replace(/-/g, '.')}</p></div>
      <ol class="notes">
        {calc.notes.map((n) => <li>{n}</li>)}
      </ol>
      <p class="src">
        {calc.law.map((l) => <span>· <a href={l.url} target="_blank" rel="noopener">{l.name}</a> <em>{l.ver}</em><br /></span>)}
      </p>
    </section>

    <section class="card slim hist-card">
      <div class="card-h"><span class="num">이력</span><h2>기준값 이력</h2><p>바뀌면 줄이 늘어난다</p></div>
      <div class="tbl-wrap">
        <table class="hist">
          <thead><tr><th>날짜</th><th>기준값</th><th class="r">값</th><th>출처</th></tr></thead>
          <tbody>
            {calc.history.map((h) => (
              <tr><td>{h.date.replace(/-/g, '.')}</td><td><code>{h.param}</code></td><td class="r"><b>{h.value}</b></td><td>{h.src}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <p class="foot-note">{calc.disclaimer}<br />입력값은 이 브라우저 안에서만 계산되며 서버로 보내지 않는다.</p>
  </div>

  <script type="application/json" id="calc-params" set:html={JSON.stringify(params)} />
  <script is:inline>
    // 순수 JS. 입력이 바뀌면 즉시 다시 계산한다. 산식은 JSON steps.formula와 같은 순서.
    // 기본연금액 = Σ[상수_i × (A + w_i·B) × P_i/P] × (1 + 0.05 × 20년 초과월수/12)  (국민연금법 제51조, 공단 급여의 산정)
    (function () {
      function init() {
        var root = document.querySelector('[data-calc]');
        if (!root || root.dataset.ready) return;
        root.dataset.ready = '1';
        var P = JSON.parse(document.getElementById('calc-params').textContent);

        var fmt = function (n) {
          if (n === null || n === undefined || isNaN(n)) return '—';
          return String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        };
        var won = function (n) { return n === null ? '—' : fmt(n) + '원'; };
        var pct = function (n) { return String(Math.round(n * 1000) / 10) + '%'; };
        var num = function (el) { return Number((el.value || '').replace(/[^\d]/g, '')) || 0; };
        var cut = function (n) { return Math.floor(n / P.round_unit) * P.round_unit; };
        var r3 = function (n) { return Math.round(n * 1000) / 1000; };

        var I = {};
        root.querySelectorAll('[data-in]').forEach(function (el) { I[el.dataset.in] = el; });
        var V = {};
        root.querySelectorAll('[data-val]').forEach(function (el) { V[el.dataset.val] = el; });
        var answer = root.querySelector('[data-answer]');
        var warn = root.querySelector('[data-warn]');
        var totalRow = root.querySelector('[data-row="monthly"]');

        function set(id, text) { if (V[id]) V[id].textContent = text; }
        function set2(id, text, sub) { if (!V[id]) return; V[id].textContent = text; var sm = document.createElement('small'); sm.textContent = sub; V[id].appendChild(sm); }
        // 출생연도 → 수급 개시 연령 (부칙 제8조)
        function startAge(y) {
          for (var i = 0; i < P.start_age.length; i++) if (y <= P.start_age[i].to) return P.start_age[i].age;
          return P.start_age[P.start_age.length - 1].age;
        }
        // 연도별 비례상수·B 가중치 (공단 급여의 산정 표)
        function constOf(y) {
          for (var i = 0; i < P.const_periods.length; i++) {
            var c = P.const_periods[i];
            if (y >= c.from && y <= c.to) return { k: c.const !== undefined ? c.const : r3(c.const_start + c.const_step * (y - c.from)), w: c.b_weight };
          }
          return { k: P.const_current, w: 1 };
        }
        // 첫 가입 연도부터 개월을 순서대로 나눠 Σ 상수×(A+wB)×P_i/P
        function weighted(startYear, months, A, B) {
          if (!startYear) return { sum: P.const_current * (A + B), k: P.const_current, mixed: false };
          var left = months, y = startYear, sum = 0, kw = 0;
          while (left > 0) {
            var m = Math.min(12, left), c = constOf(y);
            sum += c.k * (A + c.w * B) * m / months;
            kw += c.k * m / months;
            left -= m; y++;
          }
          return { sum: sum, k: kw, mixed: true, endYear: y - 1 };
        }

        function calc() {
          var by = num(I.birth_year), ageIn = num(I.age_now);
          var bIn = num(I.b_value), months = num(I.months);
          var sy = Number(I.start_year.value) || 0;
          var shift = Number(I.timing.value) || 0;
          var msgs = [];
          Object.keys(V).forEach(function (k) { set(k, '—'); });
          totalRow.classList.remove('bad');
          set('a_value', won(P.a_value));

          if (!by || by < 1900 || by > P.base_year) {
            answer.textContent = '출생연도·평균 소득월액·총 가입 개월을 넣으면 월 예상 연금액이 나온다.';
            warn.hidden = true; return;
          }
          var age0 = startAge(by);
          var ageNow = ageIn || (P.base_year - by);
          var claimAge = age0 + shift;
          set2('start_age', age0 + '세', by + '년생' + (shift ? ' · ' + claimAge + '세부터 수령' : ''));
          if (!bIn || !months) {
            answer.textContent = '수급 개시 연령은 ' + age0 + '세다. 평균 소득월액과 총 가입 개월을 넣으면 월 예상액이 나온다.';
            warn.hidden = true; return;
          }

          // (3) B값 상·하한
          var B = Math.min(Math.max(bIn, P.b_min), P.b_max);
          var bTag = bIn < P.b_min ? ' (하한 적용)' : bIn > P.b_max ? ' (상한 적용)' : '';
          set('b_value', won(B) + bTag);
          var A = P.a_value;

          // 10년 미만: 반환일시금
          if (months < P.min_months) {
            set('basic', '—'); set('rate', '—'); set('normal', '—'); set('adjust', '—');
            set('monthly', '연금 대상 아님');
            totalRow.classList.add('bad');
            answer.textContent = '가입기간 ' + fmt(months) + '개월 — 10년(' + P.min_months + '개월) 미만이라 노령연금이 아니라 반환일시금 대상이다.';
            msgs.push('가입기간이 10년 미만이면 60세에 낸 보험료에 이자를 더한 반환일시금을 받는다 (국민연금법 제77조 제1항). 액수는 공단 조회로 확인한다. 임의계속가입·추납으로 120개월을 채우면 연금으로 받을 수 있다.');
            msgs.push('참고: 120개월을 채우면 월 ' + won(cut(Math.min(P.const_current * (A + B) / 12 * P.rate_at_10y, B))) + '부터다 (2026년 상수, 지급률 50%).');
            warn.innerHTML = msgs.join('<br />'); warn.hidden = false; return;
          }

          // (4) 기본연금액(연)
          var w = weighted(sy, months, A, B);
          var over = Math.max(0, months - 240);
          var bonus = 1 + P.over20_rate_per_year * over / 12;
          var basic = w.sum * bonus;
          set2('basic', won(basic), '상수 ' + (w.mixed ? '가중 ' + (Math.round(w.k * 1000) / 1000) : P.const_current) + ' × (A+B)' + (over ? ' × (1 + ' + pct(bonus - 1) + ')' : '') + (over ? ' · 20년 초과 ' + over + '개월' : ''));
          // (5) 지급률
          var rate = months >= 240 ? 1 : Math.min(1, P.rate_at_10y + P.rate_per_year_10to20 * (months - P.min_months) / 12);
          set('rate', pct(rate));
          // (6) 정상 수령 월액 (최고한도 B값, 10원 절사)
          var rawNormal = basic * rate / 12;
          var capped = rawNormal > B;
          var normal = cut(Math.min(rawNormal, B));
          set2('normal', won(normal), '연 ' + won(basic * rate) + ' ÷ 12' + (capped ? ' → 한도 B값 적용' : ''));
          // (7) 조기·연기
          var adj = shift < 0 ? -P.early_rate_per_month * (-shift * 12) : shift > 0 ? P.delay_rate_per_month * (shift * 12) : 0;
          set2('adjust', (adj > 0 ? '+' : '') + pct(adj), shift ? Math.abs(shift) + '년 = ' + Math.abs(shift) * 12 + '개월 × ' + (shift < 0 ? '−' + pct(P.early_rate_per_month) : '+' + pct(P.delay_rate_per_month)) : '정상 수령');
          // (8) 월 예상액 — 최고한도(제53조)는 조기 감액·연기 가산까지 끝난 월지급액에 건다
          var adjusted = rawNormal * (1 + adj);
          var cappedFinal = adjusted > B;
          var monthly = cut(Math.min(adjusted, B));
          set('monthly', won(monthly));

          answer.textContent = claimAge + '세부터 받는 월 예상 연금액은 ' + won(monthly) + '이다 (현재가치 기준, 물가 상승 반영 전).';

          var yearsLeft = claimAge - ageNow;
          if (yearsLeft > 0) msgs.push('현재 ' + ageNow + '세 기준으로 수령 시작까지 ' + yearsLeft + '년 남았다. 그동안 A값·재평가율이 바뀌면 실제 금액은 달라진다.');
          else msgs.push('현재 ' + ageNow + '세로 이미 수령 시점(' + claimAge + '세)이 지났다. 공단에 청구 이력이 있으면 그 결정액이 우선한다.');
          if (w.mixed) msgs.push(sy + '년부터 ' + w.endYear + '년까지 ' + fmt(months) + '개월을 연도별 상수로 나눠 가중 상수 ' + (Math.round(w.k * 1000) / 1000) + '을 적용했다. 2026년 1월 1일 전 가입기간은 종전 상수로 계산한다 (부칙 제5조 제2항).');
          else msgs.push('전 기간에 2026년 상수 ' + P.const_current + '(소득대체율 ' + P.replacement_rate_current + '%)을 적용했다. 2025년 이전 가입기간이 있으면 「첫 가입 연도」를 넣어야 상수 1.245~2.4가 반영된다.');
          if (shift < 0) msgs.push('조기노령연금은 소득 있는 업무(월 소득이 A값 ' + won(A) + ' 초과)에 종사하면 받을 수 없고, 한 번 감액된 비율은 평생 간다 (제61조 제2항, 제63조 제2항).');
          if (shift > 0) msgs.push('연기 기간에는 연금이 나오지 않는다. 가산율은 연기 신청 당시 연금액에 붙는다 (제62조 제2항).');
          if (cappedFinal) msgs.push('계산된 월액 ' + won(cut(adjusted)) + '이 B값보다 커서 연금액 최고한도인 B값 ' + won(B) + '으로 막았다 (제53조). 최고한도는 조기 감액·연기 가산까지 끝난 월지급액에 건다.');
          else if (capped) msgs.push('정상 수령 기준 월액 ' + won(cut(rawNormal)) + '은 B값을 넘지만, 조기 감액을 반영한 실제 월지급액은 한도 안이라 그대로 나온다 (제53조).');
          if (bIn < P.b_min) msgs.push('B값은 기준소득월액 하한 ' + won(P.b_min) + '으로 계산했다 (' + P.b_period + ' 적용).');
          if (bIn > P.b_max) msgs.push('B값은 기준소득월액 상한 ' + won(P.b_max) + '으로 계산했다 (' + P.b_period + ' 적용). 소득이 그 이상이어도 연금은 같다.');
          warn.innerHTML = msgs.join('<br />');
          warn.hidden = msgs.length === 0;
        }

        // 금액 칸: 숫자만 남기고 천 단위 콤마
        root.querySelectorAll('[data-type="won"]').forEach(function (el) {
          el.addEventListener('input', function () {
            var raw = el.value.replace(/[^\d]/g, '').replace(/^0+(?=\d)/, '');
            el.value = raw ? raw.replace(/\B(?=(\d{3})+(?!\d))/g, ',') : '';
            calc();
          });
        });
        // 연도·나이·개월 칸: 숫자만
        root.querySelectorAll('[data-type="int"]').forEach(function (el) {
          el.addEventListener('input', function () {
            el.value = el.value.replace(/[^\d]/g, '');
            calc();
          });
        });
        root.querySelectorAll('[data-type="select"]').forEach(function (el) {
          el.addEventListener('input', calc); el.addEventListener('change', calc);
        });

        // 공유 주소 (기획서 3번)
        var sh = root.querySelector('[data-share]');
        if (sh) {
          var u = encodeURIComponent(sh.dataset.url), t = encodeURIComponent(sh.dataset.title);
          sh.querySelector('[data-share-fb]').href = 'https://www.facebook.com/sharer/sharer.php?u=' + u;
          sh.querySelector('[data-share-x]').href = 'https://twitter.com/intent/tweet?url=' + u + '&text=' + t;
          sh.querySelector('[data-share-naver]').href = 'https://share.naver.com/web/shareView?url=' + u + '&title=' + t;
          sh.querySelector('[data-share-band]').href = 'https://band.us/plugin/share?body=' + t + '%20' + u + '&route=' + u;
        }
        calc();
      }
      document.addEventListener('astro:page-load', init);
      if (document.readyState !== 'loading') init(); else document.addEventListener('DOMContentLoaded', init);
    })();
  </script>

  <CalcDock />
</Base>

