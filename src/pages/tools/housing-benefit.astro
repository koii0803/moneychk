---
import Base from '../../layouts/Base.astro';
import CalcDock from '../../components/CalcDock.astro';
import { SITE, CATEGORIES } from '../../config/site';
import calc from '../../data/calcs/housing-benefit.json';
import tools from '../../data/tools.json';

// 계산기 한 장 = JSON 한 장(src/data/calcs/<slug>.json). 이 페이지는 그 JSON을 읽어 그린다.
// 선정기준(48%)·기준임대료·생계급여 선정기준(32%)·자기부담률·보증금 환산율은 JSON params(연도 키)에서만 온다. 코드에 숫자를 박지 않는다.
const cat = CATEGORIES[calc.cat as keyof typeof CATEGORIES];
const pageUrl = `${SITE.url}/tools/${calc.slug}`;
// 구조화 데이터: 이 페이지가 "무료 웹 계산기"라는 것과 사이트 안 위치를 구글에 알려 준다.
// 계산기용 리치결과는 구글에 없다 — 엔티티 이해·사이트링크·빵부스러기 경로에 쓰인다.
const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: calc.name,
    url: pageUrl,
    description: calc.description,
    applicationCategory: 'FinanceApplication',
    applicationSubCategory: '모의계산기',
    operatingSystem: 'All',
    browserRequirements: 'JavaScript',
    inLanguage: 'ko',
    isAccessibleForFree: true,
    dateModified: calc.basis_date,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    ...(calc.keyword ? { keywords: calc.keyword } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: SITE.url },
      { '@type': 'ListItem', position: 2, name: '모의계산기', item: `${SITE.url}/tools` },
      { '@type': 'ListItem', position: 3, name: calc.name, item: pageUrl },
    ],
  },
]);
const byStep = (n: number) => calc.inputs.filter((i) => i.step === n);
const related = calc.related_calcs.map((r) => {
  const t = r.tool_no ? tools.find((x) => x.no === r.tool_no) : undefined;
  return { ...r, href: t?.href || r.href || '' };
});
const basisYear = calc.basis_date.slice(0, 4);
const P = calc.params as Record<string, unknown>;
const params = P[basisYear] as Record<string, unknown>;
const stepTitle = ['', '가구·지역', '임차료', '소득인정액'];
const stepSub = ['', '가구원 수·급지', '계약서의 월세·보증금', '직접 입력·자가 여부'];
---

<Base title={calc.name} description={calc.description}>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />
  <div class="calc" data-calc>
    <header class="hero">
      <span class="eyebrow">모의계산기 · {cat.short}</span>
      <h1>{calc.name}</h1>
      <p class="lede">{calc.lede}</p>
      <div class="stamps">
        <span class="stamp gold"><b>{calc.basis_label}</b></span>
        <span class="stamp">확인일 <b>{calc.basis_date.replace(/-/g, '.')}</b></span>
        <span class="stamp">기준 <b>국토교통부고시 제2025-506호</b></span>
      </div>
    </header>

    <div class="cols">
      <div class="in">
        {[1, 2, 3].map((n) => (
          <section class="card" id={`s${n}`}>
            <div class="card-h">
              <span class="num">STEP {n}</span>
              <h2>{stepTitle[n]}</h2>
              <p>{stepSub[n]}</p>
            </div>
            <div class={`grid${n === 1 ? ' two' : ''}`}>
              {byStep(n).map((f) => (
                <div class="field">
                  {f.type === 'check' ? (
                    <label class="toggle">
                      <input type="checkbox" id={`f-${f.id}`} data-in={f.id} data-type="check" />
                      <span>{f.label}<small>{f.help}</small></span>
                    </label>
                  ) : (
                    <>
                      <label for={`f-${f.id}`}>{f.label}{f.optional && <small> (선택)</small>}</label>
                      <div class="inp">
                        {f.type === 'select' ? (
                          <select id={`f-${f.id}`} data-in={f.id} data-type="select">
                            {(f.options || []).map((o) => <option value={o.value}>{o.label}</option>)}
                          </select>
                        ) : (
                          <input type="text" inputmode="numeric" id={`f-${f.id}`} data-in={f.id} data-type="won" placeholder="0" autocomplete="off" />
                        )}
                        {f.type === 'won' && <span class="unit">원</span>}
                      </div>
                      {f.help && <p class="sub">{f.help}</p>}
                    </>
                  )}
                </div>
              ))}
            </div>
            {n === 3 && (
              <p class="sub link">소득인정액을 모르면 <a href="/tools/living-benefit">생계급여 계산기</a>의 「소득·재산으로 간이 환산」으로 어림한 값을 넣는다.</p>
            )}
          </section>
        ))}
      </div>

      <div class="out">
        <section class="card result" id="result" aria-live="polite">
          <div class="card-h"><span class="num">결과</span><h2>주거급여 계산표</h2><p>{calc.basis_label}</p></div>
          <p class="answer" data-answer>가구원 수·지역·월세·소득인정액을 넣으면 월 임차급여액이 나온다.</p>
          <div class="tbl-wrap">
            <table>
              <thead><tr><th>항목</th><th class="r">금액</th><th class="f">산식</th></tr></thead>
              <tbody>
                {calc.steps.map((s) => (
                  <tr class={s.total ? 'total' : ''} data-row={s.id}>
                    <td><span class="no">({s.no})</span> {s.label}<small class="f2">{s.formula}</small></td>
                    <td class="r"><b data-val={s.id}>—</b></td>
                    <td class="f"><code>{s.formula}</code></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="hint" data-warn hidden></p>
        </section>
      </div>
    </div>

    <section class="card slim">
      <div class="card-h"><span class="num">관련</span><h2>같이 쓰는 계산기</h2></div>
      <div class="rel">
        {related.map((r) => r.href
          ? <a class="rel-btn" href={r.href}>{r.name}</a>
          : <span class="rel-btn off" aria-disabled="true">{r.name} <small>준비 중</small></span>)}
      </div>
      <div class="share" data-share data-url={pageUrl} data-title={`${calc.name} — ${SITE.name}`}>
        <span class="share-l">공유</span>
        <a class="share-btn" data-share-fb href="#" target="_blank" rel="noopener">페이스북</a>
        <a class="share-btn" data-share-x href="#" target="_blank" rel="noopener">X</a>
        <a class="share-btn" data-share-naver href="#" target="_blank" rel="noopener">네이버 블로그</a>
        <a class="share-btn" data-share-band href="#" target="_blank" rel="noopener">밴드</a>
      </div>
    </section>

    <div class="ad-slot" data-slot="in-article"></div>

    <section class="card slim">
      <div class="card-h"><span class="num">※</span><h2>산식과 근거</h2><p>확인일 {calc.basis_date.replace(/-/g, '.')}</p></div>
      <ol class="notes">
        {calc.notes.map((n) => <li>{n}</li>)}
      </ol>
      <p class="src">
        {calc.law.map((l) => <span>· <a href={l.url} target="_blank" rel="noopener">{l.name}</a> <em>{l.ver}</em><br /></span>)}
      </p>
    </section>

    <section class="card slim hist-card">
      <div class="card-h"><span class="num">이력</span><h2>기준값 이력</h2><p>바뀌면 줄이 늘어난다</p></div>
      <div class="tbl-wrap">
        <table class="hist">
          <thead><tr><th>날짜</th><th>기준값</th><th class="r">값</th><th>출처</th></tr></thead>
          <tbody>
            {calc.history.map((h) => (
              <tr><td>{h.date.replace(/-/g, '.')}</td><td><code>{h.param}</code></td><td class="r"><b>{h.value}</b></td><td>{h.src}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <p class="foot-note">{calc.disclaimer}<br />입력값은 이 브라우저 안에서만 계산되며 서버로 보내지 않는다.</p>
  </div>

  <script type="application/json" id="calc-params" set:html={JSON.stringify(params)} />
  <script is:inline>
    // 순수 JS. 입력이 바뀌면 즉시 다시 계산한다. 산식은 JSON steps.formula와 같은 순서.
    // 「주거급여 실시에 관한 고시」 제7조: 적용 임차료 = min(기준임대료, 실제임차료), 자기부담분 = (소득인정액 − 생계급여 선정기준) × 30%.
    (function () {
      function init() {
        var root = document.querySelector('[data-calc]');
        if (!root || root.dataset.ready) return;
        root.dataset.ready = '1';
        var P = JSON.parse(document.getElementById('calc-params').textContent);

        var fmt = function (n) {
          if (n === null || n === undefined || isNaN(n)) return '—';
          return String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        };
        var won = function (n) { return n === null ? '—' : fmt(n) + '원'; };
        var num = function (el) { return Number((el.value || '').replace(/[^\d]/g, '')) || 0; };

        var I = {};
        root.querySelectorAll('[data-in]').forEach(function (el) { I[el.dataset.in] = el; });
        var V = {};
        root.querySelectorAll('[data-val]').forEach(function (el) { V[el.dataset.val] = el; });
        var answer = root.querySelector('[data-answer]');
        var warn = root.querySelector('[data-warn]');
        var totalRow = root.querySelector('[data-row="benefit"]');
        var eligRow = root.querySelector('[data-row="eligible"]');
        var zoneName = { '1': '1급지 서울', '2': '2급지 경기·인천', '3': '3급지 광역시·세종·특례시', '4': '4급지' };

        function set(id, text) { if (V[id]) V[id].textContent = text; }
        // 기준임대료: 1~6인 표, 7인 = 6인 × 100%, 8~9인 = 6인 × 110% (고시 제2025-506호 표 주석)
        function baseRent(zone, n) {
          var row = P.base_rent[zone];
          if (n <= 6) return row[String(n)];
          var ratio = n === 7 ? P.base_rent_7_ratio : P.base_rent_8_9_ratio;
          return row['6'] * ratio / 100;
        }
        function calc() {
          var n = Number(I.members.value), zone = I.zone.value;
          var rent = num(I.rent), deposit = num(I.deposit), recognized = num(I.recognized);
          var owner = I.owner.checked;
          var msgs = [];
          Object.keys(V).forEach(function (k) { set(k, '—'); });
          totalRow.classList.remove('bad'); eligRow.classList.remove('bad');

          // (1) 선정기준 48%
          var standard = P.housing_standard[String(n)];
          set('standard', won(standard) + ' (' + P.housing_rate + '%)');

          // (3) 기준임대료, (4) 실제임차료, (5) 적용 임차료
          var base = baseRent(zone, n);
          set('base_rent', won(base) + (n >= 7 ? ' (6인 × ' + (n === 7 ? P.base_rent_7_ratio : P.base_rent_8_9_ratio) + '%)' : ''));
          var depositMonthly = deposit * P.deposit_rate / 100 / 12;
          var actual = rent + depositMonthly;
          var rentFilled = I.rent.value !== '' || I.deposit.value !== '';
          set('actual_rent', rentFilled ? won(actual) + (deposit ? ' (보증금분 ' + won(depositMonthly) + ')' : '') : '—');
          var applied = Math.min(base, actual);
          set('applied_rent', rentFilled ? won(applied) + (actual < base ? ' (실제 임차료)' : ' (기준임대료)') : '—');

          // (6) 자기부담분 = (소득인정액 − 생계급여 선정기준) × 30%
          var living = P.living_standard[String(n)];
          var over = Math.max(recognized - living, 0);
          var selfPay = over * P.self_pay_rate / 100;
          var incFilled = I.recognized.value !== '';
          set('self_pay', incFilled ? won(selfPay) + (over > 0 ? ' (초과분 ' + won(over) + ' × ' + P.self_pay_rate + '%)' : ' (생계 기준 ' + won(living) + ' 이하)') : '—');

          if (owner) {
            set('eligible', '자가 — 수선유지급여');
            set('benefit', '임차급여 대상 아님');
            totalRow.classList.add('bad');
            answer.textContent = '자가 가구는 임차급여가 아니라 수선유지급여 대상이다.';
            var R = P.repair;
            msgs.push('소득인정액이 선정기준(' + won(standard) + ') 이하면 집 상태에 따라 경보수 ' + won(R.light.cost) + '(' + R.light.cycle + '년)·중보수 ' + won(R.medium.cost) + '(' + R.medium.cycle + '년)·대보수 ' + won(R.major.cost) + '(' + R.major.cycle + '년) 범위에서 수선을 지원한다. 지원율은 생계급여 선정기준 이하 100%, 중위소득 40% 이하 90%, 48% 이하 80%.');
            warn.innerHTML = msgs.join('<br />'); warn.hidden = false; return;
          }

          if (!incFilled) {
            set('eligible', '소득인정액 입력 전');
            answer.textContent = rentFilled ? '소득인정액을 넣으면 월 임차급여액이 나온다.' : '가구원 수·지역·월세·소득인정액을 넣으면 월 임차급여액이 나온다.';
            if (rentFilled) set('benefit', won(applied) + ' (소득인정액 0 기준)');
            warn.hidden = true; return;
          }

          // (2) 판정
          if (recognized > standard) {
            set('eligible', '대상 아님');
            eligRow.classList.add('bad');
            set('benefit', '대상 아님');
            totalRow.classList.add('bad');
            answer.textContent = n + '인 가구 소득인정액 ' + won(recognized) + '은 선정기준 ' + won(standard) + '을 넘어 주거급여 대상이 아니다.';
            msgs.push('소득인정액이 선정기준보다 ' + won(recognized - standard) + ' 많다. 교육급여(50%)는 기준이 달라 따로 확인한다.');
            warn.innerHTML = msgs.join('<br />'); warn.hidden = false; return;
          }
          set('eligible', '대상 (선정기준 이하)');
          if (!rentFilled) {
            answer.textContent = n + '인 가구 소득인정액 ' + won(recognized) + '은 선정기준 이하다. 월세·보증금을 넣으면 급여액이 나온다.';
            warn.hidden = true; return;
          }

          // (7) 급여액 = (5) − (6), 10원 단위 올림, 1만원 미만이면 1만원. 실제임차료 > 기준임대료 5배면 1만원.
          var benefit, tooHigh = actual > base * P.max_rent_multiple;
          if (tooHigh) {
            benefit = P.min_benefit;
            msgs.push('실제 임차료 ' + won(actual) + '이 기준임대료의 ' + P.max_rent_multiple + '배(' + won(base * P.max_rent_multiple) + ')를 넘어 임차급여는 ' + won(P.min_benefit) + '만 지급된다 (고시 제7조 제1항 제3호).');
          } else {
            var raw = applied - selfPay;
            benefit = Math.ceil(raw / P.round_unit) * P.round_unit;
            if (benefit < P.min_benefit) {
              msgs.push('산정액 ' + won(Math.max(raw, 0)) + '이 1만원 미만이라 최저 ' + won(P.min_benefit) + '을 지급한다 (고시 제7조 제5항).');
              benefit = P.min_benefit;
            }
          }
          set('benefit', won(benefit));
          answer.textContent = n + '인 가구 · ' + zoneName[zone] + ' · 소득인정액 ' + won(recognized) + '이면 월 임차급여는 ' + won(benefit) + '이다.';
          if (actual < base) msgs.push('실제 임차료(' + won(actual) + ')가 기준임대료(' + won(base) + ')보다 적어 실제 임차료까지만 지원된다.');
          if (over > 0) msgs.push('소득인정액이 생계급여 선정기준(' + won(living) + ')을 ' + won(over) + ' 넘어 그 30%인 ' + won(selfPay) + '을 자기부담으로 뺐다.');
          msgs.push('실제 급여는 LH 주택조사(임대차계약서·실거주 확인)와 시·군·구 소득·재산 조사로 정해지며, 10원 단위 올림해 지급된다.');
          warn.innerHTML = msgs.join('<br />');
          warn.hidden = msgs.length === 0;
        }

        // 금액 칸: 숫자만 남기고 천 단위 콤마
        root.querySelectorAll('[data-type="won"]').forEach(function (el) {
          el.addEventListener('input', function () {
            var raw = el.value.replace(/[^\d]/g, '').replace(/^0+(?=\d)/, '');
            el.value = raw ? raw.replace(/\B(?=(\d{3})+(?!\d))/g, ',') : '';
            calc();
          });
        });
        root.querySelectorAll('[data-type="select"], [data-type="check"]').forEach(function (el) {
          el.addEventListener('input', calc); el.addEventListener('change', calc);
        });

        // 공유 주소 (기획서 3번)
        var sh = root.querySelector('[data-share]');
        if (sh) {
          var u = encodeURIComponent(sh.dataset.url), t = encodeURIComponent(sh.dataset.title);
          sh.querySelector('[data-share-fb]').href = 'https://www.facebook.com/sharer/sharer.php?u=' + u;
          sh.querySelector('[data-share-x]').href = 'https://twitter.com/intent/tweet?url=' + u + '&text=' + t;
          sh.querySelector('[data-share-naver]').href = 'https://share.naver.com/web/shareView?url=' + u + '&title=' + t;
          sh.querySelector('[data-share-band]').href = 'https://band.us/plugin/share?body=' + t + '%20' + u + '&route=' + u;
        }
        calc();
      }
      document.addEventListener('astro:page-load', init);
      if (document.readyState !== 'loading') init(); else document.addEventListener('DOMContentLoaded', init);
    })();
  </script>

  <CalcDock />
</Base>

<style>
  /* 계산기 무드: 생계급여 계산기(living-benefit.astro)와 같은 유리 카드·금색 강조 토큰을 이 페이지 안에서만 정의 */
  .calc {
    --gold: #f5b544; --gold-ink: #ffd27a; --gold-soft: rgba(245, 181, 68, .12);
    --rose: #ff6b7a; --rose-soft: rgba(255, 107, 122, .12);
    --hair-2: rgba(255, 255, 255, .14);
    --glass: rgba(18, 24, 38, .66); --glass-2: rgba(22, 28, 44, .55);
    --field: rgba(9, 12, 22, .55);
    --cshadow: 0 24px 60px -20px rgba(0, 0, 0, .6), 0 8px 18px -8px rgba(0, 0, 0, .4), inset 0 1px 0 rgba(255, 255, 255, .08);
    --r-sm: 12px;
    max-width: 920px; margin: 0 auto; font-size: 15.5px; letter-spacing: -.01em;
  }
  :global(:root[data-theme='light']) .calc {
    --gold: #c98a12; --gold-ink: #a86f0a; --gold-soft: rgba(201, 138, 18, .10);
    --rose: #e0475a; --rose-soft: rgba(224, 71, 90, .10);
    --hair-2: #d3d8e0; --glass: rgba(255, 255, 255, .78); --glass-2: rgba(255, 255, 255, .6); --field: rgba(255, 255, 255, .85);
    --cshadow: 0 24px 60px -24px rgba(25, 31, 40, .18), 0 6px 14px -8px rgba(25, 31, 40, .12), inset 0 1px 0 rgba(255, 255, 255, .9);
  }

  .hero { padding: 54px 0 26px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 700; color: var(--gold); letter-spacing: .02em; text-transform: uppercase; }
  .eyebrow::before { content: ''; width: 22px; height: 1px; background: var(--gold); }
  h1 { font-size: clamp(30px, 4.6vw, 44px); line-height: 1.15; letter-spacing: -.035em; margin: 12px 0 14px; font-weight: 800; }
  .lede { color: var(--ink-2); font-size: 16px; max-width: 640px; margin: 0; line-height: 1.6; }
