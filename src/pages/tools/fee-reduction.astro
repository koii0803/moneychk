---
import Base from '../../layouts/Base.astro';
import { SITE, CATEGORIES } from '../../config/site';
import calc from '../../data/calcs/fee-reduction.json';
import tools from '../../data/tools.json';

// 계산기 한 장 = JSON 한 장(src/data/calcs/<slug>.json). 이 페이지는 그 JSON을 읽어 그린다.
// 전기·가스·통신·TV·지역난방 한도와 감면율은 JSON params(연도 키)에서만 온다. 코드에 숫자를 박지 않는다.
const cat = CATEGORIES[calc.cat as keyof typeof CATEGORIES];
const pageUrl = `${SITE.url}/tools/${calc.slug}`;
const byStep = (n: number) => calc.inputs.filter((i) => i.step === n);
const related = calc.related_calcs.map((r) => {
  const t = r.tool_no ? tools.find((x) => x.no === r.tool_no) : undefined;
  return { ...r, href: t?.href || r.href || '' };
});
const basisYear = calc.basis_date.slice(0, 4);
const P = calc.params as Record<string, unknown>;
const params = P[basisYear] as Record<string, unknown>;
const stepTitle = ['', '자격', '월 요금', '계절'];
const stepSub = ['', '가장 큰 자격 하나 + 추가 조건', '청구서 금액·이용 여부', '선택 사항'];
---

<Base title={calc.name} description={calc.description}>
  <div class="calc" data-calc>
    <header class="hero">
      <span class="eyebrow">모의계산기 · {cat.short}</span>
      <h1>{calc.name}</h1>
      <p class="lede">{calc.lede}</p>
      <div class="stamps">
        <span class="stamp gold"><b>{calc.basis_label}</b></span>
        <span class="stamp">확인일 <b>{calc.basis_date.replace(/-/g, '.')}</b></span>
        <span class="stamp">기준 <b>한전 · 산업통상부고시 제2025-24호 · 정부24</b></span>
      </div>
    </header>

    <div class="cols">
      <div class="in">
        {[1, 2, 3].map((n) => (
          <section class="card" id={`s${n}`}>
            <div class="card-h">
              <span class="num">STEP {n}</span>
              <h2>{stepTitle[n]}</h2>
              <p>{stepSub[n]}</p>
            </div>
            <div class="grid">
              {byStep(n).map((f) => (
                <div class="field">
                  {f.type === 'check' ? (
                    <label class="toggle">
                      <input type="checkbox" id={`f-${f.id}`} data-in={f.id} data-type="check" />
                      <span>{f.label}<small>{f.help}</small></span>
                    </label>
                  ) : (
                    <>
                      <label for={`f-${f.id}`}>{f.label}{f.optional && <small> (선택)</small>}</label>
                      <div class="inp">
                        {f.type === 'select' ? (
                          <select id={`f-${f.id}`} data-in={f.id} data-type="select">
                            {(f.options || []).map((o) => <option value={o.value}>{o.label}</option>)}
                          </select>
                        ) : (
                          <input type="text" inputmode="numeric" id={`f-${f.id}`} data-in={f.id} data-type="won" placeholder="0" autocomplete="off" />
                        )}
                        {f.type === 'won' && <span class="unit">원</span>}
                      </div>
                      {f.help && <p class="sub">{f.help}</p>}
                    </>
                  )}
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="out">
        <section class="card result" id="result" aria-live="polite">
          <div class="card-h"><span class="num">결과</span><h2>요금감면 합계표</h2><p>{calc.basis_label}</p></div>
          <p class="answer" data-answer>자격을 고르고 월 요금을 넣으면 항목별 감면액과 합계가 나온다.</p>
          <div class="tbl-wrap">
            <table>
              <thead><tr><th>항목</th><th class="r">감면액</th><th class="f">산식</th></tr></thead>
              <tbody>
                {calc.steps.map((s) => (
                  <tr class={s.total ? 'total' : ''} data-row={s.id}>
                    <td><span class="no">({s.no})</span> {s.label}<small class="f2" data-f2={s.id}>{s.formula}</small></td>
                    <td class="r"><b data-val={s.id}>—</b></td>
                    <td class="f"><code data-formula={s.id}>{s.formula}</code></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="hint" data-warn hidden></p>
        </section>
      </div>
    </div>

    <section class="card slim">
      <div class="card-h"><span class="num">관련</span><h2>같이 쓰는 계산기</h2></div>
      <div class="rel">
        {related.map((r) => r.href
          ? <a class="rel-btn" href={r.href}>{r.name}</a>
          : <span class="rel-btn off" aria-disabled="true">{r.name} <small>준비 중</small></span>)}
      </div>
      <div class="share" data-share data-url={pageUrl} data-title={`${calc.name} — ${SITE.name}`}>
        <span class="share-l">공유</span>
        <a class="share-btn" data-share-fb href="#" target="_blank" rel="noopener">페이스북</a>
        <a class="share-btn" data-share-x href="#" target="_blank" rel="noopener">X</a>
        <a class="share-btn" data-share-naver href="#" target="_blank" rel="noopener">네이버 블로그</a>
        <a class="share-btn" data-share-band href="#" target="_blank" rel="noopener">밴드</a>
      </div>
    </section>

    <div class="ad-slot" data-slot="in-article"></div>

    <section class="card slim">
      <div class="card-h"><span class="num">※</span><h2>산식과 근거</h2><p>확인일 {calc.basis_date.replace(/-/g, '.')}</p></div>
      <ol class="notes">
        {calc.notes.map((n) => <li>{n}</li>)}
      </ol>
      <p class="src">
        {calc.law.map((l) => <span>· <a href={l.url} target="_blank" rel="noopener">{l.name}</a> <em>{l.ver}</em><br /></span>)}
      </p>
    </section>

    <section class="card slim">
      <div class="card-h"><span class="num">이력</span><h2>기준값 이력</h2><p>바뀌면 줄이 늘어난다</p></div>
      <div class="tbl-wrap">
        <table class="hist">
          <thead><tr><th>날짜</th><th>기준값</th><th class="r">값</th><th>출처</th></tr></thead>
          <tbody>
            {calc.history.map((h) => (
              <tr><td>{h.date.replace(/-/g, '.')}</td><td><code>{h.param}</code></td><td class="r"><b>{h.value}</b></td><td>{h.src}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <p class="foot-note">{calc.disclaimer}<br />입력값은 이 브라우저 안에서만 계산되며 서버로 보내지 않는다.</p>
  </div>

  <script type="application/json" id="calc-params" set:html={JSON.stringify(params)} />
  <script is:inline>
    // 순수 JS. 입력이 바뀌면 즉시 다시 계산한다. 산식은 JSON steps.formula와 같은 순서.
    // 항목별 감면 = min(요금, 한도) 꼴. 자격 할인과 다자녀 할인이 겹치면 항목마다 큰 쪽 하나만 (중복 불가).
    (function () {
      function init() {
        var root = document.querySelector('[data-calc]');
        if (!root || root.dataset.ready) return;
        root.dataset.ready = '1';
        var P = JSON.parse(document.getElementById('calc-params').textContent);

        var fmt = function (n) {
          if (n === null || n === undefined || isNaN(n)) return '—';
          return String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        };
        var won = function (n) { return n === null ? '—' : fmt(n) + '원'; };
        var num = function (el) { return Number((el.value || '').replace(/[^\d]/g, '')) || 0; };

        var I = {};
        root.querySelectorAll('[data-in]').forEach(function (el) { I[el.dataset.in] = el; });
        var V = {};
        root.querySelectorAll('[data-val]').forEach(function (el) { V[el.dataset.val] = el; });
        var F = {};
        root.querySelectorAll('[data-formula]').forEach(function (el) { F[el.dataset.formula] = el; });
        var F2 = {};
        root.querySelectorAll('[data-f2]').forEach(function (el) { F2[el.dataset.f2] = el; });
        var baseFormula = {};
        Object.keys(F).forEach(function (k) { baseFormula[k] = F[k].textContent; });
        var answer = root.querySelector('[data-answer]');
        var warn = root.querySelector('[data-warn]');
        var totalRow = root.querySelector('[data-row="total"]');

        function set(id, text) { if (V[id]) V[id].textContent = text; }
        function setF(id, text) { var s = text || baseFormula[id]; if (F[id]) F[id].textContent = s; if (F2[id]) F2[id].textContent = s; }

        // (1) 전기: 자격 정액 한도 vs 다자녀 30%(한도). 큰 쪽 하나.
        function elecCut(q, multi, season, bill) {
          var E = P.elec, key = season === 'summer' ? 'summer' : 'other';
          var a = 0, af = '', b = 0, bf = '';
          if (E[q]) { a = Math.min(bill, E[q][key]); af = '전기요금 ' + won(bill) + '과 ' + (key === 'summer' ? '여름철' : '') + ' 한도 ' + won(E[q][key]) + ' 중 작은 값'; }
          if (multi) { b = Math.min(bill * E.multi.rate / 100, E.multi.cap); bf = '전기요금 × ' + E.multi.rate + '% = ' + won(bill * E.multi.rate / 100) + ', 한도 ' + won(E.multi.cap) + ' (다자녀)'; }
          return b > a ? { v: b, f: bf } : { v: a, f: af };
        }
        // (2) 가스: 자격·계절·용도별 한도. 자격 vs 다자녀 큰 쪽.
        function gasCut(q, multi, season, use, voucher, bill) {
          var G = P.gas;
          function lim(row) { if (use === 'cook') return row.cook; if (season === 'winter') return voucher ? row.winter_voucher : row.winter; return row.other; }
          var la = G[q] ? lim(G[q]) : 0, lb = multi ? lim(G.multi) : 0;
          var useB = lb > la;
          var l = useB ? lb : la, v = Math.min(bill, l);
          var label = use === 'cook' ? '취사용' : season === 'winter' ? (voucher && !useB ? '동절기(바우처 가구)' : '동절기') : '그 외 계절';
          return { v: v, l: l, f: '가스 사용요금 ' + won(bill) + '과 ' + label + ' 한도 ' + won(l) + ' 중 작은 값' + (useB ? ' (다자녀)' : '') };
        }
        // (3) 통신: 기본감면 + 초과분 × 율, 최대액. 정부24 값은 부가세 제외라 ×(1+vat)
        function telCut(q, bill) {
          var T = P.tel, r = T[q]; if (!r) return { v: 0, f: '' };
          var k = 1 + T.vat / 100;
          if (!r.base) { return { v: bill * r.rate / 100, f: '요금 ' + won(bill) + ' × ' + r.rate + '% (한도 없음)' }; }
          var base = r.base * k, cap = r.usage_cap * k, max = r.max * k;
          var b1 = Math.min(bill, base);
          var over = Math.min(Math.max(bill - base, 0), cap);
          var raw = b1 + over * r.rate / 100;
          var v = Math.min(raw, max);
          return { v: v, f: '월정액 면제 ' + won(b1) + ' + 초과분 ' + won(over) + ' × ' + r.rate + '% = ' + won(raw) + ', 최대 ' + won(max) + ' (부가세 포함)' };
        }

        function calc() {
          var q = I.qual.value, multi = I.multi.checked, voucher = I.voucher.checked, bd = I.blind_deaf.checked;
          var elec = num(I.elec), gas = num(I.gas), tel = num(I.tel), water = num(I.water);
          var use = I.gas_use.value, season = I.season.value, dh = I.dh.checked, tv = I.tv.checked;
          var msgs = [];
          Object.keys(V).forEach(function (k) { set(k, '—'); });
          Object.keys(F).forEach(function (k) { setF(k, ''); });
          totalRow.classList.remove('bad');
          set('water', water ? '지자체 확인 (' + won(water) + ' 중)' : '지자체 확인');

          var hasQual = q !== 'none' || multi;
          if (!hasQual) {
            answer.textContent = '자격을 고르거나 3자녀 이상을 켜면 감면액이 나온다.';
            set('total', '대상 아님'); totalRow.classList.add('bad');
            warn.hidden = true; return;
          }

          // (1) 전기
          var e = elecCut(q, multi, season, elec);
          set('elec', elec ? won(e.v) : '요금 입력'); if (elec) setF('elec', e.f);
          // (2) 가스
          var g = gasCut(q, multi, season, use, voucher, gas);
          set('gas', gas ? won(g.v) : '요금 입력 (한도 ' + won(g.l) + ')'); if (gas) setF('gas', g.f);
          // (3) 통신
          var t = telCut(q, tel);
          if (!P.tel[q]) { set('tel', '해당 없음'); setF('tel', '다자녀만으로는 통신 감면이 없다'); t.v = 0; }
          else { set('tel', tel ? won(t.v) : '요금 입력'); if (tel) setF('tel', t.f); }
          // (4) TV
          var tvExempt = P.tv.exempt.indexOf(q) >= 0 || bd;
          var tvv = tv && tvExempt ? P.tv.fee : 0;
          if (!tv) set('tv', 'TV 없음');
          else if (!tvExempt) { set('tv', '면제 아님'); setF('tv', q === 'disabled' ? '시각·청각장애인 가정만 면제' : '주거·교육·차상위·다자녀는 면제 대상이 아님'); }
          else { set('tv', won(tvv)); setF('tv', '월 수신료 ' + won(P.tv.fee) + ' 전액 면제' + (bd && P.tv.exempt.indexOf(q) < 0 ? ' (시각·청각장애인 가정)' : '')); }
          // (6) 지역난방
          var D = P.dh, da = D[q] || 0, db = multi ? D.multi : 0, dv = dh ? Math.max(da, db) : 0;
          if (!dh) set('dh', '지역난방 아님');
          else { set('dh', won(dv)); setF('dh', '월 ' + won(dv) + (db > da ? ' (다자녀)' : '') + ' — 매년 8~10월 12개월분 계좌 환급'); }

          // (7) 월 합계
          var total = e.v + g.v + t.v + tvv + dv;
          set('total', won(total));
          // (8) 연 환산: 전기 여름 3개월 + 그 외 9개월, 가스 동절기 4 + 그 외 8, 나머지 ×12
          var eS = elecCut(q, multi, 'summer', elec).v, eO = elecCut(q, multi, 'other', elec).v;
          var gW = gasCut(q, multi, 'winter', use, voucher, gas).v, gO = gasCut(q, multi, 'other', use, voucher, gas).v;
          var sm = P.elec.summer_months, wm = P.gas.winter_months;
          var annual = eS * sm + eO * (12 - sm) + gW * wm + gO * (12 - wm) + (t.v + tvv + dv) * 12;
          set('annual', won(annual));
          setF('annual', '전기 ' + won(eO) + '×' + (12 - sm) + ' + ' + won(eS) + '×' + sm + ' / 가스 ' + won(gW) + '×' + wm + ' + ' + won(gO) + '×' + (12 - wm) + ' / (통신+TV+난방) ' + won(t.v + tvv + dv) + '×12 (매달 같은 요금 가정)');

          var filled = elec || gas || tel || tv || dh;
          answer.textContent = filled ? '매달 최대 ' + won(total) + ' 아낄 수 있다. 1년이면 ' + won(annual) + '이다.' : '월 요금을 넣으면 매달 얼마 아끼는지 나온다.';

          if (season === 'winter' && gas && use !== 'cook') msgs.push('동절기 가스 한도 ' + won(g.l) + '은 2025.12.1~2026.11.30 적용 별표 1 값이다. 동절기 밖 8개월은 한도가 ' + won(gasCut(q, multi, 'other', use, voucher, gas).l) + '로 줄어든다.');
          if ((q === 'disabled' || q === 'veteran') && tel) msgs.push('장애인·국가유공자 통신 감면은 35% 정률이고 월 최대액이 없다. 단말기 할부금·부가서비스는 빼고 요금제·통화·데이터 요금에만 적용된다.');
          if (multi && q !== 'none') msgs.push('자격 할인과 다자녀 할인은 중복되지 않는다. 전기·가스·난방 각 항목에서 큰 쪽 하나만 넣었다.');
          if (water) msgs.push('상·하수도 ' + won(water) + '은 지자체 조례로 감면 여부·금액이 달라 합계에 넣지 않았다. 관할 상수도사업본부에 확인한다.');
          msgs.push('모두 신청해야 적용된다. 복지로·정부24 요금감면 일괄신청, 주민센터, 또는 한전(123)·도시가스사·통신사(114)·KBS(1588-1801)·지역난방공사(1688-2488)에 각각 신청한다.');
          warn.innerHTML = msgs.join('<br />');
          warn.hidden = msgs.length === 0;
        }

        // 금액 칸: 숫자만 남기고 천 단위 콤마
        root.querySelectorAll('[data-type="won"]').forEach(function (el) {
          el.addEventListener('input', function () {
            var raw = el.value.replace(/[^\d]/g, '').replace(/^0+(?=\d)/, '');
            el.value = raw ? raw.replace(/\B(?=(\d{3})+(?!\d))/g, ',') : '';
            calc();
          });
        });
        root.querySelectorAll('[data-type="select"], [data-type="check"]').forEach(function (el) {
          el.addEventListener('input', calc); el.addEventListener('change', calc);
        });

        // 공유 주소 (기획서 3번)
        var sh = root.querySelector('[data-share]');
        if (sh) {
          var u = encodeURIComponent(sh.dataset.url), t = encodeURIComponent(sh.dataset.title);
          sh.querySelector('[data-share-fb]').href = 'https://www.facebook.com/sharer/sharer.php?u=' + u;
          sh.querySelector('[data-share-x]').href = 'https://twitter.com/intent/tweet?url=' + u + '&text=' + t;
          sh.querySelector('[data-share-naver]').href = 'https://share.naver.com/web/shareView?url=' + u + '&title=' + t;
          sh.querySelector('[data-share-band]').href = 'https://band.us/plugin/share?body=' + t + '%20' + u + '&route=' + u;
        }
        calc();
      }
      document.addEventListener('astro:page-load', init);
      if (document.readyState !== 'loading') init(); else document.addEventListener('DOMContentLoaded', init);
    })();
  </script>
</Base>

<style>
  /* 계산기 무드: 생계급여 계산기(living-benefit.astro)와 같은 유리 카드·금색 강조 토큰을 이 페이지 안에서만 정의 */
  .calc {
    --gold: #f5b544; --gold-ink: #ffd27a; --gold-soft: rgba(245, 181, 68, .12);
    --rose: #ff6b7a; --rose-soft: rgba(255, 107, 122, .12);
    --hair-2: rgba(255, 255, 255, .14);
    --glass: rgba(18, 24, 38, .66); --glass-2: rgba(22, 28, 44, .55);
    --field: rgba(9, 12, 22, .55);
    --cshadow: 0 24px 60px -20px rgba(0, 0, 0, .6), 0 8px 18px -8px rgba(0, 0, 0, .4), inset 0 1px 0 rgba(255, 255, 255, .08);
    --r-sm: 12px;
    max-width: 920px; margin: 0 auto; font-size: 15.5px; letter-spacing: -.01em;
  }
  :global(:root[data-theme='light']) .calc {
    --gold: #c98a12; --gold-ink: #a86f0a; --gold-soft: rgba(201, 138, 18, .10);
    --rose: #e0475a; --rose-soft: rgba(224, 71, 90, .10);
    --hair-2: #d3d8e0; --glass: rgba(255, 255, 255, .78); --glass-2: rgba(255, 255, 255, .6); --field: rgba(255, 255, 255, .85);
    --cshadow: 0 24px 60px -24px rgba(25, 31, 40, .18), 0 6px 14px -8px rgba(25, 31, 40, .12), inset 0 1px 0 rgba(255, 255, 255, .9);
  }

  .hero { padding: 54px 0 26px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 700; color: var(--gold); letter-spacing: .02em; text-transform: uppercase; }
  .eyebrow::before { content: ''; width: 22px; height: 1px; background: var(--gold); }
  h1 { font-size: clamp(30px, 4.6vw, 44px); line-height: 1.15; letter-spacing: -.035em; margin: 12px 0 14px; font-weight: 800; }
  .lede { color: var(--ink-2); font-size: 16px; max-width: 640px; margin: 0; line-height: 1.6; }
  .stamps { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
