---
import Base from '../../layouts/Base.astro';
import { SITE, CATEGORIES } from '../../config/site';
import calc from '../../data/calcs/mortgage-limit.json';
import tools from '../../data/tools.json';

// 계산기 한 장 = JSON 한 장(src/data/calcs/<slug>.json). 이 페이지는 그 JSON을 읽어 그린다.
// LTV·한도·스트레스 금리·DSR 비율은 JSON params(연도 키)에서만 온다. 코드에 숫자를 박지 않는다.
const cat = CATEGORIES[calc.cat as keyof typeof CATEGORIES];
const pageUrl = `${SITE.url}/tools/${calc.slug}`;
const byStep = (n: number) => calc.inputs.filter((i) => i.step === n);
const related = calc.related_calcs.map((r) => {
  const t = r.tool_no ? tools.find((x) => x.no === r.tool_no) : undefined;
  return { ...r, href: t?.href || '' };
});
const basisYear = calc.basis_date.slice(0, 4);
const P = calc.params as Record<string, unknown>;
const params = P[basisYear] as Record<string, unknown>;
const defaults: Record<string, string> = { term: '30' };
const stepTitle = ['', '집과 지역', '소득과 기존 대출', '대출 조건'];
const stepSub = ['', 'LTV·주택가격별 한도', 'DSR 여력', '금리·만기·상환 방식'];
const stressLocalUntil = String(params.stress_local_until).replace(/-/g, '.');
---

<Base title={calc.name} description={calc.description}>
  <div class="calc" data-calc>
    <header class="hero">
      <span class="eyebrow">모의계산기 · {cat.short}</span>
      <h1>{calc.name}</h1>
      <p class="lede">{calc.lede}</p>
      <div class="stamps">
        <span class="stamp gold big"><b>{calc.basis_label}</b></span>
        <span class="stamp">확인일 <b>{calc.basis_date.replace(/-/g, '.')}</b></span>
        <span class="stamp">규제 <b>금융위 6.27 · 10.15 대책 · ’26 가계부채 관리방안</b></span>
        <span class="stamp rose">지방 스트레스 0.75%p <b>{stressLocalUntil}까지</b></span>
      </div>
    </header>

    <div class="cols">
      <div class="in">
        {[1, 2, 3].map((n) => (
          <section class="card" id={`s${n}`}>
            <div class="card-h">
              <span class="num">STEP {n}</span>
              <h2>{stepTitle[n]}</h2>
              <p>{stepSub[n]}</p>
            </div>
            <div class="grid">
              {byStep(n).map((f) => (
                <div class="field">
                  {f.type === 'check' ? (
                    <label class="toggle">
                      <input type="checkbox" id={`f-${f.id}`} data-in={f.id} data-type="check" />
                      <span>{f.label}<small>{f.help}</small></span>
                    </label>
                  ) : (
                    <>
                      <label for={`f-${f.id}`}>{f.label}{f.optional && <small> (선택)</small>}</label>
                      <div class="inp">
                        {f.type === 'select' ? (
                          <select id={`f-${f.id}`} data-in={f.id} data-type="select">
                            {(f.options || []).map((o) => <option value={o.value}>{o.label}</option>)}
                          </select>
                        ) : f.type === 'pct' ? (
                          <input type="text" inputmode="decimal" id={`f-${f.id}`} data-in={f.id} data-type="pct" placeholder="0" value={defaults[f.id] ?? ''} autocomplete="off" />
                        ) : f.type === 'num' ? (
                          <input type="text" inputmode="numeric" id={`f-${f.id}`} data-in={f.id} data-type="num" placeholder="0" value={defaults[f.id] ?? ''} autocomplete="off" />
                        ) : (
                          <input type="text" inputmode="numeric" id={`f-${f.id}`} data-in={f.id} data-type="won" placeholder="0" autocomplete="off" />
                        )}
                        {f.type === 'won' && <span class="unit">원</span>}
                        {f.type === 'pct' && <span class="unit">%</span>}
                        {f.type === 'num' && <span class="unit">{f.unit}</span>}
                      </div>
                      {f.help && <p class="sub">{f.help}</p>}
                    </>
                  )}
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="out">
        <section class="card result" id="result" aria-live="polite">
          <div class="card-h"><span class="num">결과</span><h2>대출 한도 계산표</h2><p>{calc.basis_label}</p></div>
          <p class="answer" data-answer>주택 가격과 연소득을 넣으면 예상 대출 한도가 나온다.</p>
          <div class="tbl-wrap">
            <table>
              <thead><tr><th>항목</th><th class="r">금액</th><th class="f">산식</th></tr></thead>
              <tbody>
                {calc.steps.map((s) => (
                  <tr class={s.total ? 'total' : ''} data-row={s.id}>
                    <td><span class="no">({s.no})</span> {s.label}<small class="f2">{s.formula}</small></td>
                    <td class="r"><b data-val={s.id}>—</b></td>
                    <td class="f"><code>{s.formula}</code></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="hint" data-warn hidden></p>
        </section>
      </div>
    </div>

    <section class="card slim">
      <div class="card-h"><span class="num">관련</span><h2>같이 쓰는 계산기</h2></div>
      <div class="rel">
        {related.map((r) => r.href
          ? <a class="rel-btn" href={r.href}>{r.name}</a>
          : <span class="rel-btn off" aria-disabled="true">{r.name} <small>준비 중</small></span>)}
      </div>
      <div class="share" data-share data-url={pageUrl} data-title={`${calc.name} — ${SITE.name}`}>
        <span class="share-l">공유</span>
        <a class="share-btn" data-share-fb href="#" target="_blank" rel="noopener">페이스북</a>
        <a class="share-btn" data-share-x href="#" target="_blank" rel="noopener">X</a>
        <a class="share-btn" data-share-naver href="#" target="_blank" rel="noopener">네이버 블로그</a>
        <a class="share-btn" data-share-band href="#" target="_blank" rel="noopener">밴드</a>
      </div>
    </section>

    <div class="ad-slot" data-slot="in-article"></div>

    <section class="card slim">
      <div class="card-h"><span class="num">※</span><h2>산식과 근거</h2><p>확인일 {calc.basis_date.replace(/-/g, '.')}</p></div>
      <ol class="notes">
        {calc.notes.map((n) => <li>{n}</li>)}
      </ol>
      <p class="src">
        {calc.law.map((l) => <span>· <a href={l.url} target="_blank" rel="noopener">{l.name}</a> <em>{l.ver}</em><br /></span>)}
      </p>
    </section>

    <section class="card slim">
      <div class="card-h"><span class="num">이력</span><h2>기준값 이력</h2><p>바뀌면 줄이 늘어난다</p></div>
      <div class="tbl-wrap">
        <table class="hist">
          <thead><tr><th>날짜</th><th>기준값</th><th class="r">값</th><th>출처</th></tr></thead>
          <tbody>
            {calc.history.map((h) => (
              <tr><td>{h.date.replace(/-/g, '.')}</td><td><code>{h.param}</code></td><td class="r"><b>{h.value}</b></td><td>{h.src}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <p class="foot-note">{calc.disclaimer}<br />입력값은 이 브라우저 안에서만 계산되며 서버로 보내지 않는다.</p>
  </div>

  <script type="application/json" id="calc-params" set:html={JSON.stringify(params)} />
  <script is:inline>
    // 순수 JS. 입력이 바뀌면 즉시 다시 계산한다. 산식은 JSON steps.formula와 같은 순서.
    // (1)(2) LTV → (3) 수도권·규제지역 주택가격별 한도 → (4)(5)(6) 스트레스 DSR 역산 → (7) 셋 중 최소 → (8) 실제 금리 월 상환액.
    (function () {
      function init() {
        var root = document.querySelector('[data-calc]');
        if (!root || root.dataset.ready) return;
        root.dataset.ready = '1';
        var P = JSON.parse(document.getElementById('calc-params').textContent);

        var fmt = function (n) {
          if (n === null || n === undefined || isNaN(n)) return '—';
          return String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        };
        var won = function (n) { return n === null || n === undefined || isNaN(n) ? '—' : fmt(n) + '원'; };
        var eok = function (n) {
          // 억 단위 보조 표기 (1억 이상만)
          if (!n || n < 100000000) return '';
          var e = n / 100000000;
          return ' (' + (Math.round(e * 100) / 100).toLocaleString('ko-KR') + '억)';
        };
        var pct = function (n) { return String(Math.round(n * 100) / 100) + '%'; };
        var num = function (el) { return Number((el.value || '').replace(/[^\d]/g, '')) || 0; };
        var dec = function (el) { var v = parseFloat(el.value); return isNaN(v) ? 0 : v; };

        var I = {};
        root.querySelectorAll('[data-in]').forEach(function (el) { I[el.dataset.in] = el; });
        var V = {};
        root.querySelectorAll('[data-val]').forEach(function (el) { V[el.dataset.val] = el; });
        var answer = root.querySelector('[data-answer]');
        var warn = root.querySelector('[data-warn]');
        var totalRow = root.querySelector('[data-row="limit"]');

        function set(id, text) { if (V[id]) V[id].textContent = text; }

        // 원리금균등: 월 상환액 = 원금 × r(1+r)^n ÷ ((1+r)^n − 1)
        function annuityPay(principal, r, n) {
          if (r <= 0) return principal / n;
          var k = Math.pow(1 + r, n);
          return principal * r * k / (k - 1);
        }
        // 원리금균등 역산: 월 상환액 m 으로 빌릴 수 있는 원금 = m × (1 − (1+r)^−n) ÷ r
        function annuityPrincipal(m, r, n) {
          if (r <= 0) return m * n;
          return m * (1 - Math.pow(1 + r, -n)) / r;
        }
        // 스트레스 금리 적용비율: 고정기간 ÷ 만기 구간 (3단계 시행방안 표3)
        function stressBucket(type, termYears) {
          if (type === 'variable') return 'lt30';
          if (type === 'fixed') return 'ge70';
          var share = P.fixed_years / termYears;
          if (P.fixed_years < 5) return 'under5';
          if (share < 0.3) return 'lt30';
          if (share < 0.5) return 'lt50';
          if (share < 0.7) return 'lt70';
          return 'ge70';
        }

        function calc() {
          var price = num(I.price), region = I.region.value, houses = I.houses.value;
          var first = I.first_home.checked, low = I.low_income.checked;
          var income = num(I.income), existing = num(I.existing), lender = I.lender.value;
          var rate = dec(I.rate), term = num(I.term), rtype = I.rate_type.value, repay = I.repay.value;
          var msgs = [];
          Object.keys(V).forEach(function (k) { set(k, '—'); });
          totalRow.classList.remove('bad');

          if (!price || !income) {
            answer.textContent = '주택 가격과 연소득을 넣으면 예상 대출 한도가 나온다.';
            warn.hidden = true; return;
          }

          // (1) 적용 LTV
          var L = P.ltv[region];
          var ltv = L[houses], ltvTag = '';
          if (houses === 'none') {
            var lowOk = low && price <= P.low_income.price_max && income <= P.low_income.income_max;
            if (low && !lowOk) msgs.push('서민·실수요자 요건(주택 ' + won(P.low_income.price_max) + ' 이하, 부부합산 연소득 ' + won(P.low_income.income_max) + ' 이하)에 안 맞아 일반 LTV로 계산했다.');
            if (first && L.first >= ltv) { ltv = L.first; ltvTag = ' (생애최초)'; }
            if (lowOk && L.low > ltv) { ltv = L.low; ltvTag = ' (서민·실수요자)'; }
          } else if (houses === 'sell1') {
            ltvTag = ' (' + P.sell_months[region] + '개월 내 처분 약정)';
            if (first || low) msgs.push('생애최초·서민실수요자 우대는 무주택자만 해당해 적용하지 않았다.');
          } else {
            if (first || low) msgs.push('생애최초·서민실수요자 우대는 무주택자만 해당해 적용하지 않았다.');
          }
          set('ltv_rate', pct(ltv) + ltvTag);

          if (ltv === 0) {
            set('ltv_limit', '0원'); set('limit', '대출 불가');
            totalRow.classList.add('bad');
            answer.textContent = '수도권·규제지역에서 1주택자가 처분 없이 추가 구입하거나 2주택 이상이면 주택구입 주담대가 안 된다 (LTV 0%).';
            msgs.push('금융위 6.27 대책: 수도권·규제지역 내 2주택 이상 보유자의 추가 구입, 1주택자의 미처분 추가 구입은 주담대 금지. 기존 집을 6개월 내 처분하는 약정을 하면 무주택자와 같은 LTV를 받는다.');
            warn.innerHTML = msgs.join('<br />'); warn.hidden = false; return;
          }

          // (2) LTV 한도
          var ltvLimit = Math.floor(price * ltv / 100);
          set('ltv_limit', won(ltvLimit) + eok(ltvLimit));

          // (3) 주택가격별 한도 (수도권·규제지역만)
          var capRows = P.cap[region], cap = null;
          for (var i = 0; i < capRows.length; i++) {
            if (capRows[i].price_max === null || price <= capRows[i].price_max) { cap = capRows[i].cap; break; }
          }
          set('cap', cap === null ? '없음 (지방)' : won(cap) + eok(cap));

          // (4) 연간 상환 여력
          var dsrPct = P.dsr[lender];
          var room = income * dsrPct / 100 - existing;
          set('dsr_room', (room < 0 ? '−' : '') + won(Math.abs(room)) + ' (DSR ' + dsrPct + '%)');

          // 만기 보정
          var maxTerm = P.max_term[region];
          var termUsed = term;
          if (!termUsed) {
            set('stress_rate', '—'); set('dsr_limit', '—');
            answer.textContent = '만기(년)를 넣으면 DSR 한도가 나온다.';
            warn.innerHTML = msgs.join('<br />'); warn.hidden = msgs.length === 0; return;
          }
          if (maxTerm && termUsed > maxTerm) { termUsed = maxTerm; msgs.push('수도권·규제지역 주담대 만기는 ' + maxTerm + '년 이내라 ' + maxTerm + '년으로 계산했다 (6.27 대책).'); }
          var n = termUsed * 12;

          // (5) 심사 금리 = 금리 + 스트레스 금리 × 적용비율
          var stress = P.stress[region];
          var bucket = stressBucket(rtype, termUsed);
          // 수도권·규제지역 밖 주담대는 혼합형·주기형 적용비율도 2단계 표를 쓴다 (~2026.12.31, 금융위 공고 제2026-362호)
          var stage2 = (P.stage2_ratio_regions || []).indexOf(region) >= 0;
          var ratio = (stage2 ? P.stress_ratio_stage2 : P.stress_ratio)[rtype][bucket];
          var stressApplied = stress * ratio / 100;
          var examRate = rate + stressApplied;
          set('stress_rate', pct(examRate) + ' (' + pct(rate) + ' + ' + pct(stress) + ' × ' + ratio + '%)');

          // (6) DSR 한도 (원리금균등 역산, 심사 금리)
          var dsrLimit = room > 0 ? Math.floor(annuityPrincipal(room / 12, examRate / 100 / 12, n)) : 0;
          set('dsr_limit', won(dsrLimit) + eok(dsrLimit));

          // (7) 예상 한도 = min
          var cands = [ { v: ltvLimit, k: 'LTV' }, { v: dsrLimit, k: 'DSR' } ];
          if (cap !== null) cands.push({ v: cap, k: '주택가격별 한도' });
          var best = cands.reduce(function (a, b) { return b.v < a.v ? b : a; });
          var limit = Math.max(0, best.v);
          set('limit', won(limit) + eok(limit) + ' · ' + best.k + ' 기준');

          // (8) 월 상환액 (실제 금리)
          var r = rate / 100 / 12, monthly, tag;
          if (repay === 'annuity') { monthly = annuityPay(limit, r, n); tag = '원리금균등'; }
          else if (repay === 'principal') { monthly = limit / n + limit * r; tag = '원금균등 첫 달'; }
          else { monthly = limit * r; tag = '만기일시 이자'; }
          set('monthly', rate > 0 || repay !== 'bullet' ? won(Math.round(monthly)) + ' (' + tag + ')' : '—');

          if (limit <= 0) {
            totalRow.classList.add('bad');
            answer.textContent = '기존 대출 원리금이 DSR 여력을 다 써서 추가 주담대가 어렵다.';
            msgs.push('연소득 × DSR ' + dsrPct + '% = ' + won(income * dsrPct / 100) + '인데 기존 대출 연 원리금이 ' + won(existing) + '이다. 기존 대출을 줄이거나 소득 인정을 늘려야 한다.');
          } else {
            answer.textContent = '예상 대출 한도는 ' + won(limit) + eok(limit) + '이다 (' + best.k + ' 기준, 월 ' + won(Math.round(monthly)) + ').';
          }
          if (rate === 0) msgs.push('대출 금리를 넣지 않아 심사 금리는 스트레스 금리만으로, 월 상환액은 무이자로 계산했다.');
          if (region === 'local') msgs.push('지방 주담대는 스트레스 금리 0.75%p와 2단계 적용비율(혼합형 60·40·20%, 주기형 30·20·10%)을 ' + String(P.stress_local_until).replace(/-/g, '.') + '까지 쓴다 (금융위 공고 제2026-362호). 이후 3단계로 돌아가면 DSR 한도가 줄어든다.');
          if (ratio === 0) msgs.push('고정기간이 만기의 70% 이상이라 스트레스 금리를 붙이지 않았다 (3단계 시행방안 표3).');
          if (houses === 'none' && region !== 'local') msgs.push('수도권·규제지역 주택구입 주담대는 6개월 내 전입 의무가 있다 (6.27 대책).');
          msgs.push('은행별 시세 산정·소득 인정·신용도·자체 총량 관리에 따라 실제 한도는 이보다 작을 수 있다.');
          warn.innerHTML = msgs.join('<br />');
          warn.hidden = msgs.length === 0;
        }

        // 금액 칸: 숫자만 남기고 천 단위 콤마
        root.querySelectorAll('[data-type="won"]').forEach(function (el) {
          el.addEventListener('input', function () {
            var raw = el.value.replace(/[^\d]/g, '').replace(/^0+(?=\d)/, '');
            el.value = raw ? raw.replace(/\B(?=(\d{3})+(?!\d))/g, ',') : '';
            calc();
          });
        });
        // 금리 칸: 숫자와 소수점 하나만
        root.querySelectorAll('[data-type="pct"]').forEach(function (el) {
          el.addEventListener('input', function () {
            var raw = el.value.replace(/[^\d.]/g, '');
            var parts = raw.split('.');
            el.value = parts.length > 1 ? parts[0] + '.' + parts.slice(1).join('').slice(0, 2) : raw;
            calc();
          });
        });
        // 연 수 칸: 정수만
        root.querySelectorAll('[data-type="num"]').forEach(function (el) {
          el.addEventListener('input', function () {
            el.value = el.value.replace(/[^\d]/g, '').slice(0, 2);
            calc();
          });
        });
        root.querySelectorAll('[data-type="select"], [data-type="check"]').forEach(function (el) {
          el.addEventListener('input', calc); el.addEventListener('change', calc);
        });

        // 공유 주소 (기획서 3번)
        var sh = root.querySelector('[data-share]');
        if (sh) {
          var u = encodeURIComponent(sh.dataset.url), t = encodeURIComponent(sh.dataset.title);
          sh.querySelector('[data-share-fb]').href = 'https://www.facebook.com/sharer/sharer.php?u=' + u;
          sh.querySelector('[data-share-x]').href = 'https://twitter.com/intent/tweet?url=' + u + '&text=' + t;
          sh.querySelector('[data-share-naver]').href = 'https://share.naver.com/web/shareView?url=' + u + '&title=' + t;
          sh.querySelector('[data-share-band]').href = 'https://band.us/plugin/share?body=' + t + '%20' + u + '&route=' + u;
        }
