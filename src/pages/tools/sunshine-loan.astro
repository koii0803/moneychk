  /* 판정표: 상품 | 자격(+걸린 조건) | 한도 | 금리 — 4열. 조건 산식은 표 아래 한 줄씩 */
  .answer { margin: 0 0 14px; font-size: clamp(19px, 2.6vw, 24px); font-weight: 800; letter-spacing: -.03em; line-height: 1.3; background: linear-gradient(100deg, var(--ink) 0%, var(--ink) 55%, var(--gold-ink)); -webkit-background-clip: text; background-clip: text; color: transparent; }
