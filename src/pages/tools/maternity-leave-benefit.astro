---
import Base from '../../layouts/Base.astro';
import { SITE, CATEGORIES } from '../../config/site';
import calc from '../../data/calcs/maternity-leave-benefit.json';
import tools from '../../data/tools.json';

// 계산기 한 장 = JSON 한 장(src/data/calcs/<slug>.json). 이 페이지는 그 JSON을 읽어 그린다.
// 휴가 일수·상한·하한은 JSON params(연도 키)에서만 온다. 코드에 숫자를 박지 않는다.
const cat = CATEGORIES[calc.cat as keyof typeof CATEGORIES];
const pageUrl = `${SITE.url}/tools/${calc.slug}`;
const byStep = (n: number) => calc.inputs.filter((i) => i.step === n);
const related = calc.related_calcs.map((r) => {
  const t = r.tool_no ? tools.find((x) => x.no === r.tool_no) : undefined;
  return { ...r, href: r.href || t?.href || '' };
});
const basisYear = calc.basis_date.slice(0, 4);
const P = calc.params as Record<string, unknown>;
const params = P[basisYear] as Record<string, unknown>;
const stepTitle = ['', '통상임금', '회사 규모 · 출산 유형', '배우자 출산휴가'];
const stepSub = ['', '휴가 시작일 기준 세전 월액', '우선지원대상기업 여부 · 다태아', '선택 · 20일 급여'];
const mainSteps = calc.steps.filter((s) => !s.spouse);
const spouseSteps = calc.steps.filter((s) => s.spouse);
---

<Base title={calc.name} description={calc.description}>
  <div class="calc" data-calc>
    <header class="hero">
      <span class="eyebrow">모의계산기 · {cat.short}</span>
      <h1>{calc.name}</h1>
      <p class="lede">{calc.lede}</p>
      <div class="stamps">
        <span class="stamp gold"><b>{calc.basis_label}</b></span>
        <span class="stamp">확인일 <b>{calc.basis_date.replace(/-/g, '.')}</b></span>
        <span class="stamp">산식 <b>고용보험법 제76조 · 2026년 상한액 고시</b></span>
      </div>
    </header>

    <div class="cols">
      <div class="in">
        {[1, 2, 3].map((n) => (
          <section class="card" id={`s${n}`}>
            <div class="card-h">
              <span class="num">STEP {n}</span>
              <h2>{stepTitle[n]}</h2>
              <p>{stepSub[n]}</p>
            </div>
            <div class="grid">
              {byStep(n).map((f) => (
                <div class="field" data-field={f.id} hidden={f.id === 'spouse_wage' || f.id === 'spouse_size'}>
                  {f.type === 'check' ? (
                    <label class="toggle">
                      <input type="checkbox" id={`f-${f.id}`} data-in={f.id} data-type="check" />
                      <span>{f.label}<small>{f.help}</small></span>
                    </label>
                  ) : (
                    <>
                      <label for={`f-${f.id}`}>{f.label}{f.optional && <small> (선택)</small>}</label>
                      <div class="inp">
                        {f.type === 'select' ? (
                          <select id={`f-${f.id}`} data-in={f.id} data-type="select">
                            {(f.options || []).map((o) => <option value={o.value}>{o.label}</option>)}
                          </select>
                        ) : (
                          <input type="text" inputmode="numeric" id={`f-${f.id}`} data-in={f.id} data-type="won" placeholder="0" autocomplete="off" />
                        )}
                        {f.type === 'won' && <span class="unit">원</span>}
                      </div>
                      {f.help && <p class="sub">{f.help}</p>}
                    </>
                  )}
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="out">
        <section class="card result" id="result" aria-live="polite">
          <div class="card-h"><span class="num">결과</span><h2>출산휴가급여 계산표</h2><p>{calc.basis_label}</p></div>
          <p class="answer" data-answer>월 통상임금과 회사 규모를 넣으면 고용보험 지급분과 회사 지급분이 나온다.</p>
          <div class="tbl-wrap">
            <table>
              <thead><tr><th>항목</th><th class="r">고용보험</th><th class="r">회사</th><th class="f">산식</th></tr></thead>
              <tbody>
                {mainSteps.map((s) => (
                  <tr class={s.total ? 'total' : s.subtotal ? 'subtotal' : ''} data-row={s.id}>
                    <td><span class="no">({s.no})</span> <span data-lab={s.id}>{s.label}</span><small class="tag" data-val={`${s.id}_tag`}></small><small class="f2">{s.formula}</small></td>
                    {s.kind === 'pair' ? (
                      <>
                        <td class="r"><b data-val={`${s.id}_gov`}>—</b></td>
                        <td class="r"><b data-val={`${s.id}_co`}>—</b></td>
                      </>
                    ) : (
                      <td class="r" colspan="2"><b data-val={s.id}>—</b></td>
                    )}
                    <td class="f"><code>{s.formula}</code></td>
                  </tr>
                ))}
              </tbody>
              <tbody data-spouse hidden>
                {spouseSteps.map((s) => (
                  <tr class={s.total ? 'total' : ''} data-row={s.id}>
                    <td><span class="no">({s.no})</span> <span data-lab={s.id}>{s.label}</span><small class="tag" data-val={`${s.id}_tag`}></small><small class="f2">{s.formula}</small></td>
                    {s.kind === 'pair' ? (
                      <>
                        <td class="r"><b data-val={`${s.id}_gov`}>—</b></td>
                        <td class="r"><b data-val={`${s.id}_co`}>—</b></td>
                      </>
                    ) : (
                      <td class="r" colspan="2"><b data-val={s.id}>—</b></td>
                    )}
                    <td class="f"><code>{s.formula}</code></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="hint" data-warn hidden></p>
        </section>
      </div>
    </div>

    <section class="card slim">
      <div class="card-h"><span class="num">관련</span><h2>같이 쓰는 계산기</h2></div>
      <div class="rel">
        {related.map((r) => r.href
          ? <a class="rel-btn" href={r.href}>{r.name}</a>
          : <span class="rel-btn off" aria-disabled="true">{r.name} <small>준비 중</small></span>)}
      </div>
      <div class="share" data-share data-url={pageUrl} data-title={`${calc.name} — ${SITE.name}`}>
        <span class="share-l">공유</span>
        <a class="share-btn" data-share-fb href="#" target="_blank" rel="noopener">페이스북</a>
        <a class="share-btn" data-share-x href="#" target="_blank" rel="noopener">X</a>
        <a class="share-btn" data-share-naver href="#" target="_blank" rel="noopener">네이버 블로그</a>
        <a class="share-btn" data-share-band href="#" target="_blank" rel="noopener">밴드</a>
      </div>
    </section>

    <div class="ad-slot" data-slot="in-article"></div>

    <section class="card slim">
      <div class="card-h"><span class="num">※</span><h2>산식과 근거</h2><p>확인일 {calc.basis_date.replace(/-/g, '.')}</p></div>
      <ol class="notes">
        {calc.notes.map((n) => <li>{n}</li>)}
      </ol>
      <p class="src">
        {calc.law.map((l) => <span>· <a href={l.url} target="_blank" rel="noopener">{l.name}</a> <em>{l.ver}</em><br /></span>)}
      </p>
    </section>

    <section class="card slim">
      <div class="card-h"><span class="num">이력</span><h2>기준값 이력</h2><p>바뀌면 줄이 늘어난다</p></div>
      <div class="tbl-wrap">
        <table class="hist">
          <thead><tr><th>날짜</th><th>기준값</th><th class="r">값</th><th>출처</th></tr></thead>
          <tbody>
            {calc.history.map((h) => (
              <tr><td>{h.date.replace(/-/g, '.')}</td><td><code>{h.param}</code></td><td class="r"><b>{h.value}</b></td><td>{h.src}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <p class="foot-note">{calc.disclaimer}<br />입력값은 이 브라우저 안에서만 계산되며 서버로 보내지 않는다.</p>
  </div>

  <script type="application/json" id="calc-params" set:html={JSON.stringify(params)} />
  <script is:inline>
    // 순수 JS. 입력이 바뀌면 즉시 다시 계산한다. 산식은 JSON steps.formula와 같은 순서.
    // 구간마다 고용보험 = min(1일 통상임금, 1일 상한) × 일수, 회사 = 유급 구간 통상임금 − 고용보험 (이후 구간은 0).
    (function () {
      function init() {
        var root = document.querySelector('[data-calc]');
        if (!root || root.dataset.ready) return;
        root.dataset.ready = '1';
        var P = JSON.parse(document.getElementById('calc-params').textContent);

        var fmt = function (n) {
          if (n === null || n === undefined || isNaN(n)) return '—';
          return String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        };
        var won = function (n) { return n === null ? '—' : fmt(n) + '원'; };
        var man = function (n) { return (n / 10000) % 1 === 0 ? fmt(n / 10000) + '만원' : won(n); };
        var num = function (el) { return Number((el.value || '').replace(/[^\d]/g, '')) || 0; };

        var I = {};
        root.querySelectorAll('[data-in]').forEach(function (el) { I[el.dataset.in] = el; });
        var V = {};
        root.querySelectorAll('[data-val]').forEach(function (el) { V[el.dataset.val] = el; });
        var L = {};
        root.querySelectorAll('[data-lab]').forEach(function (el) { L[el.dataset.lab] = el; });
        var answer = root.querySelector('[data-answer]');
        var warn = root.querySelector('[data-warn]');
        var spouseBody = root.querySelector('[data-spouse]');
        var spouseWageField = root.querySelector('[data-field="spouse_wage"]');
        var spouseSizeField = root.querySelector('[data-field="spouse_size"]');

        function set(id, text) { if (V[id]) V[id].textContent = text; }
        function lab(id, text) { if (L[id]) L[id].textContent = text; }

        function calc() {
          var wageIn = num(I.wage);
          var size = I.size.value, kind = I.kind.value;
          var K = P.kinds[kind];
          var useSpouse = I.spouse.checked;
          var spWageIn = num(I.spouse_wage), spSize = I.spouse_size.value;
          var msgs = [];
          spouseWageField.hidden = !useSpouse;
          spouseSizeField.hidden = !useSpouse;
          spouseBody.hidden = !useSpouse;
          Object.keys(V).forEach(function (k) { set(k, /_tag$/.test(k) ? '' : '—'); });

          // 구간 이름은 출산 유형에 따라 바뀐다
          var d1 = K.paid_days, d2 = K.total_days - K.paid_days;
          lab('seg1', '1~' + d1 + '일 (유급 구간)');
          lab('seg2', (d1 + 1) + '~' + K.total_days + '일 (이후 구간)');
          set('days', K.total_days + '일');
          set('days_tag', K.label + ' · 유급 ' + d1 + '일 + 이후 ' + d2 + '일');

          if (!wageIn) {
            answer.textContent = '월 통상임금과 회사 규모를 넣으면 고용보험 지급분과 회사 지급분이 나온다.';
            warn.hidden = true; return;
          }

          // (1) 적용 통상임금: 최저임금 월 환산액이 하한
          var wage = Math.max(wageIn, P.min_wage_month);
          var floored = wageIn < P.min_wage_month;
          set('wage', won(wage));
          set('wage_tag', floored ? '하한 적용 · 입력 ' + won(wageIn) : '');

          var dayWage = wage / P.days_per_month;
          // 하한(최저임금)은 고용보험 급여에만 걸린다. 회사 유급 의무는 실제 통상임금이다
          // (고용보험법 시행령 제101조 제2호 vs 근로기준법 제74조 제4항)
          var dayWageCo = wageIn / P.days_per_month;
          var dayCap = K.cap_total / K.total_days;
          var capped = dayWage > dayCap;
          var priority = size === 'priority';

          // (3) 유급 구간: 우선지원은 고용보험이 상한까지, 나머지는 회사. 대규모는 회사 전액
          var seg1Gov = priority ? Math.min(dayWage, dayCap) * d1 : 0;
          var seg1Co = Math.max(0, dayWageCo * d1 - seg1Gov);
          // (4) 이후 구간: 규모 무관하게 고용보험이 상한까지, 회사 의무 없음
          var seg2Gov = Math.min(dayWage, dayCap) * d2;
          var seg2Co = 0;
          var govSum = seg1Gov + seg2Gov, coSum = seg1Co + seg2Co, total = govSum + coSum;

          set('seg1_gov', priority ? won(Math.round(seg1Gov)) : '0원');
          set('seg1_co', won(Math.round(seg1Co)));
          set('seg1_tag', priority
            ? (capped ? '고용보험 30일 기준 상한 ' + man(P.cap_per_month) + ' · 차액은 회사' : '고용보험이 통상임금 전액')
            : '대규모기업 · 회사가 통상임금 전액');
          set('seg2_gov', won(Math.round(seg2Gov)));
          set('seg2_co', '0원');
          set('seg2_tag', (capped ? '상한 ' + man(P.cap_per_month) + '/30일 적용 · ' : '') + '회사 지급 의무 없음');
          set('sum_gov', won(Math.round(govSum)));
          set('sum_co', won(Math.round(coSum)));
          set('total', won(Math.round(total)));
          set('total_tag', K.total_days + '일 · 통상임금 ' + won(Math.round(dayWage * K.total_days)) + (capped ? ' 중 ' + won(Math.round(dayWage * K.total_days - total)) + '은 못 받음' : ''));

          answer.textContent = '출산전후휴가 ' + K.total_days + '일 급여는 총 ' + won(Math.round(total)) + '이다 (고용보험 ' + won(Math.round(govSum)) + ' + 회사 ' + won(Math.round(coSum)) + ').';

          if (floored) msgs.push('월 통상임금이 2026년 최저임금 월 환산액 ' + won(P.min_wage_month) + '(시급 ' + fmt(P.min_wage_hourly) + '원 × ' + P.month_hours + '시간)보다 적어 그 값으로 계산했다 (시행령 제101조 제2호).');
          if (capped) msgs.push('1일 통상임금 ' + won(Math.round(dayWage)) + '이 고용보험 1일 상한 ' + won(Math.round(dayCap)) + '(' + K.total_days + '일 ' + man(K.cap_total) + ' ÷ ' + K.total_days + ')을 넘어 고용보험은 상한액으로 계산했다. 마지막 ' + d2 + '일은 회사 지급 의무가 없어 차액 ' + won(Math.round((dayWage - dayCap) * d2)) + '은 받지 못한다 (근로기준법 제74조 제4항).');
          if (!priority) msgs.push('대규모기업은 최초 ' + d1 + '일 통상임금을 회사가 전액 주고, 고용보험은 ' + (d1 + 1) + '일째부터 ' + d2 + '일만 준다 (고용보험법 제76조 제1항 제1호). 급여 신청은 ' + d1 + '일이 지난 날부터 할 수 있다.');
          if (floored && !priority) msgs.push('하한은 고용보험 급여에만 걸린다 (시행령 제101조 제2호). 대규모기업이 최초 ' + d1 + '일에 줘야 하는 금액은 실제 통상임금 ' + won(wageIn) + ' 기준인 ' + won(Math.round(dayWageCo * d1)) + '이다 (근로기준법 제74조 제4항).');
          if (priority) msgs.push('우선지원대상기업은 회사가 통상임금을 먼저 다 주고 고용보험 급여를 대신 받는 대위신청도 가능하다. 어느 쪽이든 근로자 총 수령액은 같다.');

          // (7)~(9) 배우자 출산휴가 20일
          if (useSpouse) {
            if (!spWageIn) {
              set('sp_day', '—');
              msgs.push('배우자 월 통상임금을 넣으면 배우자 출산휴가 20일 급여가 나온다.');
            } else {
              var spWage = Math.max(spWageIn, P.min_wage_month);
              var spDay = spWage / P.month_hours * P.day_hours;
              var spTotalWage = spDay * P.spouse_days;
              var spPriority = spSize === 'priority';
              var spGov = spPriority ? Math.min(spTotalWage, P.spouse_cap_total) : 0;
              // 회사 유급 의무는 실제 통상임금 기준 (하한은 고용보험 급여에만 걸린다)
              var spCo = Math.max(0, spWageIn / P.month_hours * P.day_hours * P.spouse_days - spGov);
              var spCapped = spPriority && spTotalWage > P.spouse_cap_total;
              set('sp_day', won(Math.round(spDay)));
              set('sp_day_tag', (spWageIn < P.min_wage_month ? '하한 적용 · ' : '') + won(spWage) + ' ÷ ' + P.month_hours + ' × ' + P.day_hours);
              set('sp_seg_gov', spPriority ? won(Math.round(spGov)) : '0원');
              set('sp_seg_co', won(Math.round(spCo)));
              set('sp_seg_tag', spPriority
                ? (spCapped ? '20일 상한 ' + won(P.spouse_cap_total) + ' · 차액은 회사' : '고용보험이 통상임금 전액')
                : '대규모기업 · 회사가 20일 유급');
              set('sp_total', won(Math.round(spGov + spCo)));
              set('sp_total_tag', '20일 · 부부 합계 ' + won(Math.round(total + spGov + spCo)));
              msgs.push('배우자 출산휴가는 1일 통상임금을 월 통상임금 ÷ ' + P.month_hours + '시간 × ' + P.day_hours + '시간(주 40시간 기준)으로 계산했다. 배우자 회사가 우선지원대상기업일 때만 고용보험이 주고, 신청은 배우자 본인이 휴가 시작 1개월 뒤부터 12개월 이내에 한다.');
            }
          }
          warn.innerHTML = msgs.join('<br />');
          warn.hidden = msgs.length === 0;
        }

        // 금액 칸: 숫자만 남기고 천 단위 콤마
        root.querySelectorAll('[data-type="won"]').forEach(function (el) {
          el.addEventListener('input', function () {
            var raw = el.value.replace(/[^\d]/g, '').replace(/^0+(?=\d)/, '');
            el.value = raw ? raw.replace(/\B(?=(\d{3})+(?!\d))/g, ',') : '';
            calc();
          });
        });
        root.querySelectorAll('[data-type="select"], [data-type="check"]').forEach(function (el) {
          el.addEventListener('input', calc); el.addEventListener('change', calc);
        });

        // 공유 주소 (기획서 3번)
        var sh = root.querySelector('[data-share]');
        if (sh) {
          var u = encodeURIComponent(sh.dataset.url), t = encodeURIComponent(sh.dataset.title);
          sh.querySelector('[data-share-fb]').href = 'https://www.facebook.com/sharer/sharer.php?u=' + u;
          sh.querySelector('[data-share-x]').href = 'https://twitter.com/intent/tweet?url=' + u + '&text=' + t;
          sh.querySelector('[data-share-naver]').href = 'https://share.naver.com/web/shareView?url=' + u + '&title=' + t;
          sh.querySelector('[data-share-band]').href = 'https://band.us/plugin/share?body=' + t + '%20' + u + '&route=' + u;
        }
        calc();
      }
      document.addEventListener('astro:page-load', init);
      if (document.readyState !== 'loading') init(); else document.addEventListener('DOMContentLoaded', init);
    })();
  </script>
</Base>

<style>
  /* 계산기 무드: 퇴직금 계산기(severance-pay.astro)와 같은 유리 카드·금색 강조 토큰을 이 페이지 안에서만 정의 */
  .calc {
    --gold: #f5b544; --gold-ink: #ffd27a; --gold-soft: rgba(245, 181, 68, .12);
    --rose: #ff6b7a; --rose-soft: rgba(255, 107, 122, .12);
    --hair-2: rgba(255, 255, 255, .14);
