---
import Base from '../../layouts/Base.astro';
import { SITE, CATEGORIES } from '../../config/site';
import calc from '../../data/calcs/unemployment-benefit.json';
import tools from '../../data/tools.json';

// 계산기 한 장 = JSON 한 장(src/data/calcs/<slug>.json). 이 페이지는 그 JSON을 읽어 그린다.
// 지급률·상한·최저임금·소정급여일수표는 JSON params(연도 키)에서만 온다. 코드에 숫자를 박지 않는다.
const cat = CATEGORIES[calc.cat as keyof typeof CATEGORIES];
const pageUrl = `${SITE.url}/tools/${calc.slug}`;
const byStep = (n: number) => calc.inputs.filter((i) => i.step === n);
const related = calc.related_calcs.map((r) => {
  const t = r.tool_no ? tools.find((x) => x.no === r.tool_no) : undefined;
  return { ...r, href: r.href || t?.href || '' };
});
const basisYear = calc.basis_date.slice(0, 4);
const P = calc.params as Record<string, unknown>;
// 상·하한·최저임금은 이직일 당시 기준으로 정해진다. 그래서 한 해만 넘기지 않고 연도 블록을 전부 넘기고,
// 화면에서 퇴직일(이직일)의 연도로 고른다. 퇴직일이 없으면 basis 연도.
const years = Object.fromEntries(Object.entries(P).filter(([k]) => /^\d{4}$/.test(k)));
const params = { basis: basisYear, years };
const stepTitle = ['', '퇴직 전 임금', '나이 · 가입기간', '선택 사항'];
const stepSub = ['', '세전 3개월 임금총액', '소정급여일수 결정', '장애인 · 단시간'];
---

<Base title={calc.name} description={calc.description}>
  <div class="calc" data-calc>
    <header class="hero">
      <span class="eyebrow">모의계산기 · {cat.short}</span>
      <h1>{calc.name}</h1>
      <p class="lede">{calc.lede}</p>
      <div class="stamps">
        <span class="stamp gold"><b>{calc.basis_label}</b></span>
        <span class="stamp">확인일 <b>{calc.basis_date.replace(/-/g, '.')}</b></span>
        <span class="stamp">산식 <b>고용보험법 제46조 · [별표 1]</b></span>
      </div>
    </header>

    <div class="cols">
      <div class="in">
        {[1, 2, 3].map((n) => (
          <section class="card" id={`s${n}`}>
            <div class="card-h">
              <span class="num">STEP {n}</span>
              <h2>{stepTitle[n]}</h2>
              <p>{stepSub[n]}</p>
            </div>
            <div class="grid">
              {byStep(n).map((f) => (
                <div class="field" data-field={f.id}>
                  {f.type === 'check' ? (
                    <label class="toggle">
                      <input type="checkbox" id={`f-${f.id}`} data-in={f.id} data-type="check" />
                      <span>{f.label}<small>{f.help}</small></span>
                    </label>
                  ) : (
                    <>
                      <label for={`f-${f.id}`}>{f.label}{f.optional && <small> (선택)</small>}</label>
                      <div class="inp">
                        {f.type === 'select' ? (
                          <select id={`f-${f.id}`} data-in={f.id} data-type="select">
                            {(f.options || []).map((o) => <option value={o.value}>{o.label}</option>)}
                          </select>
                        ) : f.type === 'date' ? (
                          <input type="date" id={`f-${f.id}`} data-in={f.id} data-type="date" />
                        ) : f.type === 'num' ? (
                          <input type="text" inputmode="numeric" id={`f-${f.id}`} data-in={f.id} data-type="num" placeholder="0" autocomplete="off" />
                        ) : (
                          <input type="text" inputmode="numeric" id={`f-${f.id}`} data-in={f.id} data-type="won" placeholder="0" autocomplete="off" />
                        )}
                        {f.type === 'won' && <span class="unit">원</span>}
                        {f.type === 'num' && <span class="unit">{f.unit}</span>}
                      </div>
                      {f.help && <p class="sub">{f.help}</p>}
                    </>
                  )}
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="out">
        <section class="card result" id="result" aria-live="polite">
          <div class="card-h"><span class="num">결과</span><h2>실업급여 계산표</h2><p>{calc.basis_label}</p></div>
          <p class="answer" data-answer>퇴직 전 3개월 임금총액과 나이·가입기간을 넣으면 실업급여가 나온다.</p>
          <div class="tbl-wrap">
            <table>
              <thead><tr><th>항목</th><th class="r">금액</th><th class="f">산식</th></tr></thead>
              <tbody>
                {calc.steps.map((s) => (
                  <tr class={s.total ? 'total' : ''} data-row={s.id}>
                    <td><span class="no">({s.no})</span> {s.label}<small class="tag" data-val={`${s.id}_sub`}></small><small class="f2">{s.formula}</small></td>
                    <td class="r"><b data-val={s.id}>—</b></td>
                    <td class="f"><code>{s.formula}</code></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="hint" data-warn hidden></p>
        </section>
      </div>
    </div>

    <section class="card slim">
      <div class="card-h"><span class="num">관련</span><h2>같이 쓰는 계산기</h2></div>
      <div class="rel">
        {related.map((r) => r.href
          ? <a class="rel-btn" href={r.href}>{r.name}</a>
          : <span class="rel-btn off" aria-disabled="true">{r.name} <small>준비 중</small></span>)}
      </div>
      <div class="share" data-share data-url={pageUrl} data-title={`${calc.name} — ${SITE.name}`}>
        <span class="share-l">공유</span>
        <a class="share-btn" data-share-fb href="#" target="_blank" rel="noopener">페이스북</a>
        <a class="share-btn" data-share-x href="#" target="_blank" rel="noopener">X</a>
        <a class="share-btn" data-share-naver href="#" target="_blank" rel="noopener">네이버 블로그</a>
        <a class="share-btn" data-share-band href="#" target="_blank" rel="noopener">밴드</a>
      </div>
    </section>

    <div class="ad-slot" data-slot="in-article"></div>

    <section class="card slim">
      <div class="card-h"><span class="num">※</span><h2>산식과 근거</h2><p>확인일 {calc.basis_date.replace(/-/g, '.')}</p></div>
      <ol class="notes">
        {calc.notes.map((n) => <li>{n}</li>)}
      </ol>
      <p class="src">
        {calc.law.map((l) => <span>· <a href={l.url} target="_blank" rel="noopener">{l.name}</a> <em>{l.ver}</em><br /></span>)}
      </p>
    </section>

    <section class="card slim">
      <div class="card-h"><span class="num">이력</span><h2>기준값 이력</h2><p>바뀌면 줄이 늘어난다</p></div>
      <div class="tbl-wrap">
        <table class="hist">
          <thead><tr><th>날짜</th><th>기준값</th><th class="r">값</th><th>출처</th></tr></thead>
          <tbody>
            {calc.history.map((h) => (
              <tr><td>{h.date.replace(/-/g, '.')}</td><td><code>{h.param}</code></td><td class="r"><b>{h.value}</b></td><td>{h.src}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <p class="foot-note">{calc.disclaimer}<br />입력값은 이 브라우저 안에서만 계산되며 서버로 보내지 않는다.</p>
  </div>

  <script type="application/json" id="calc-params" set:html={JSON.stringify(params)} />
  <script is:inline>
    // 순수 JS. 입력이 바뀌면 즉시 다시 계산한다. 산식은 JSON steps.formula와 같은 순서.
    // (1) 평균임금 = 3개월 임금 ÷ 총 일수 → (2) × 60% → (3) 상한(base_day_cap × 60%)·하한(최저시급 × 소정근로시간 × 80%) 사이로
    // → (4) [별표 1] 일수 → (5) 총액 = (3) × (4) → (6) 월 환산 = (3) × 30
    (function () {
      function init() {
        var root = document.querySelector('[data-calc]');
        if (!root || root.dataset.ready) return;
        root.dataset.ready = '1';
        var Y = JSON.parse(document.getElementById('calc-params').textContent);
        var DAY = 86400000;

        var fmt = function (n, d) {
          if (n === null || n === undefined || isNaN(n)) return '—';
          d = d || 0;
          var s = (d ? n.toFixed(d) : String(Math.round(n))).split('.');
          s[0] = s[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
          return s.join('.');
        };
        var won = function (n, d) { return n === null ? '—' : fmt(n, d) + '원'; };
        var num = function (el) { return Number((el.value || '').replace(/[^\d]/g, '')) || 0; };
        var date = function (el) {
          var v = el.value; if (!/^\d{4}-\d{2}-\d{2}$/.test(v)) return null;
          var p = v.split('-').map(Number); var t = Date.UTC(p[0], p[1] - 1, p[2]);
          var dd = new Date(t); return dd.getUTCMonth() === p[1] - 1 ? t : null;
        };
        // 퇴직일에서 3개월 전 같은 날. 그 달에 그 날짜가 없으면 말일 (예: 5.31 → 2.28). 퇴직금 계산기와 같은 방식
        var minus3m = function (t) {
          var d = new Date(t); var y = d.getUTCFullYear(), m = d.getUTCMonth() - 3, day = d.getUTCDate();
          var last = new Date(Date.UTC(y, m + 1, 0)).getUTCDate();
          return Date.UTC(y, m, Math.min(day, last));
        };

        var I = {};
        root.querySelectorAll('[data-in]').forEach(function (el) { I[el.dataset.in] = el; });
        var V = {};
        root.querySelectorAll('[data-val]').forEach(function (el) { V[el.dataset.val] = el; });
        var answer = root.querySelector('[data-answer]');
        var warn = root.querySelector('[data-warn]');
        var IDLE = '퇴직 전 3개월 임금총액과 나이·가입기간을 넣으면 실업급여가 나온다.';

        // 이직일 당시 기준으로 적용 연도를 고른다. 가진 연도 밖이면 가장 가까운 연도로 맞춘다.
        var YEARS = Object.keys(Y.years).sort();
        var pickYear = function (t) {
          if (t === null) return Y.basis;
          var y = String(new Date(t).getUTCFullYear());
          if (Y.years[y]) return y;
          return y < YEARS[0] ? YEARS[0] : YEARS[YEARS.length - 1];
        };

        function set(id, text) { if (V[id]) V[id].textContent = text; }
        function calc() {
          var wage3 = num(I.wage3);
          var leave = date(I.leave);
          var pdIn = num(I.period_days);
          var ageRaw = (I.age.value || '').replace(/[^\d]/g, '');
          var age = ageRaw === '' ? null : Number(ageRaw);
          var band = Number(I.insured.value) || 0;
          var disabled = I.disabled.checked;
          var ord = num(I.ordinary);
          var year = pickYear(leave);
          var P = Y.years[year];
          var hours = Number(I.hours.value) || P.default_hours;
          var FLOOR = P.min_wage_hour * hours * P.floor_rate / 100; // 최저구직급여일액
          var CAP = P.base_day_cap * P.benefit_rate / 100; // 구직급여 일액 상한
          var msgs = [];
          Object.keys(V).forEach(function (k) { set(k, /_sub$/.test(k) ? '' : '—'); });

          // 3개월 총 일수: 퇴직일 > 직접 입력 > 기본값
          var periodDays, pdHow;
          if (leave) { periodDays = Math.round((leave - minus3m(leave)) / DAY); pdHow = '퇴직일 기준 ' + periodDays + '일'; }
          else if (pdIn > 0) { periodDays = pdIn; pdHow = '직접 입력 ' + periodDays + '일'; }
          else { periodDays = P.default_period_days; pdHow = '기본값 ' + periodDays + '일'; }

          // 소정급여일수는 나이·가입기간만으로 먼저 정한다 (임금이 없어도 보여준다)
          var over = disabled || (age !== null && age >= P.age_threshold);
          var days = null, daysTag = '';
          if (age !== null || disabled) {
            days = (over ? P.days_table.over : P.days_table.under)[band];
            daysTag = (disabled ? '장애인 → ' + P.age_threshold + '세 이상 줄' : (over ? P.age_threshold + '세 이상' : P.age_threshold + '세 미만')) + ' · ' + P.band_labels[band];
            set('days', fmt(days) + '일');
            set('days_sub', daysTag);
          }

          // 3개월 임금이 없어도 1일 통상임금만 있으면 기초일액이 잡힌다 (제45조 제2항)
          if (!wage3 && !ord) {
            answer.textContent = IDLE;
            warn.hidden = true; return;
          }

          var avg = wage3 / periodDays;
          var basis = Math.max(avg, ord); // 제45조 제2항: 평균임금이 통상임금보다 적으면 통상임금
          var useOrd = ord > avg;
          var raw = basis * P.benefit_rate / 100;
          var daily = Math.min(Math.max(raw, FLOOR), CAP);
          var how = raw > CAP ? '상한' : raw < FLOOR ? '하한' : '';

          set('avg_wage', won(avg, 2));
          set('avg_wage_sub', won(wage3) + ' ÷ ' + pdHow);
          set('basis_day', won(basis, 2));
          set('basis_day_sub', ord ? (useOrd ? '통상임금이 더 커서 통상임금' : '평균임금이 더 커서 평균임금') : '통상임금 미입력 — 평균임금 그대로');
          set('daily_raw', won(raw, 2));
          set('daily', won(Math.round(daily)));
          set('daily_sub', how
            ? (how === '상한' ? '상한 ' + won(CAP) + ' 적용' : '하한 ' + won(FLOOR) + ' 적용 (' + fmt(P.min_wage_hour) + '원 × ' + hours + '시간 × ' + P.floor_rate + '%)')
            : '상한 ' + won(CAP) + ' · 하한 ' + won(FLOOR) + ' 사이 — 그대로');
          set('monthly', won(Math.round(daily) * P.month_days));

          if (days === null) {
            answer.textContent = '구직급여 일액은 ' + won(Math.round(daily)) + '이다. 퇴직 당시 나이를 넣으면 소정급여일수와 총액이 나온다.';
          } else {
            var total = Math.round(daily) * days;
            set('total', won(total));
            set('total_sub', won(Math.round(daily)) + ' × ' + days + '일');
            answer.textContent = '예상 실업급여 총액은 ' + won(total) + '이다 (하루 ' + won(Math.round(daily)) + ' × ' + days + '일).';
          }

          if (leave) msgs.push('이직일이 ' + year + '년이라 ' + year + '년 기준(상한 ' + won(CAP) + ' · 하한 ' + won(FLOOR) + ')으로 계산했다. 상·하한과 최저임금은 이직일 당시 기준으로 정해진다 (제45조 제4항·제5항).');
          else msgs.push('퇴직일을 안 넣어 ' + Y.basis + '년 기준(상한 ' + won(CAP) + ' · 하한 ' + won(FLOOR) + ')으로 계산했다. ' + YEARS[0] + '년에 그만뒀으면 퇴직일을 넣어야 그해 기준으로 나온다.');
          if (useOrd) msgs.push('1일 통상임금(' + won(ord) + ')이 1일 평균임금(' + won(avg, 2) + ')보다 커서 통상임금을 기초일액으로 삼았다 (제45조 제2항). 이직 당시 일용근로자였으면 이 규정은 적용되지 않는다.');
          if (how === '상한') msgs.push('기초일액의 ' + P.benefit_rate + '%(' + won(raw, 2) + ')가 상한 ' + won(CAP) + '을 넘어 상한액으로 계산했다 (시행령 제68조 제1항: 기초일액 상한 ' + fmt(P.base_day_cap) + '원 × ' + P.benefit_rate + '%).');
          if (how === '하한') msgs.push('기초일액의 ' + P.benefit_rate + '%(' + won(raw, 2) + ')가 하한 ' + won(FLOOR) + '보다 적어 하한액으로 계산했다 (제46조 제2항: 최저임금 ' + fmt(P.min_wage_hour) + '원 × ' + hours + '시간 × ' + P.floor_rate + '%).');
          if (hours !== P.default_hours) msgs.push('1일 소정근로시간 ' + hours + '시간 기준 하한이다. 고용24 모의계산은 8시간 기준으로 보여주므로 값이 다를 수 있다.');
          if (!leave && !pdIn) msgs.push('퇴직일이나 3개월 총 일수를 안 넣어 ' + P.default_period_days + '일로 나눴다. 퇴직일을 넣으면 정확한 일수(90~92일)로 계산한다.');
          if (age !== null && !disabled && age >= P.age_threshold) msgs.push('이직일 현재 ' + P.age_threshold + '세 이상이라 [별표 1] 아래 줄(최대 270일)을 적용했다.');
          msgs.push('자발적 퇴사 등 제58조 사유는 대상이 아니고, 이직 전 18개월 중 피보험 단위기간 ' + P.min_insured_days + '일 이상이어야 한다 (제40조). 실제 지급은 고용센터 수급자격 인정 뒤, 실업 신고일부터 ' + P.waiting_days + '일 대기기간 다음부터다 (제49조).');
          warn.innerHTML = msgs.join('<br />');
          warn.hidden = msgs.length === 0;
        }

        // 금액·숫자 칸: 숫자만 남기고 (금액은) 천 단위 콤마
        root.querySelectorAll('[data-type="won"], [data-type="num"]').forEach(function (el) {
          el.addEventListener('input', function () {
            var raw = el.value.replace(/[^\d]/g, '').replace(/^0+(?=\d)/, '');
            el.value = raw ? (el.dataset.type === 'won' ? raw.replace(/\B(?=(\d{3})+(?!\d))/g, ',') : raw) : '';
            calc();
          });
        });
        root.querySelectorAll('[data-type="select"], [data-type="date"], [data-type="check"]').forEach(function (el) {
          el.addEventListener('input', calc); el.addEventListener('change', calc);
        });
        I.hours.value = String(Y.years[Y.basis].default_hours);

        // 공유 주소 (기획서 3번)
        var sh = root.querySelector('[data-share]');
        if (sh) {
          var u = encodeURIComponent(sh.dataset.url), t = encodeURIComponent(sh.dataset.title);
          sh.querySelector('[data-share-fb]').href = 'https://www.facebook.com/sharer/sharer.php?u=' + u;
          sh.querySelector('[data-share-x]').href = 'https://twitter.com/intent/tweet?url=' + u + '&text=' + t;
          sh.querySelector('[data-share-naver]').href = 'https://share.naver.com/web/shareView?url=' + u + '&title=' + t;
          sh.querySelector('[data-share-band]').href = 'https://band.us/plugin/share?body=' + t + '%20' + u + '&route=' + u;
        }
        calc();
      }
      document.addEventListener('astro:page-load', init);
      if (document.readyState !== 'loading') init(); else document.addEventListener('DOMContentLoaded', init);
    })();
  </script>
</Base>

<style>
  /* 계산기 무드: 퇴직금 계산기(severance-pay.astro)와 같은 유리 카드·금색 강조 토큰을 이 페이지 안에서만 정의 */
  .calc {
    --gold: #f5b544; --gold-ink: #ffd27a; --gold-soft: rgba(245, 181, 68, .12);
    --rose: #ff6b7a; --rose-soft: rgba(255, 107, 122, .12);
    --hair-2: rgba(255, 255, 255, .14);
    --glass: rgba(18, 24, 38, .66); --glass-2: rgba(22, 28, 44, .55);
    --field: rgba(9, 12, 22, .55);
    --cshadow: 0 24px 60px -20px rgba(0, 0, 0, .6), 0 8px 18px -8px rgba(0, 0, 0, .4), inset 0 1px 0 rgba(255, 255, 255, .08);
    --r-sm: 12px;
    max-width: 920px; margin: 0 auto; font-size: 15.5px; letter-spacing: -.01em;
  }
  :global(:root[data-theme='light']) .calc {
    --gold: #c98a12; --gold-ink: #a86f0a; --gold-soft: rgba(201, 138, 18, .10);
    --rose: #e0475a; --rose-soft: rgba(224, 71, 90, .10);
    --hair-2: #d3d8e0; --glass: rgba(255, 255, 255, .78); --glass-2: rgba(255, 255, 255, .6); --field: rgba(255, 255, 255, .85);
