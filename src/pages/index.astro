---
import { getPublished } from '../lib/posts';
import Base from '../layouts/Base.astro';
import { CATEGORIES, SITE } from '../config/site';

const posts = await getPublished();
const [lead, ...rest] = posts;
const latest = rest.slice(0, 8);

const counts = Object.fromEntries(
  Object.keys(CATEGORIES).map((k) => [k, posts.filter((p) => p.data.category === k).length])
);

const fmt = (d: Date) =>
  d.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<Base>
  {
    lead && (
      <section class="lead">
        <div class="lead-main">
          <p class="lead-cat" style={`--c:${CATEGORIES[lead.data.category].color}`}>
            {CATEGORIES[lead.data.category].name}
          </p>
          <h1 class="lead-title">
            <a href={`/posts/${lead.id}`}>{lead.data.title}</a>
          </h1>
          <p class="lead-desc">{lead.data.description}</p>
          <p class="lead-date">{fmt(lead.data.pubDate)}</p>
        </div>
        <aside class="lead-side">
          <p class="lead-side-h">돈의 일곱 방향</p>
          <ol>
            {Object.entries(CATEGORIES).map(([key, c]) => (
              <li>
                <a href={`/${key}`} style={`--c:${c.color}`}>
                  <b>{c.no}</b>
                  <span class="n">{c.name}</span>
                  <span class="d">{c.desc}</span>
                </a>
              </li>
            ))}
          </ol>
        </aside>
      </section>
    )
  }

  <section class="latest">
    <p class="kicker">Latest</p>
    <h2 class="section-h">최신 팩트체크</h2>
    <ol class="postlist">
      {
        latest.map((p, i) => (
          <li>
            <a href={`/posts/${p.id}`}>
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              <span class="body">
                <span class="cat" style={`--c:${CATEGORIES[p.data.category].color}`}>
                  {CATEGORIES[p.data.category].name}
                </span>
                <span class="t">{p.data.title}</span>
                <span class="s">{p.data.description}</span>
              </span>
              <span class="date">{fmt(p.data.pubDate)}</span>
            </a>
          </li>
        ))
      }
    </ol>
    {posts.length === 0 && <p class="empty">아직 발행된 글이 없다. 첫 글이 곧 올라온다.</p>}
  </section>
</Base>

<style>
  .lead {
    display: grid; grid-template-columns: 1fr 300px; gap: 44px;
    padding: 40px 0 48px;
    border-bottom: 1px solid var(--hair);
  }
  .lead-cat {
    margin: 0 0 12px; font-size: 13px; font-weight: 700; color: var(--c);
    letter-spacing: 0.08em;
  }
  .lead-cat::before { content: '■ '; font-size: 9px; vertical-align: 2px; }
  .lead-title {
    margin: 0 0 16px;
    font-family: var(--serif); font-weight: 900;
    font-size: clamp(26px, 4vw, 40px); line-height: 1.32; letter-spacing: -0.02em;
  }
  .lead-title a:hover { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; text-decoration-color: var(--money); }
  .lead-desc { margin: 0 0 14px; max-width: 560px; color: var(--ink-2); font-size: 16.5px; }
  .lead-date { margin: 0; font-size: 13px; color: var(--ink-3); }

  .lead-side { border-left: 1px solid var(--hair); padding-left: 28px; }
  .lead-side-h {
    margin: 4px 0 14px; font-family: var(--serif); font-weight: 700; font-size: 16px;
  }
  .lead-side ol { list-style: none; margin: 0; padding: 0; }
  .lead-side li + li { border-top: 1px solid var(--hair); }
  .lead-side a { display: grid; grid-template-columns: 28px 1fr; align-items: baseline; padding: 9px 0; }
  .lead-side b { font-family: var(--serif); font-size: 12px; color: var(--c); grid-row: span 2; }
  .lead-side .n { font-weight: 700; font-size: 14.5px; }
  .lead-side .d { grid-column: 2; font-size: 12px; color: var(--ink-3); }
  .lead-side a:hover .n { color: var(--c); }

  .latest { padding-top: 44px; }
  .postlist { list-style: none; margin: 0; padding: 0; }
  .postlist li { border-bottom: 1px solid var(--hair); }
  .postlist a {
    display: grid; grid-template-columns: 52px 1fr 90px; gap: 18px;
    align-items: baseline; padding: 20px 0;
  }
  .postlist .idx {
    font-family: var(--serif); font-weight: 700; font-size: 21px; color: var(--hair);
    transition: color 0.15s;
  }
  .postlist a:hover .idx { color: var(--money); }
  .postlist .cat { display: block; font-size: 12px; font-weight: 700; color: var(--c); margin-bottom: 3px; }
  .postlist .t {
    display: block; font-family: var(--serif); font-weight: 700; font-size: 19px; line-height: 1.45;
  }
  .postlist a:hover .t { text-decoration: underline; text-underline-offset: 4px; }
  .postlist .s {
    display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
    font-size: 13.5px; color: var(--ink-2); margin-top: 4px;
  }
  .postlist .date { font-size: 12.5px; color: var(--ink-3); text-align: right; }
  .empty { color: var(--ink-2); padding: 28px 0; }

  @media (max-width: 800px) {
    .lead { grid-template-columns: 1fr; gap: 28px; }
    .lead-side { border-left: 0; padding-left: 0; border-top: 1px solid var(--hair); padding-top: 20px; }
    .postlist a { grid-template-columns: 40px 1fr; }
    .postlist .date { display: none; }
  }
</style>
