---
import { getPublished } from '../lib/posts';
import Base from '../layouts/Base.astro';
import { CATEGORIES, fmtDate } from '../config/site';

const posts = await getPublished();
const [lead, ...rest] = posts;
const feed = rest.slice(0, 8);
const ranked = posts.slice(0, 4);
const minutes = (p: (typeof posts)[number]) => Math.max(1, Math.round((p.body ?? '').replace(/\s+/g, '').length / 500));
---

<Base>
  <section class="hero">
    <h1>지원금·환급·대출,<br />숫자로 확인하는 정책 데이터</h1>
    <p>수백 장의 행정 고시를 단 1장의 자격 체크표와 계산기로 압축했습니다.</p>
  </section>

  <nav class="chips" aria-label="정책 영역">
    <a class="on" href="/">전체</a>
    {Object.entries(CATEGORIES).map(([key, c]) => <a href={`/${key}`}>{c.name}</a>)}
  </nav>

  {lead ? (
    <a class="feat" id="featured" href={`/posts/${lead.id}`}>
      <div class="feat-top" style={lead.data.thumbnail ? `background-image:url(${lead.data.thumbnail})` : ''}>
        <span class="feat-badge">최신 분석</span>
        <span class="feat-icon" aria-hidden="true">{CATEGORIES[lead.data.category].icon}</span>
        <span class="feat-meta">{CATEGORIES[lead.data.category].name} · {fmtDate(lead.data.pubDate)}</span>
        <h2 class="feat-title">{lead.data.title}</h2>
      </div>
      <div class="feat-bottom">
        <p>{lead.data.description}</p>
        <span class="feat-go">읽기 →</span>
      </div>
    </a>
  ) : (
    <p class="empty">데이터 구축 중입니다. 검증이 끝난 분석부터 순서대로 공개됩니다.</p>
  )}

  {posts.length > 1 && (
    <section class="two">
      <div class="rank">
        <h2 class="section-h">지금 많이 보는 분석</h2>
        <p class="section-sub">사람들이 주목하는 정책 이야기</p>
        <ol class="rank-list">
          {ranked.map((p, i) => (
            <li><a href={`/posts/${p.id}`}><span>{p.data.title}</span>{i === 0 && <span class="chip new">새로 나온</span>}</a></li>
          ))}
        </ol>
      </div>
      <div class="feed">
        <h2 class="section-h">나를 위한 정책 알아두기</h2>
        <p class="section-sub">알뜰하고 쏠쏠한 정책 활용법</p>
        <ul class="feed-list">
          {feed.map((p) => {
            const c = CATEGORIES[p.data.category];
            return (
              <li style={`--c:${c.color}`}>
                <a href={`/posts/${p.id}`}>
                  <div class="feed-text">
                    <h3>{p.data.title}</h3>
                    <p>{p.data.description}</p>
                    <span class="feed-min">⏳ {minutes(p)}분</span>
                  </div>
                  <div class="thumb">
                    {p.data.thumbnail
                      ? <img src={p.data.thumbnail} alt="" width="640" height="360" loading="lazy" />
                      : <div class="thumb-fallback"><span>{c.icon}</span></div>}
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .hero { text-align: center; padding: 64px 0 28px; }
  .hero h1 { margin: 0 0 12px; font-weight: 800; font-size: clamp(30px, 4.6vw, 48px); line-height: 1.25; letter-spacing: -0.03em; }
  .hero p { margin: 0 auto; max-width: 560px; color: var(--ink-3); font-size: 16px; }

  .chips { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; margin: 28px 0 32px; padding-bottom: 4px; }
  .chips::-webkit-scrollbar { display: none; }
  .chips a { flex: 0 0 auto; padding: 8px 16px; border-radius: 999px; font-size: 14px; font-weight: 600; color: var(--ink-3); background: var(--surface); border: 1px solid var(--hair); }
  .chips a:hover { color: var(--ink); }
  .chips a.on { background: var(--ink); color: var(--bg); border-color: var(--ink); box-shadow: var(--shadow); }

  /* 대표 글 */
  .feat { display: block; border-radius: 24px; overflow: hidden; background: var(--surface); border: 1px solid var(--hair); box-shadow: var(--shadow); transition: border-color .2s; }
  .feat:hover { border-color: color-mix(in srgb, var(--money) 50%, transparent); }
  .feat-top {
    position: relative; min-height: 288px; padding: 32px; display: flex; flex-direction: column; justify-content: flex-end;
    background: linear-gradient(45deg, #0f172a, #1e293b, #334155); background-size: cover; background-position: center;
  }
  .feat-top[style*='background-image']::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(16,16,19,.15), rgba(16,16,19,.85)); }
  .feat-top > * { position: relative; }
  .feat-top .feat-badge { position: absolute; top: 24px; left: 24px; padding: 4px 12px; border-radius: 999px; background: var(--money); color: #fff; font-size: 12px; font-weight: 700; }
  .feat-top .feat-icon { position: absolute; right: 32px; bottom: 32px; font-size: 60px; opacity: .3; transition: transform .3s; }
  .feat:hover .feat-icon { transform: scale(1.1); }
  .feat-meta { font-size: 12.5px; font-weight: 500; color: #94a3b8; margin-bottom: 8px; }
  .feat-title { margin: 0; max-width: 20ch; font-weight: 700; font-size: clamp(22px, 3vw, 30px); line-height: 1.35; color: #fff; letter-spacing: -0.02em; }
  .feat:hover .feat-title { color: var(--money); }
  .feat-bottom { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 24px; }
  .feat-bottom p { margin: 0; font-size: 14px; color: var(--ink-3); overflow: hidden; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; }
  .feat-go { flex: 0 0 auto; font-size: 12.5px; font-weight: 700; color: var(--money); }

  /* 두 단: 왼쪽 순위 / 오른쪽 피드 */
  .two { margin-top: 96px; display: grid; grid-template-columns: 320px 1fr; gap: 56px; align-items: start; }
  .rank-list { list-style: none; margin: 0; padding: 0; counter-reset: r; }
  .rank-list li { counter-increment: r; border-bottom: 1px solid var(--hair); }
  .rank-list a { display: grid; grid-template-columns: 22px 1fr auto; gap: 12px; align-items: center; padding: 18px 0; font-weight: 600; font-size: 15px; line-height: 1.5; }
  .rank-list a::before { content: counter(r); color: var(--money); font-weight: 800; font-size: 18px; }
  .rank-list a:hover span:first-of-type { color: var(--money); }
  .chip.new { background: var(--money-soft); color: var(--money); font-size: 11px; padding: 2px 8px; }

  .feed-list { list-style: none; margin: 0; padding: 0; }
  .feed-list li { border-bottom: 1px solid var(--hair); }
  .feed-list li:last-child { border-bottom: 0; }
  .feed-list a { display: grid; grid-template-columns: 1fr 220px; gap: 28px; align-items: center; padding: 24px 0; }
  .feed-text h3 { margin: 0 0 6px; font-weight: 700; font-size: 18px; line-height: 1.45; letter-spacing: -0.01em; }
  .feed-list a:hover h3 { color: var(--money); }
  .feed-text p { margin: 0 0 10px; font-size: 14px; color: var(--ink-3); overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .feed-min { font-size: 12.5px; color: var(--ink-3); }
  .feed-list .thumb { border-radius: 14px; }
  .feed-list .thumb-fallback { font-size: 56px; }

  .empty { padding: 48px 24px; border-radius: 18px; background: var(--surface); border: 1px solid var(--hair); text-align: center; color: var(--ink-3); }

  @media (max-width: 900px) { .two { grid-template-columns: 1fr; gap: 48px; } }
  @media (max-width: 720px) {
    .hero { padding: 40px 0 20px; }
    .two { grid-template-columns: 1fr; gap: 48px; margin-top: 64px; }
    .feed-list a { grid-template-columns: 1fr 120px; gap: 16px; }
    .feed-list .thumb-fallback { font-size: 32px; }
    .feat-top { min-height: 224px; padding: 24px; }
    .feat-icon { font-size: 44px; }
  }
</style>
