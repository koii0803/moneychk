---
import { getPublished } from '../lib/posts';
import Base from '../layouts/Base.astro';
import { CATEGORIES, fmtDate } from '../config/site';

const posts = await getPublished();
const [lead, ...rest] = posts;
const feed = rest.slice(0, 5); // '나를 위한 정책 알아두기' 고정 5개
const ranked = posts.slice(0, 3); // '지금 많이 보는 콘텐츠' 고정 3개
const recent = posts; // 한 쪽 8개 고정, 아래 가운데 페이지 넘김(JS로 그 자리에서 바꿈)
const RECENT_STEP = 8;
const recentPages = Math.ceil(recent.length / RECENT_STEP);

// 히어로 롤링 문구. "앞, 뒤" 두 토막 구조를 지켜야 두 줄 리듬이 맞는다
const rolling = [
  ['지원금·환급·대출, 숫자로 확인하는 정책 데이터', '수백 장 고시 문서를 1장 체크표와 모의계산기로 압축했습니다.'],
  ['수백 장의 행정 고시, 단 3초 자격 판정으로', '서론은 뺐습니다. 내가 대상인지, 얼마 받는지 첫 줄에 답합니다.'],
  ['복잡한 정책 조건, 내 통장에 꽂히는 숫자로', '세전 조건 말고, 감액·환수까지 계산한 통장 실수령액만 봅니다.'],
  ['카더라 없는 공공데이터, 1원까지 정확한 팩트체크', '블로그 뜬소문 대신 국토부·복지부 고시 원문 번호로 검증합니다.'],
  ['자격부터 지급일까지, 숫자로 끝내는 정책 가이드', '자격 판정부터 필수 서류, 공식 신청 링크까지 한 번에 끝냅니다.'],
  ['내가 받을 수 있는 정부 지원금, 놓치지 않게', '나이·소득·재산 3초 대조. 몰라서 놓치던 내 몫을 챙겨드립니다.'],
  ['잠들어 있는 환급금, 오늘 바로 숫자로 확인하기', '연말정산·건보료·통신비. 1원까지 돌려받는 원스톱 조회 창구.'],
  ['몰라서 못 받던 정책 자금, 머니첵이 찾아드립니다', '7대 금융·주거 영역, 매일 새로 고시되는 정책만 골라냅니다.'],
  ['1금융권 막혔을 때 찾는, 가장 안전한 정부 비상금', '은행 거절 후 당황하지 않게. 부결 사유 분석과 즉시 대안 마련.'],
  ['서류 준비부터 신청 링크까지, 글 하나로 끝내기', '동사무소 헛걸음 방지. 필요한 발급 서류와 직통 접수처 안내.'],
  ['디딤돌부터 버팀목까지, 내 집 마련 정책 대출 설계도', '수도권 3억 이하 기준부터 최저 1%대 금리 조합 공식 총정리.'],
  ['미혼 1인 가구도 가능한, 수도권 정책 대출 팩트체크', '만 30세 이상 단독세대주 특례와 60㎡ 면적 제한 돌파법.'],
  ['전세사기 없는 안심 주거, 정부 보증금 지원 총람', '내 전세금 100% 지키는 보증보험 조건과 버팀목 실행 순서.'],
  ['청년도약계좌와 청년드림, 종잣돈 만드는 확실한 로드맵', '정부 기여금 연 6% 지키고, 중도해지 함정 피하는 5가지 원칙.'],
  ['월세 부담 낮추는, 정부 청년 주거비 지원 매뉴얼', '매달 꽂히는 청년월세 20만 원. 나이·소득 분기표로 즉시 판정.'],
  ['숨은 건보료 환급금, 클릭 한 번으로 되돌려받기', '병원비 많이 낸 사람 필수. 작년에 더 낸 돈 3분 만에 계좌 입금.'],
  ['교통비 아끼는 K-패스, 내 이동 패턴별 손익분기점', '월 6만 5천 원 이상 타는 사람, 어떤 카드가 통장에 더 남을까?'],
  ['매달 새어나가는 공과금, 합법적으로 감면받는 법', '전기·가스·통신비 자동 할인. 신청만 하면 매달 아끼는 돈.'],
  ['실업급여와 구직촉진수당, 감액 없는 안전 수령 공식', '주 15시간 미만 알바해도 될까? 억울한 부정수급 100% 방어법.'],
  ['당신의 월급을 지키는, 가장 확실한 정책 방어선', '물가와 세금에 깎이는 내 소득, 정부 제도로 틀어막는 최종 해법.'],
];
const countOf = (...keys: string[]) => posts.filter((p) => keys.includes(p.data.category)).length;

// 오리지널 시리즈 4대 테마 (분류 묶음에 이름을 붙인 것. 글 수는 실측)
const series = [ // '오리지널 시리즈' 고정 4개
  { icon: '🏠', name: '도시와 내 집의 설계도', desc: '전세사기 안 당하고, 정부 저금리 디딤돌·버팀목 대출로 서울·수도권에 내 집 마련하는 합법적 레버리지.', img: '/img/icons/home.webp', cats: ['home'], bg: 'linear-gradient(135deg, #0e7490, #164e63)' },
  { icon: '🛡️', name: '월급의 마지막 방어선', desc: '낸 세금 1원까지 돌려받는 숨은 환급금부터 공과금·교통비 깎아내는 직장인·자영업자 감면 공식.', img: '/img/icons/save.webp', cats: ['refund', 'save'], bg: 'linear-gradient(135deg, #1e3a2f, #0f2a1f)' },
  { icon: '🌱', name: '청년 자산 빌드업', desc: '청년도약계좌 연 6% 기여금과 청년주택드림 청약통장으로 종잣돈 5천만 원 만드는 가장 확실한 로드맵.', img: '/img/icons/future.webp', cats: ['future'], bg: 'linear-gradient(135deg, #1e1b4b, #0f172a)' },
  { icon: '🚨', name: '비상금과 출구 전략', desc: '1금융권 막혔을 때 찾는 정부 햇살론, 최저신용자 특례보증, 신용회복위원회의 채무조정 실전 매뉴얼.', img: '/img/icons/loan.webp', cats: ['loan'], bg: 'linear-gradient(135deg, #7c2d12, #3b1d0e)' },
];
const minutes = (p: (typeof posts)[number]) => Math.max(1, Math.round((p.body ?? '').replace(/\s+/g, '').length / 500));
---

<Base>
  <section class="hero">
    <h1 class="roll" data-roll={JSON.stringify(rolling)}>
      <span class="l1">{rolling[0][0].split(', ')[0]},</span>
      <span class="l2">{rolling[0][0].split(', ')[1]}</span>
    </h1>
    <p class="sub">{rolling[0][1]}</p>
  </section>

  <nav class="chips" aria-label="정책 영역">
    <a class="on" href="/">전체</a>
    {Object.entries(CATEGORIES).map(([key, c]) => <a href={`/${key}`}>{c.name}</a>)}
  </nav>

  {lead ? (
    <a class="feat" id="featured" href={`/posts/${lead.id}`}>
      <div class="feat-top">
        <img class="feat-bg" src={lead.data.thumbnail ?? '/img/feat-default.webp'} alt="" width="1376" height="768" />
        <span class="feat-badge">최신 분석</span>
        <img class="feat-icon" src={CATEGORIES[lead.data.category].img} alt="" width="160" height="160" />
        <span class="feat-meta">{CATEGORIES[lead.data.category].name} · {fmtDate(lead.data.pubDate)}</span>
        <h2 class="feat-title">{lead.data.title}</h2>
      </div>
      <div class="feat-bottom">
        <p>{lead.data.description}</p>
        <svg class="feat-go" viewBox="0 0 40 24" width="40" height="24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12h34M26 3l10 9-10 9"/></svg>
      </div>
    </a>
  ) : (
    <p class="empty">데이터 구축 중입니다. 검증이 끝난 분석부터 순서대로 공개됩니다.</p>
  )}

  {posts.length > 1 && (
    <section class="two">
      <div class="rank">
        <h2 class="section-h">지금 많이 보는 콘텐츠</h2>
        <p class="section-sub">지금 주목받는 정책</p>
        <ol class="rank-list">
          {ranked.map((p, i) => (
            <li><a href={`/posts/${p.id}`}><span>{p.data.title}</span>{i === 0 && <span class="chip new">NEW</span>}</a></li>
          ))}
        </ol>
      </div>
      <div class="feed">
        <h2 class="section-h">나를 위한 정책 알아두기</h2>
        <p class="section-sub">알아두면 남는 돈의 공식</p>
        <ul class="feed-list">
          {feed.map((p) => {
            const c = CATEGORIES[p.data.category];
            return (
              <li style={`--c:${c.color}`}>
                <a href={`/posts/${p.id}`}>
                  <div class="feed-text">
                    <h3>{p.data.title}</h3>
                    <p>{p.data.description}</p>
                    <span class="feed-meta">
                      <span class="feed-min">⏳ {minutes(p)}분</span>
                      <span class="tagpill" style={`--b:${c.badge}`}>{c.short}</span>
                    </span>
                  </div>
                  <div class="thumb">
                    {p.data.thumbnail
                      ? <img src={p.data.thumbnail} alt="" width="640" height="360" loading="lazy" />
                      : <div class="thumb-fallback"><img src={c.img} alt="" width="120" height="120" loading="lazy" /></div>}
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <section class="series">
    <h2 class="section-h">오리지널 시리즈</h2>
    <p class="section-sub">정책을 바라보는 네 가지 관점</p>
    <ul class="series-list">
      {series.map((sr) => {
        const n = countOf(...sr.cats);
        return (
          <li>
            <a class="series-card" href={`/${sr.cats[0]}`}>
              <div class="series-art" style={`background:${sr.bg}`}><img src={sr.img} alt="" width="200" height="200" loading="lazy" /></div>
              <div class="series-body">
                <h3>{sr.name}</h3>
                <p>{sr.desc}</p>
                <span class="chip">{n > 0 ? `콘텐츠 ${n}개` : '데이터 구축 중'}</span>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  {recent.length > 0 && (
    <section class="recent">
      <h2 class="section-h">방금 올라온 콘텐츠</h2>
      <p class="section-sub">실시간 업데이트 소식 살펴보기</p>
      <ul class="recent-grid">
        {recent.map((p, i) => {
          const c = CATEGORIES[p.data.category];
          return (
            <li style={`--c:${c.color}`} class={i >= RECENT_STEP ? 'is-hid' : undefined} data-p={Math.floor(i / RECENT_STEP) + 1}>
              <a href={`/posts/${p.id}`}>
                <div class="thumb">
                  {p.data.thumbnail
                    ? <img src={p.data.thumbnail} alt="" width="640" height="360" loading="lazy" />
                    : <div class="thumb-fallback"><img src={c.img} alt="" width="120" height="120" loading="lazy" /></div>}
                </div>
                <h3>{p.data.title}</h3>
                <span class="recent-date">{fmtDate(p.data.pubDate)}</span>
              </a>
            </li>
          );
        })}
      </ul>
      {recentPages > 1 && (
        <nav class="pager" data-pager aria-label="페이지">
          <button type="button" data-go="prev" aria-label="이전" disabled>‹</button>
          {Array.from({ length: recentPages }, (_, i) => i + 1).map((n) => (
            <button type="button" data-go={n} class:list={{ on: n === 1 }} aria-current={n === 1 ? 'page' : undefined}>{n}</button>
          ))}
          <button type="button" data-go="next" aria-label="다음">›</button>
        </nav>
      )}
    </section>
  )}

  <script is:inline>
    // 히어로 문구 롤링: 3.4초마다 사라졌다 다음 문구로. 높이는 CSS로 고정해 아래가 안 흔들린다.
    // 움직임 줄이기 설정이면 첫 문구 고정. 탭이 안 보이면 멈춘다.
    document.addEventListener('astro:page-load', () => {
      const h = document.querySelector('[data-roll]');
      if (!h || h.dataset.on) return;
      h.dataset.on = '1';
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const list = JSON.parse(h.dataset.roll);
      const l1 = h.querySelector('.l1'), l2 = h.querySelector('.l2'), sub = h.parentElement.querySelector('.sub');
      let i = 0, t;
      const next = () => {
        h.classList.add('out'); sub?.classList.add('out');
        setTimeout(() => {
          i = (i + 1) % list.length;
          const [a, b] = list[i][0].split(', ');
          l1.textContent = a + ',';
          l2.textContent = b;
          if (sub) sub.textContent = list[i][1];
          h.classList.remove('out'); sub?.classList.remove('out');
        }, 480);
      };
      const start = () => { stop(); t = setInterval(next, 3400); };
      const stop = () => { if (t) clearInterval(t); t = null; };
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
      start();
    });

    // 방금 올라온 콘텐츠: 쪽 번호 누르면 그 쪽 8개만 보인다(페이지 이동 없음).
    document.addEventListener('astro:page-load', () => {
      const nav = document.querySelector('[data-pager]');
      if (!nav || nav.dataset.on) return;
      nav.dataset.on = '1';
      const items = [...document.querySelectorAll('.recent-grid [data-p]')];
      const nums = [...nav.querySelectorAll('button')].filter((b) => /^\d+$/.test(b.dataset.go));
      const last = nums.length;
      let cur = 1;
      const show = (n) => {
        cur = Math.min(Math.max(1, n), last);
        items.forEach((li, k) => { const on = Number(li.dataset.p) === cur; li.classList.toggle('is-hid', !on); li.classList.toggle('is-in', on); li.style.animationDelay = `${(k % 8) * 40}ms`; });
        nums.forEach((b) => { const on = Number(b.dataset.go) === cur; b.classList.toggle('on', on); on ? b.setAttribute('aria-current', 'page') : b.removeAttribute('aria-current'); });
        nav.querySelector('[data-go=prev]').disabled = cur === 1;
        nav.querySelector('[data-go=next]').disabled = cur === last;
      };
      nav.addEventListener('click', (e) => {
        const b = e.target.closest('button[data-go]');
        if (!b) return;
        show(b.dataset.go === 'prev' ? cur - 1 : b.dataset.go === 'next' ? cur + 1 : Number(b.dataset.go));
      });
    });
  </script>
</Base>

<style>
  .hero { text-align: center; padding: 64px 0 28px; }
  /* 두 줄 높이를 고정해서 문구가 바뀌어도 아래가 안 움직인다 */
  .hero h1 { display: flex; flex-direction: column; justify-content: center; gap: 2px; min-height: calc(2 * 1.25em + 8px); margin: 0 0 14px; font-weight: 800; font-size: clamp(30px, 4.6vw, 48px); line-height: 1.25; letter-spacing: -0.03em; }
  .hero .l1, .hero .l2 { display: block; transition: opacity .45s ease, transform .45s ease; }
  .hero .l1 { font-weight: 600; font-size: .78em; color: var(--ink-3); letter-spacing: -0.02em; }
  .hero .l2 { background: linear-gradient(90deg, var(--ink) 0%, var(--ink) 55%, var(--money) 140%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero h1.out .l1 { opacity: 0; transform: translateY(-6px); }
  .hero h1.out .l2 { opacity: 0; transform: translateY(8px); transition-delay: .05s; }
  .hero p { margin: 0 auto; max-width: 600px; min-height: calc(2 * 1.6em); color: var(--ink-3); font-size: 16px; line-height: 1.6; transition: opacity .45s ease .1s; }
  .hero p.out { opacity: 0; transition-delay: 0s; }
  @media (prefers-reduced-motion: reduce) { .hero .l1, .hero .l2 { transition: none; } }

  .chips { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; margin: 28px 0 32px; padding-bottom: 4px; justify-content: center; }
  @media (max-width: 760px) { .chips { justify-content: flex-start; } }
  .chips::-webkit-scrollbar { display: none; }
  .chips a { flex: 0 0 auto; padding: 8px 16px; border-radius: 999px; font-size: 14px; font-weight: 600; color: var(--ink-3); background: var(--surface); border: 1px solid var(--hair); }
  .chips a:hover { color: var(--ink); }
  .chips a.on { background: var(--ink); color: var(--bg); border-color: var(--ink); box-shadow: var(--shadow); }

  /* 대표 글 */
  .feat { display: block; border-radius: 24px; overflow: hidden; background: var(--surface); border: 1px solid var(--hair); box-shadow: var(--shadow); transition: border-color .2s; }
  .feat:hover { border-color: color-mix(in srgb, var(--money) 50%, transparent); }
  .feat-top {
    position: relative; min-height: 288px; padding: 32px; display: flex; flex-direction: column; justify-content: flex-end;
    background: linear-gradient(45deg, #0f172a, #1e293b, #334155); overflow: hidden;
  }
  /* 배경 사진: 올리면 1.05배 천천히 확대 */
  .feat-top .feat-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  .feat:hover .feat-bg { transform: scale(1.05); }
  /* 사진 위 덮개: 왼쪽 진하고 오른쪽 옅게 — 고정값. 글자는 왼쪽, 사진은 오른쪽에 보이게 */
  .feat-top::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgba(16,16,19,.9) 0%, rgba(16,16,19,.6) 45%, rgba(16,16,19,.1) 100%); }
  .feat-top > * { position: relative; z-index: 2; }
  .feat-top > .feat-bg { z-index: 0; }
  .feat-top .feat-badge { position: absolute; top: 24px; left: 24px; padding: 4px 12px; border-radius: 999px; background: var(--money); color: #fff; font-size: 12px; font-weight: 700; }
  .feat-top .feat-icon { position: absolute; right: 32px; bottom: 28px; width: 80px; height: 80px; object-fit: contain; opacity: .9; filter: drop-shadow(0 12px 24px rgba(0,0,0,.45)); transition: transform .3s; }
  .feat:hover .feat-icon { transform: scale(1.1); }
  .feat-meta { font-size: 12.5px; font-weight: 500; color: #94a3b8; margin-bottom: 8px; }
  .feat-title { margin: 0; max-width: 20ch; font-weight: 700; font-size: clamp(22px, 3vw, 30px); line-height: 1.35; color: #fff; letter-spacing: -0.02em; }
  .feat:hover .feat-title { color: var(--money); }
  .feat-bottom { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 24px; }
  .feat-bottom p { margin: 0; font-size: 14px; color: var(--ink-3); overflow: hidden; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; }
